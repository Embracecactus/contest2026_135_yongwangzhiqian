<?xml version='1.0' encoding='UTF-8'?>
<manifest>
  <!--
    Team repo manifest. Includes the full openvela base project set
    (openvela.xml in this same repo) and adds this team repo as a self-ref
    project, exposing its work-form subdirectories to openvela working-tree
    locations via <linkfile>. remote/default come from the included openvela.xml.
  -->
  <include name="openvela.xml"/>

  <!-- The existing Agent extensions from the 635 feature branch are delivered
       as public fork commits; no build-time patch is reinstated. -->
  <remote name="shaniu-agent" fetch="https://github.com/Embracecactus/"/>
  <remote name="mcuboot-official" fetch="https://github.com/mcu-tools/"/>
  <remote name="speexdsp-official" fetch="https://github.com/xiph/"/>
  <extend-project name="packages_ai_agent" path="packages/ai_agent"
                  remote="shaniu-agent"
                  revision="62a304ea69c4076f0f3ef7955a9af69a5ed35277"
                  upstream="refs/heads/feat/shaniu-streamed-reply"/>

  <project path="vendor/beken/bk_avdk_smp"
           name="Embracecactus/bk_avdk_smp"
           remote="git"
           revision="cb080de1655d579c7593ecf504c440997c4c137b"
           upstream="refs/heads/openvela/v3.1.1.9"
           sync-c="true"
           clone-depth="1"
           groups="bk7258-sdk"/>

  <!-- BL2 and the release signer consume this exact official MCUboot tree. -->
  <project path="apps/boot/mcuboot/mcuboot" name="mcuboot"
           remote="mcuboot-official"
           revision="fefc398cc13ebbc527e297fe9df78cd98a359d75"
           clone-depth="1"/>

  <!-- AP resampling must not fetch a mutable tag archive during CMake. -->
  <project path="apps/audioutils/speexdsp/speexdsp" name="speexdsp"
           remote="speexdsp-official"
           revision="1b28a0f61bc31162979e1f26f3981fc3637095c8"
           upstream="refs/tags/SpeexDSP-1.2.1"
           clone-depth="1"/>

  <!-- Post-contest development belongs to the owner fork, not the frozen contest repo. -->
  <project path="contest2026_135_yongwangzhiqian" name="contest2026_135_yongwangzhiqian"
           remote="shaniu-agent" revision="dev-ai-contest-2026">
    <linkfile src="app/hello_app" dest="packages/demos/contest2026_135_hello_app"/>
    <linkfile src="app/bk7258" dest="apps/system/bk7258"/>
    <linkfile src="quickapp/hello_quickapp" dest="packages/apps/contest2026_135_hello_quickapp"/>
    <linkfile src="chips/bk7258" dest="vendor/beken/chips/bk7258"/>
    <linkfile src="boards/bk7258" dest="vendor/beken/boards/bk7258"/>
    <linkfile src="nuttx" dest="vendor/beken/nuttx"/>
    <linkfile src="frameworks" dest="vendor/beken/frameworks"/>
    <linkfile src="app/dolphin" dest="apps/system/dolphin"/>
    <linkfile src="app/testing/bk7258" dest="apps/testing/bk7258"/>
    <linkfile src="tests/pytest/test_bk7258" dest="tests/scripts/script/test_bk7258"/>
    <linkfile src="prebuilt" dest="vendor/beken/prebuilt"/>
    <linkfile src="tools/bk7258" dest="vendor/openvela/tools/contest2026_135_bk7258"/>
  </project>
</manifest>
