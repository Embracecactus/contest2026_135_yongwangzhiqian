config ARCH_CHIP_RV1126B
	bool "Rockchip RV1126B HPMCU"
	depends on ARCH_CHIP_RISCV_CUSTOM || ARCH_CHIP_CUSTOM
	select ARCH_RV32
	select ARCH_RV_ISA_M
	select ARCH_RV_ISA_C
	---help---
		Rockchip RV1126B High Performance MCU (HPMCU)
		SCR1 RISC-V core, RV32IMC, 396MHz, M-mode only

if ARCH_CHIP_RV1126B

config RV1126B_UART5_CONSOLE
	bool "Use UART5 as console"
	default y
	---help---
		Use UART5 M0 (1.5Mbaud, GPIO4_PA6/PA7 FUNC5) as the debug console.
		This matches the SDK-verified AMP baseline.

if RPTUN

config RV1126B_RPTUN_SHM_ADDR
	hex "RPTun shared memory address"
	default 0x48c3c000
	---help---
		Start address of the Linux rpmsg shared memory region.
		Must match the LINUX_RPMSG region in the linker script.
		Default 0x48c3c000 matches the SDK amp.dtsi / link.lds.

config RV1126B_RPTUN_SHM_SIZE
	int "RPTun shared memory size"
	default 131072
	---help---
		Size of the shared memory region in bytes.
		Default 128KB (0x20000) matches the SDK linker script.

endif # RPTUN

endif # ARCH_CHIP_RV1126B
