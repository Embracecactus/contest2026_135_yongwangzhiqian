include common/Make.defs

# RV1126B has its own timer driver (rv1126b_timerisr.c); exclude the
# common riscv_mtimer.c which assumes CONFIG_ONESHOT_COUNT.

CMN_CSRCS := $(filter-out riscv_mtimer.c,$(CMN_CSRCS))

# Chip source files
CHIP_CSRCS  = rv1126b_start.c
CHIP_CSRCS += rv1126b_irq.c
CHIP_CSRCS += rv1126b_irq_dispatch.c
CHIP_CSRCS += rv1126b_timerisr.c
CHIP_CSRCS += rv1126b_lowputc.c
CHIP_CSRCS += rv1126b_serial.c
CHIP_CSRCS += rv1126b_clockconfig.c
CHIP_CSRCS += rv1126b_allocateheap.c
CHIP_CSRCS += rv1126b_atomic.c

# Startup assembly
HEAD_ASRC = rv1126b_head.S
