config BK7258_JPEG_DECODER
	bool "BK7258 hardware JPEG decoder helper"
	default n
	depends on BK7258_AP_CORE && BK7258_PM_CLOCK
	select BK7258_SDK_IPC_RUNTIME
	help
		Build an AP-side typed helper for synchronous hardware JPEG decode
		through the official v3.1.1.9 JPEG decoder component.  NuttX has no
		matching JPEG decoder lower-half, so this option does not create a
		private character-device ABI.  A camera, framebuffer, or V4L2 media
