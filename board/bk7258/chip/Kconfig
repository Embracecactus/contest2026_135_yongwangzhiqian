config BK7258_AUD
	bool "On-board analog speaker playback"
	default n
	depends on BK7258_PM_CLOCK
	select ARCH_PERF_EVENTS
	select BK7258_SDK_IPC_RUNTIME
	select AUDIO
	select AUDIO_DRIVER_SPECIFIC_BUFFERS
	help
		Expose the board's differential analog speaker path as a mono signed
		16-bit NuttX playback device.  The data path uses the SDK's repeat-mode
		GDMA engine and the selected-board binding controls the external power
		amplifier.  Each reserved playback session holds the official 480-MHz
		Audio CPU-frequency vote until RELEASE has torn down DMA, DAC and the
		worker.  The dedicated BK7258_MIC wrapper owns capture separately; the
		two remain mutually exclusive until their shared AUD clock-control
		contract is completed.

config BK7258_AUD_DAC_EQ
	bool "Private DAC hardware equalizer control"
	default n
	depends on BK7258_AUD && !AUDIO_MULTI_SESSION
	help
		Enable the BK7258-private, versioned DAC equalizer ioctl.  The caller
		supplies all four hardware coefficient banks as signed 22-bit raw
		coefficients before the DAC is constructed.  This option deliberately
		does not advertise NuttX AUDIO_FU_EQUALIZER because the generic audio
		ABI does not define a coefficient payload, session argument or filter
		stability contract.

config BK7258_AUD_DEVNAME
	string "Speaker playback device name"
	default "pcm0p"
	depends on BK7258_AUD

config BK7258_AUD_SAMPLE_RATE
	int
	default 16000
	depends on BK7258_AUD
	help
		The first validated speaker tuple is fixed at 16 kHz.  Other rates
		remain unavailable until their coupled DMA frame duration and scheduler
		deadline have separate hardware evidence.

config BK7258_AUD_DIG_GAIN
	int "Default speaker digital gain"
	default 45
	range 0 63
	depends on BK7258_AUD

config BK7258_AUD_ANA_GAIN
	int "Default speaker analog gain"
	default 10
	range 0 15
	depends on BK7258_AUD

config BK7258_AUD_FRAME_SAMPLES
	int
	default 320
	depends on BK7258_AUD
	help
		The first validated speaker tuple uses 320 samples per DMA frame,
		which is 20 ms at 16 kHz.  Keep the rate and frame size as one verified
		contract rather than exposing independent settings.

config BK7258_AUD_QUEUE_DEPTH
	int
	default 8
	depends on BK7258_AUD
	help
		The first validated speaker tuple fixes the explicit NuttX audio pool
		at eight buffers.  Applications must keep this full set circulating so
		the two-frame hardware DMA ring remains fed across scheduler latency.

config BK7258_AUD_WORKER_PRIORITY
	int "Speaker DMA refill worker priority"
	default 245
	range 226 245
	depends on BK7258_AUD
	help
		Priority of the task-context DMA refill worker.  This worker refills the
		completed hardware slot before publishing DEQUEUE, then deliberately
		runs just below the standard nxplayer/nxlooper producer priority of
		SCHED_PRIORITY_MAX - 9.  That ordering lets the feeder return one PCM
		buffer before a just-arrived DMA token can form a continuous worker
		chain.  With the board-default transport priorities, the required
		shared-CPU ordering is transport < refill worker < bounded feeder.  A
		custom profile that changes any of those priorities must preserve that
		ordering, and the feeder must enqueue one buffer and block rather than
		do unbounded decoding at its real-time priority.

config BK7258_AUD_LIFECYCLE_VALIDATION
	bool "Run bounded speaker playback lifecycle validation"
	default n
	depends on BK7258_AUD && BK7258_BOARD_T5_BOARD
	help
		Generate mono 1-kHz PCM in memory and exercise the public NuttX audio
		ABI through two open/play/teardown cycles.  The validation checks DMA,
		DAC and amplifier ownership diagnostics; audible output still requires
		a speaker connected to the T5-Board P6 connector.

