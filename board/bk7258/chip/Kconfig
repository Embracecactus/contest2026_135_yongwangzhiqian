config BK7258_SPI
	bool "SPI master lower half"
	default n
	select BK7258_SDK_IPC_RUNTIME
	select SPI

config BK7258_SPI_BUS
	int "SPI controller"
	default 0
	range 0 1
	depends on BK7258_SPI
	help
		Select the BK7258 hardware SPI unit and matching /dev/spiN bus
		number.  Frequency, clock mode and word width remain runtime NuttX
		SPI settings supplied by the attached device or SPI character driver.

config BK7258_QSPI
	bool "QSPI controller lower half"
	default n
	depends on BK7258_AP_CORE && BK7258_PM_CLOCK
	select BK7258_SDK_IPC_RUNTIME
	help
		Expose the two AP-owned BK7258 QSPI controllers through the standard
		NuttX qspi_dev_s contract.  The immutable SDK supports only a verified
		subset of 24-bit indirect Flash commands, so the board does not bind an
		arbitrary MTD upper half by default.  QSPI0 shares GPIO22..27 with RGB
		LCD and QSPI1 shares GPIO2..7 with SDIO/SPI/I2S; a board consumer must
		choose one pin-compatible owner before initializing either controller.
		The SDK clock edge is translated by the AP PM wrapper and owned by CP.

config BK7258_CAN
	bool "Classic CAN controller lower half"
	default n
	depends on BK7258_AP_CORE && BK7258_PM_CLOCK
	depends on !BK7258_LCD
	depends on !BK7258_SPI || BK7258_SPI_BUS != 0
	select BK7258_SDK_IPC_RUNTIME
	select CAN
	help
		Expose the AP-owned BK7258 CAN0 controller as the standard NuttX
		/dev/can0 character device.  The immutable v3.1.1.9 SDK FIFO preserves
		only classic 11-bit data-frame metadata, so this first lower half does
		not claim extended identifiers, RTR, or CAN-FD support.  NuttX
		CONFIG_CAN_LOOPBACK selects the controller's internal LBMI path for
		controller-only validation without an external transceiver.

		CAN0 is fixed to GPIO44 (TX), GPIO45 (RX), and GPIO46 (standby).  Those
		pins conflict with the RGB LCD and SPI0 pin groups, so Kconfig prevents
		those owners from being enabled together.

config BK7258_TIMER
	bool "General-purpose timer lower half"
	default n
	select BK7258_SDK_IPC_RUNTIME
	select TIMER

config BK7258_TIMER_FAULT_INJECTION
	bool "BK7258 timer one-shot stop-failure validation"
	default n
	depends on BK7258_TIMER
	---help---
		Run a boot-time, one-shot stop-failure test at the SDK call
		boundary.  The test checks both the NuttX ACTIVE state and the SDK
		hardware-enable bit before retrying a normal stop.  This is a
		real-board validation option only; do not enable it in a production
		profile.

config BK7258_TIMER_CHAN
	int "Timer channel"
	default 3
	range 3 5
	depends on BK7258_TIMER

config BK7258_TIMER_BUS
	int "Timer device minor"
	default 0
	range 0 15
	depends on BK7258_TIMER

config BK7258_TRNG
	bool "Hardware true-random number generator"
	default n
	select ARCH_HAVE_RNG
	select DEV_RANDOM
	help
		Expose the AP-owned BK7258 hardware TRNG through the standard NuttX
		/dev/random interface.  If DEV_URANDOM is also enabled, NuttX selects
		the architecture-backed /dev/urandom implementation rather than a
		software PRNG.

