config ARCH_CHIP_BK7258
	bool "Beken BK7258 (T5-AI tri-core Cortex-M33)"
	depends on ARCH_CHIP_CUSTOM
	select ARCH_CORTEXM33
	select ARCH_HAVE_TRUSTZONE
	select ARCH_HAVE_FPU
	select ARCH_HAVE_CUSTOM_VECTORS
	select ARCH_RAMVECTORS
	select ARCH_HAVE_MPU
	select ARCH_IDLE_CUSTOM
	select MTD if BK7258_FLASH_MTD
	---help---
		Beken BK7258 SoC as shipped on the T5-AI board: tri-core
		Cortex-M33.  This Stage N1 port targets a single app core that
		the on-board Tier-1 bootloader (board/bk7258/bootloader)
		jumps to at logical flash address 0x02010000 after validating
		the app magic "BK7236\0\0" at image offset 0x100.

		The chip provides its own Cortex-M vector table.  The CPU0/CP image
		keeps the BK7236 boot magic at vector slots 64/65; the optional
		CPU1/AP image uses a normal 80-entry __vector_core0_table.

		TrustZone remains disabled for the ordinary direct-boot layout.  The
		board selects the generic NuttX capability so a separate secureboot
		profile can build CP as a Non-Secure image after Beken BL2/TF-M has
		configured the platform.  Enabling the choice alone neither changes
		the current image nor programs any security fuse.

config BK7258_AP_CORE
	bool "Build the physical CPU1 AP NuttX image"
	default n
	depends on ARCH_CHIP_BK7258
	select TIMER
	select TIMER_ARCH
	select ARMV8M_SYSTICK
	---help---
		Build the independent AP NuttX image whose primary is physical CPU1 /
		AP logical CPU0.  Maintained AP profiles select SMP explicitly through
		BK7258_AP_SMP_BOOTSTRAP; see board/bk7258/configs/README.md for the
		canonical physical-board/profile catalog.

menu "BK7258 debug and UART pin ownership"

config BK7258_SWD_DEBUG
	bool "Enable the board-owned J-Link SWD route"
	default n
	depends on !BK7258_AP_CORE && BK7258_BOARD_T5_BOARD
	---help---
		Keep one explicit BK7258 SWD route active from BL1 through BL2, CP
		startup and later restore boundaries.  This controls the physical
		debug route only; RTT and UART console selection are independent.

if BK7258_SWD_DEBUG

choice
	prompt "SWD pin group"
	default BK7258_SWD_PINS_P0_P1

config BK7258_SWD_PINS_P20_P21
	bool "SDK group 0: P20/P21"
	help
		Use P20 as SWCLK and P21 as SWDIO.  These pins also carry I2C0 and
		T5-Board RGB LCD R6/R5, so a paired build using either function must
		be rejected.

config BK7258_SWD_PINS_P0_P1
	bool "SDK group 1: P0/P1"
	help
		Use P0 as SWCLK and P1 as SWDIO.  This is the verified T5-Board
		route and is mutually exclusive with UART1.

endchoice

choice
	prompt "SWD target core"
	default BK7258_SWD_TARGET_CP

config BK7258_SWD_TARGET_CP
	bool "Physical CPU0 / CP"

config BK7258_SWD_TARGET_AP0
	bool "Physical CPU1 / AP logical CPU0"

config BK7258_SWD_TARGET_AP1
	bool "Physical CPU2 / AP logical CPU1"

endchoice

config BK7258_SWD_BOOT_HOLD
	bool "Wait in the final bootloader handoff for J-Link"
	default y
	depends on BK7258_SWD_TARGET_CP
	help
		After image authentication and final security/cache cleanup, BL1 for
		direct boot or BL2 for MCUboot waits for a debugger to attach and then
		write the explicit JLNK release word.  C_DEBUGEN alone cannot release
		the handoff because it is asserted before J-Link finishes CoreSight
		enumeration.  Only the CP route can be held here because both AP cores
		are still under CP lifecycle control.

endif # BK7258_SWD_DEBUG

