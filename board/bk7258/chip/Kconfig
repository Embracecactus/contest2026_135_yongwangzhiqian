config BK7258_JPEG_M2M
	bool "BK7258 JPEG V4L2 memory-to-memory decoder"
	default n
	depends on BK7258_JPEG_DECODER
	select DRIVERS_VIDEO
	select VIDEO_STREAM
	select SCHED_WORKQUEUE
	help
		Publish the BK7258 hardware JPEG decoder through NuttX's standard
		V4L2 memory-to-memory codec interface.  The output queue accepts one
		JPEG image per buffer and the capture queue returns interleaved YUYV.
		The first implementation accepts USERPTR only.  With D-cache enabled,
		capture addresses must be cache-line aligned and sizeimage includes
		trailing cache-line ownership padding.  The maintained AP handoff uses
		non-cacheable SRAM and therefore requires natural pointer alignment.
		In both cases bytesused is the exact decoded YUYV payload.
		The decoder is a chip-level singleton and permits one open owner.

if BK7258_JPEG_M2M

config BK7258_JPEG_M2M_DEVPATH
	string "JPEG M2M device path"
	default "/dev/video1"

config BK7258_JPEG_M2M_MAX_WIDTH
	int "Maximum decoded width"
	default 1920
	range 2 65535

config BK7258_JPEG_M2M_MAX_HEIGHT
	int "Maximum decoded height"
	default 1080
	range 1 65535

config BK7258_JPEG_M2M_DEFAULT_WIDTH
	int "Default decoded width"
	default 320
	range 2 BK7258_JPEG_M2M_MAX_WIDTH

config BK7258_JPEG_M2M_DEFAULT_HEIGHT
	int "Default decoded height"
	default 240
	range 1 BK7258_JPEG_M2M_MAX_HEIGHT

config BK7258_JPEG_M2M_MAX_INPUT_SIZE
	int "Maximum JPEG input buffer size"
	default 1048576
	range 4096 16777216

config BK7258_JPEG_M2M_WORKER_PRIORITY
	int "JPEG M2M worker priority"
	default 100
	range 1 255

config BK7258_JPEG_M2M_WORKER_STACKSIZE
	int "JPEG M2M worker stack size"
	default 4096
	range 2048 16384

config BK7258_JPEG_M2M_VALIDATION
	bool "Run bounded JPEG V4L2 M2M validation"
	default n
	help
		Launch a dedicated kernel thread after the standard codec device is
		registered.  It exercises the public V4L2 M2M ABI with a chip-only
		32x16 baseline JPEG fixture: capability and format negotiation,
		USERPTR queueing, an initial hardware decode, a truncated-input
		failure and successful recovery, plus STREAMOFF draining of an
		unmatched output buffer.

		The debugger-visible record contains bounded progress, flags, byte
		counts and observed CRCs.  The CRC is deliberately not compared with
		a host-invented golden value; PASS still requires two successful real
		hardware decodes and deterministic equality between those two runs.

endif # BK7258_JPEG_M2M

config BK7258_JPEG_ENCODER
	bool "BK7258 hardware JPEG encoder helper"
	default n
	depends on BK7258_AP_CORE && BK7258_PM_CLOCK
	select BK7258_SDK_IPC_RUNTIME
	help
		Build an AP-side typed helper for synchronous YUV422-to-JPEG encoding
		through the official v3.1.1.9 JPEG encoder, YUV buffer and DMA drivers.
		NuttX has no matching JPEG encoder lower-half, so this option does not
		create a private character-device ABI.  A camera or V4L2 media owner
		must explicitly own the encoder instance and all DMA-visible buffers.

		The helper uses bounded completion waits and defers SDK interrupt
		callbacks through the NuttX high-priority work queue.

config BK7258_YUV_H264
	bool "BK7258 YUV buffer and H.264 encoder helper"
	default n
	depends on BK7258_AP_CORE && BK7258_PM_CLOCK
	select BK7258_SDK_IPC_RUNTIME
	help
		Build an AP-side typed helper for a persistent YUV422-to-H.264
		encoding stream through the official v3.1.1.9 YUV buffer, H.264 and
		DMA drivers.  NuttX defines H.264 V4L2 formats but has no matching
		memory-to-memory encoder lower half in this tree, so this option does
		not create a private character-device ABI.  A camera or V4L2 media
		owner must explicitly own the encoder stream and all DMA-visible
		buffers.

		SDK callbacks remain interrupt-safe and frame completion is exposed
		through a bounded synchronous call.  The helper retains H.264 state
		between frames so the hardware GOP is not reset on every encode.

