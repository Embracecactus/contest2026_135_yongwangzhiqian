{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema": "bk7258.sdk/1",
  "kind": "sdk-metadata-schema",
  "version": 1,
  "strict": {
    "duplicate_keys": "reject",
    "unknown_keys": "reject",
    "content_addressed_ids": "sha256",
    "replacement": "forbidden",
    "sdk_bytes": "not-tracked",
    "network": "forbidden"
  },
  "provenance_kinds": ["official", "derived", "sealed-binary"],
  "documents": {
    "sdk-registry": {
      "required": ["schema", "kind", "version", "policy", "entries"],
      "additional_properties": false
    },
    "sdk-set": {
      "required": ["schema", "kind", "version", "id", "board", "product", "mode", "roles"],
      "additional_properties": false
    },
    "sdk-lock": {
      "required": ["schema", "kind", "version", "id", "set_id", "registry_path", "registry_sha256", "set_path", "set_sha256", "roles", "no_runtime_sdk_roles", "identity_sha256"],
      "additional_properties": false
    },
    "sdk-import-receipt": {
      "required": ["schema", "kind", "registry_id", "content_digest", "manifest_sha256", "provenance_sha256", "source_reproducible", "file_count", "bytes_copied", "network_used", "replacement", "identity_sha256"],
      "additional_properties": false
    }
  }
}
