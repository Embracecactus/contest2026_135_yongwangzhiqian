{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema": "bk7258.ownership/2",
  "kind": "architecture-ownership-schema",
  "version": 2,
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "version", "layers", "responsibility_tags", "dependency_rules", "init_phases", "build_contract", "config_policy", "identity_sha256"],
  "properties": {
    "schema": {"const": "bk7258.ownership/2"},
    "kind": {"const": "architecture-ownership-schema"},
    "version": {"const": 2},
    "layers": {"type": "object", "additionalProperties": false, "required": ["architecture", "chip", "board"]},
    "responsibility_tags": {"type": "object", "additionalProperties": false, "required": ["vendor_common_glue", "build_adapter", "external_upstream_needed", "migration_pending"]},
    "dependency_rules": {"type": "array", "minItems": 1},
    "init_phases": {"type": "array", "minItems": 4},
    "build_contract": {"type": "object", "additionalProperties": false},
    "config_policy": {"type": "object", "additionalProperties": false},
    "identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "strict": {
    "formal_layers": ["architecture", "chip", "board"],
    "hierarchy": "Architecture -> Chip/SoC -> Board",
    "responsibility_tags": ["vendor_common_glue", "build_adapter", "external_upstream_needed", "migration_pending"],
    "upstream_architecture": "not-modified-here",
    "board_init_phases": ["board_early_initialize", "board_late_initialize", "board_app_initialize", "board_app_finalinitialize"],
    "new_layer_paths": "forbidden"
  }
}
