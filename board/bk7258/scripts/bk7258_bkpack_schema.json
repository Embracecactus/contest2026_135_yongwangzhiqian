{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema": "bk7258.bkpack/1",
  "kind": "bkpack-schema",
  "version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "kind", "version", "package_id", "board", "product", "mode",
    "roles", "plan", "apps_plan", "build_plan_identity_sha256", "source_build_id",
    "signed_digest", "sdk_lock", "partition", "ranges", "artifacts", "tool",
    "trust", "hardware_verified", "identity_sha256"
  ],
  "properties": {
    "schema": {"const": "bk7258.bkpack/1"},
    "kind": {"enum": ["application", "factory"]},
    "version": {"const": 1},
    "package_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
    "board": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "variant"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "variant": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"}
      }
    },
    "product": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
    "mode": {"enum": ["bringup", "application", "validation", "factory"]},
    "roles": {"const": ["bl1", "bl2", "cp", "ap"]},
    "plan": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "name", "version", "range_policy", "artifact_policy"],
      "properties": {
        "kind": {"enum": ["application", "factory"]},
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "version": {"const": 1},
        "range_policy": {"const": "exact-partitions"},
        "artifact_policy": {"const": "standard-plus-additive-extension"}
      }
    },
    "apps_plan": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "kind", "version", "roles", "artifacts", "source_build_id"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "kind": {"const": "named-apps-plan"},
        "version": {"const": 1},
        "roles": {"const": ["cp", "ap"]},
        "artifacts": {"const": ["libarch.a", "libboards.a", "vela_cp.bin", "vela_ap.bin"]},
        "source_build_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "build_plan_identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_build_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signed_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "sdk_lock": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "identity_sha256", "roles"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "roles": {
          "type": "object", "additionalProperties": false,
          "required": ["cp", "ap", "bl2"],
          "properties": {
            "cp": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "ap": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "bl2": {"type": "null"}
          }
        }
      }
    },
    "partition": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "layout_id", "layout_sha256", "flash_size", "erase_size", "role_partitions", "range_policy"],
      "properties": {
        "source": {"type": "string", "pattern": "^[^/].*"},
        "layout_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "layout_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "flash_size": {"type": "integer", "minimum": 1},
        "erase_size": {"type": "integer", "minimum": 1},
        "role_partitions": {"type": "object", "additionalProperties": false},
        "range_policy": {"const": "exact-partitions"}
      }
    },
    "ranges": {"type": "array", "minItems": 4, "maxItems": 4},
    "artifacts": {"type": "array", "minItems": 7, "maxItems": 7},
    "tool": {
      "type": "object", "additionalProperties": false,
      "required": ["backend", "packer", "signer", "network_used", "bytes_written"],
      "properties": {
        "backend": {"const": "cmake"},
        "packer": {"const": "bk7258_framework.py"},
        "signer": {"type": "null"},
        "network_used": {"const": false},
        "bytes_written": {"const": false}
      }
    },
    "trust": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "signed", "signed_digest", "key_id", "flash_authorized"],
      "properties": {
        "mode": {"const": "host-reference-only"},
        "signed": {"const": false},
        "signed_digest": {"type": "null"},
        "key_id": {"type": "null"},
        "flash_authorized": {"const": false}
      }
    },
    "hardware_verified": {"const": false},
    "identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "strict": {
    "duplicate_keys": "reject",
    "unknown_keys": "reject",
    "apps_plan": "exactly-one-named-plan-per-package",
    "factory": "separate-kind-and-plan",
    "standard_artifacts": ["libarch.a", "libboards.a", "vela_cp.bin", "vela_ap.bin"],
    "vendor_boot_artifacts": ["bootloader.bin", "bl2.bin"],
    "vendor_extension": ".bkpack-additive-only",
    "source_build_id": "separate-from-signed-digest",
    "ranges": "non-overlapping-and-within-partition-and-flash",
    "extra_or_ambiguous": "reject",
    "signing": "not-invoked",
    "keys": "not-present",
    "flash": "not-invoked",
    "network": "forbidden",
    "hardware_verified": false
  }
}
