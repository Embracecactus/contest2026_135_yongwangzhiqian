{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema": "bk7258.framework-check/1",
  "kind": "framework-check-schema",
  "version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "version", "status", "checks", "hardware_accessed", "network_used", "identity_sha256"],
  "properties": {
    "schema": {"const": "bk7258.framework-check/1"},
    "kind": {"const": "framework-check"},
    "version": {"const": 1},
    "status": {"const": "PASS"},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "detail"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
          "status": {"const": "PASS"},
          "detail": {"type": "string", "minLength": 1}
        }
      }
    },
    "hardware_accessed": {"const": false},
    "network_used": {"const": false},
    "identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "strict": {
    "scope": "P0-P8-metadata-and-representative-plan-smoke",
    "build": "not-run",
    "hardware": "not-run",
    "network": "not-run"
  }
}
