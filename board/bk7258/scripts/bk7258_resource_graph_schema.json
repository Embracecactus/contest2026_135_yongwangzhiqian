{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema": "bk7258.resource-graph/1",
  "kind": "resource-graph-schema",
  "version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "version", "board", "product", "mode", "board_selection", "phases", "roles", "nodes", "edges", "resources", "temporal_handoff", "identity_sha256"],
  "properties": {
    "schema": {"const": "bk7258.resource-graph/1"},
    "kind": {"const": "resource-graph-schema"},
    "version": {"const": 1},
    "board": {"type": "string"},
    "product": {"type": "string"},
    "mode": {"enum": ["bringup", "application", "validation", "factory"]},
    "board_selection": {"type": "object", "additionalProperties": false},
    "phases": {"const": ["download", "boot", "hold", "runtime", "suspend", "restart"]},
    "roles": {"const": ["bl1", "bl2", "cp", "ap"]},
    "nodes": {"type": "array", "minItems": 4},
    "edges": {"type": "array", "minItems": 1},
    "resources": {"type": "object", "additionalProperties": false},
    "temporal_handoff": {"type": "array", "minItems": 1},
    "identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "strict": {
    "roles": "paired-bl1-bl2-cp-ap",
    "board_selection": "exactly-one-no-fallback",
    "sdk_singletons": "max_instances=1-with-explicit-owner",
    "resource_categories": ["pins_functions", "devpaths_minors", "irq_dma_clock_power", "sdk_singletons", "mailbox", "memory_psram", "bom"],
    "temporal_phases": ["download", "boot", "hold", "runtime", "suspend", "restart"]
  }
}
