# BK7258_BUNDLE_TREE_SHA256=ed3e6c3b49add274d48b53c4127c2fa942538ba1bfc7a8b79d51a7cbff649438
# BK7258 AP SD-card four-line data-path overlay.
#
# The v3.1.1.9 V2 host data helpers use this private build option on every
# receive/send setup.  Keep it in a separately versioned AP bundle so the
# default bundle remains truthful for one-line profiles.

CONFIG_SDCARD_BUSWIDTH_4LINE=y
# CONFIG_SDIO_4LINES_EN is not set
