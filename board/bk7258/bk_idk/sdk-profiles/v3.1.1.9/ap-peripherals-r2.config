# BK7258 AP peripheral-complete static-library profile.
#
# This is a board-owned Kconfig overlay for the unmodified official
# bk_avdk_smp v3.1.1.9 projects/app configuration.  NuttX Kconfig still
# decides which lower-half is linked and initialized at run time.

CONFIG_PWM=y

CONFIG_DVP_CAMERA=y
CONFIG_DVP_CAMERA_I2C_ID=2
CONFIG_DVP_CTRL_POWER_GPIO_ID=28
CONFIG_DVP_THREAD_STACK_SIZE=2048

# T5-Board routes the camera control bus to GPIO13/15 rather than either
# BK7258 hardware-I2C pin group.  In v3.1.1.9, I2C ID 2 is explicitly the
# GPIO-simulated controller; its pins are compile-time SDK configuration.
CONFIG_SIM_I2C=y
CONFIG_SIM_I2C_HW_BOARD_V3=y
CONFIG_SIM_I2C1_SCL_GPIO=13
CONFIG_SIM_I2C1_SDA_GPIO=15

CONFIG_DVP_GC0308=y
CONFIG_DVP_GC0328C=y
CONFIG_DVP_GC2145=y
CONFIG_DVP_HM1055=y
CONFIG_DVP_OV2640=y
CONFIG_DVP_SC101=y

CONFIG_YUV_BUF=y
CONFIG_JPEGENC_HW=y
CONFIG_H264=y
CONFIG_H264_QUALITY_LEVEL=2
CONFIG_H264_GOP_START_IDR_FRAME=y
CONFIG_H264_ADD_SELF_DEFINE_SEI=y
CONFIG_H264_P_FRAME_CNT=29

CONFIG_CAN=y
# CONFIG_CAN_PM_CB_SUPPORT is not set
# CONFIG_CAN_TEST is not set
# CONFIG_CAN_DEMO is not set

# ETH pin group 0 conflicts electrically with DVP when both are initialized.
# Both implementations are exported, but board Kconfig must select only the
# peripheral that is physically routed and in use.
CONFIG_ETH=y
CONFIG_ETH_PIN_GROUP0=y
# CONFIG_ETH_PIN_GROUP1 is not set
# CONFIG_ETH_PTP is not set
# CONFIG_ETH_VLAN is not set
# CONFIG_ETH_LPI is not set
# CONFIG_ETH_EEE is not set
# CONFIG_ETH_REGISTER_CALLBACKS is not set
# CONFIG_ETH_TSO is not set
CONFIG_ETH_CSUM_OFFLOAD=y
# CONFIG_ETH_PM_CB_SUPPORT is not set
