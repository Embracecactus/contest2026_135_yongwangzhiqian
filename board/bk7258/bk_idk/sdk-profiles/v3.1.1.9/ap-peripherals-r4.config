# BK7258 AP peripheral-complete static-library profile (r4).
#
# r4 extends r3 with the USB device (CDC-ACM serial gadget) data plane from
# the SDK CherryUSB component.  NuttX Kconfig still decides which lower half
# is linked and initialized at run time.

CONFIG_PWM=y

CONFIG_DVP_CAMERA=y
CONFIG_DVP_CAMERA_I2C_ID=2
CONFIG_DVP_CTRL_POWER_GPIO_ID=28
CONFIG_DVP_THREAD_STACK_SIZE=2048

CONFIG_SIM_I2C=y
CONFIG_SIM_I2C_HW_BOARD_V3=y
CONFIG_SIM_I2C1_SCL_GPIO=13
CONFIG_SIM_I2C1_SDA_GPIO=15

CONFIG_DVP_GC0308=y
CONFIG_DVP_GC0328C=y
CONFIG_DVP_GC2145=y
CONFIG_DVP_HM1055=y
CONFIG_DVP_OV2640=y
CONFIG_DVP_SC101=y

CONFIG_YUV_BUF=y
CONFIG_JPEGENC_HW=y
CONFIG_H264=y
CONFIG_H264_QUALITY_LEVEL=2
CONFIG_H264_GOP_START_IDR_FRAME=y
CONFIG_H264_ADD_SELF_DEFINE_SEI=y
CONFIG_H264_P_FRAME_CNT=29

CONFIG_CAN=y
# CONFIG_CAN_PM_CB_SUPPORT is not set
# CONFIG_CAN_TEST is not set
# CONFIG_CAN_DEMO is not set

CONFIG_ETH=y
CONFIG_ETH_PIN_GROUP0=y
# CONFIG_ETH_PIN_GROUP1 is not set
# CONFIG_ETH_PTP is not set
# CONFIG_ETH_VLAN is not set
# CONFIG_ETH_LPI is not set
# CONFIG_ETH_EEE is not set
# CONFIG_ETH_REGISTER_CALLBACKS is not set
# CONFIG_ETH_TSO is not set
CONFIG_ETH_CSUM_OFFLOAD=y
# CONFIG_ETH_PM_CB_SUPPORT is not set

CONFIG_LIN=y
CONFIG_SLCD=y
CONFIG_SBC=y
CONFIG_AUDIO_DMIC=y

# r4 additions: export the USB device (CDC-ACM serial) data plane.
CONFIG_USB_DEVICE=y
CONFIG_USB_CDC=y
# CONFIG_USBD_MSC is not set
# CONFIG_USBD_HID is not set
# CONFIG_USBD_UVC is not set
# CONFIG_USBD_UAC is not set
