# BK7258 CP NuttX application payload for the NuttX MCUboot BL2 hardware
# proof.  It is linked after a 0x200-byte MCUboot header (required to retain
# Cortex-M VTOR alignment) and must never be
# flashed as a direct BL1 application.

CONFIG_ARCH="arm"
CONFIG_ARCH_BOARD_CUSTOM=y
CONFIG_ARCH_BOARD_CUSTOM_DIR="../contest2026_135_yongwangzhiqian/board/bk7258_t5ai"
CONFIG_ARCH_BOARD_CUSTOM_DIR_RELPATH=y
CONFIG_ARCH_BOARD_CUSTOM_NAME="bk7258_t5ai"
CONFIG_ARCH_CHIP_ARM_CUSTOM=y
CONFIG_ARCH_CHIP_BK7258=y
CONFIG_ARCH_CHIP_CUSTOM=y
CONFIG_ARCH_CHIP_CUSTOM_DIR="../contest2026_135_yongwangzhiqian/board/bk7258_t5ai/chip"
CONFIG_ARCH_CHIP_CUSTOM_DIR_RELPATH=y
CONFIG_ARCH_CHIP_CUSTOM_NAME="bk7258"
CONFIG_ARCH_INTERRUPTSTACK=2048
CONFIG_ARMV8M_SYSTICK=y
CONFIG_BK7258_CLOCK_320M=y
CONFIG_BK7258_FLASH_LITTLEFS=y
CONFIG_BK7258_FLASH_MTD=y
CONFIG_BK7258_MCUBOOT_IMAGE=y
CONFIG_BK7258_SDK_IRQ_BRIDGE=y
CONFIG_IDLETHREAD_STACKSIZE=2048
CONFIG_INIT_ENTRYPOINT="nsh_main"
CONFIG_NSH_ARCHINIT=y
CONFIG_NSH_READLINE=y
CONFIG_RAW_BINARY=y
CONFIG_RR_INTERVAL=200
CONFIG_START_DAY=6
CONFIG_START_MONTH=8
CONFIG_START_YEAR=2026
CONFIG_STACK_USAGE_WARNING=0
CONFIG_SYSTEM_NSH=y
CONFIG_SYSTEM_TIME64=y
CONFIG_TIMER=y
CONFIG_TIMER_ARCH=y
CONFIG_WATCHDOG_AUTOMONITOR=y
CONFIG_WATCHDOG_AUTOMONITOR_PING_INTERVAL=2
CONFIG_WATCHDOG_AUTOMONITOR_TIMEOUT=8
