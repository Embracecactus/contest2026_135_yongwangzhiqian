	range 50 5000
	depends on BK7258_AP_SUPERVISOR && !BK7258_AP_CORE

config BK7258_AP_SUPERVISOR_SUSPECT_MS
	int "N10 peer suspect deadline (milliseconds)"
	default 1000
	range 250 30000
	depends on BK7258_AP_SUPERVISOR && !BK7258_AP_CORE

