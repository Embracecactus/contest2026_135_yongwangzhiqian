config ARCH_CHIP_BK7258
	bool "Beken BK7258 (T5-AI tri-core Cortex-M33)"
	depends on ARCH_CHIP_CUSTOM
	select ARCH_CORTEXM33
	select ARCH_HAVE_FPU
	select ARCH_HAVE_CUSTOM_VECTORS
	select ARCH_RAMVECTORS
	select ARCH_HAVE_MPU
	select MTD if BK7258_FLASH_MTD
	---help---
		Beken BK7258 SoC as shipped on the T5-AI board: tri-core
		Cortex-M33.  This Stage N1 port targets a single app core that
		the on-board Tier-1 bootloader (board/bk7258_t5ai/bootloader)
		jumps to at logical flash address 0x02010000 after validating
		the app magic "BK7236\0\0" at image offset 0x100.

		The chip provides its own Cortex-M vector table.  The CPU0/CP image
		keeps the BK7236 boot magic at vector slots 64/65; the optional
		CPU1/AP image uses a normal 80-entry __vector_core0_table.

config BK7258_AP_CORE
	bool "Build the physical CPU1 AP NuttX image"
	default n
	depends on ARCH_CHIP_BK7258
	select TIMER
	select TIMER_ARCH
	select ARMV8M_SYSTICK
	---help---
		Build the independent AP NuttX image whose primary is physical CPU1 /
		AP logical CPU0.  The ap_up configuration remains a single-core NuttX
		baseline with a freestanding CPU2 probe.  AP SMP is enabled only by the
		separate BK7258_AP_SMP_BOOTSTRAP option and configs/ap_smp.

config BK7258_AP_SMP_BOOTSTRAP
	bool "N8-B1 AP SMP secondary bootstrap"
	default n
	depends on BK7258_AP_CORE
	select ARCH_HAVE_MULTICPU
	---help---
		Enable the first AP SMP bring-up boundary.  NuttX creates logical CPU1's
		IDLE TCB and calls up_cpu_start(); physical CPU2 enters the NuttX-aware
		secondary bootstrap, validates its vector/VTOR/MSP and allocated IDLE
		stack, publishes secondary_ready, then remains parked before scheduler
		online.  Ordinary tasks remain restricted to logical CPU0.

config BK7258_AP_IPI
	bool "N8-B2 AP bidirectional IPI wrapper"
	default n
	depends on BK7258_AP_SMP_BOOTSTRAP
	select ARCH_IRQPRIO
	---help---
		Enable the AP-local logical CPU0 to logical CPU1 mailbox IPI wrapper.
		The wrapper uses the Beken SDK cross-core mailbox APIs while the
		team-owned SDK IRQ bridge routes source 63 through NuttX IRQ 79.  CPU2
		remains parked in WFI with scheduler online_mask 0x1; this option only
		proves bidirectional IRQ delivery and does not enable task scheduling on
		logical CPU1.

config BK7258_AP_SMP_SCHED_ONLINE
	bool "N8-C1 AP secondary scheduler-online idle"
	default n
	depends on BK7258_AP_IPI && SMP
	---help---
		Move physical CPU2 / AP logical CPU1 from the N8-B2 private WFI
		park loop into the NuttX nx_idle_trampoline path.  Scheduler and SMP
		call IPIs continue through the team wrapper and Beken SDK cross-core
		mailbox path; no direct MBOX0 data plane is added.  The first gate keeps
		CONFIG_SMP_DEFAULT_CPUSET=0x1, so ordinary tasks remain on logical CPU0.
		Graceful CPU hot-unplug is not provided; stop/restart/cycle are rejected
		while this scheduler-online mode is active.

config BK7258_AP_CONTROL
	bool "CPU0 control for the CPU1 AP NuttX image"
	default n
	depends on ARCH_CHIP_BK7258 && !BK7258_AP_CORE && SYSTEM_NSH
	select BUILTIN
	select NSH_BUILTIN_APPS
	---help---
		Add the CPU0 start/stop/restart wrapper and the manual apctl NSH
		command.  The first-stage protocol uses a reserved shared SRAM page
		and polled raw MBOX0/MBOX1 doorbells; it does not enable RPTUN.

config BK7258_AP_AUTOSTART
	bool "Start CPU1 AP during board bring-up"
	default n
	depends on BK7258_AP_CONTROL
	---help---
		Automatically start CPU1 after CPU0 board services initialize.
		Keep this disabled until the dual image has been flashed and the
		manual apctl start/status path is board-verified.

config BK7258_FLASH_MTD
	bool "BK7258 on-chip flash data-partition MTD"
	default n
	depends on ARCH_CHIP_BK7258 && !BK7258_AP_CORE
	select MTD
	---help---
		Expose the 1 MiB data partition (logical 0x00100000..0x001FFFFF)
		as a NuttX MTD instance.  read/erase/bwrite use the
		option-A SR0 block-protect policy (cleared around each op,
		restored afterwards).  No /dev node or filesystem is mounted
		by this driver; a filesystem mount requires separate
		authorisation (see BK7258_FLASH_LITTLEFS).

config BK7258_FLASH_LITTLEFS
	bool "BK7258 data-partition LittleFS (auto-format + mount)"
	default n
	depends on BK7258_FLASH_MTD
	select FS_LITTLEFS
	---help---
		Register /dev/mtdblock0 (ftl) over the data-partition MTD and mount
		LittleFS at /data with the "autoformat" option (formats on first
		boot only).  Also runs a probe-file persistence check.
		Destructive on the data partition; enable only when authorised.

config BK7258_CLOCK_320M
	bool "BK7258 deterministic 320 MHz CPU0 clock bring-up"
	default n
	depends on ARCH_CHIP_BK7258 && !BK7258_AP_CORE
	select BK7258_DVFS
	---help---
		Deterministically bring the CPU0 core clock to the 320 MHz tier
		(DPLL /1.5, the highest board-verified operating point; CPU0
		effective 160 MHz on this single-core port -- see BK7258_DVFS)
		at boot.  The bootloader enables + calibrates the DPLL at the SDK
		default analog state; this option makes the app step the core up
		to the 320 MHz runtime tier via bk7258_dvfs_set_freq().  480 MHz
		direct is SDK-rejected and not attempted.

config BK7258_CLOCK_320M_PROBE
	bool "BK7258 320 MHz bring-up verification probe (uart evidence line)"
	default n
	depends on BK7258_CLOCK_320M
	---help---
		Re-add a one-shot freestanding UART evidence line after the 320 MHz
		bring-up showing M1/ANA_REG5/ANA_REG9 readback, for one
		verification build.  Disable after board-verify.

config BK7258_DVFS
	bool "BK7258 runtime CPU-frequency switching (DVFS lower half)"
	default n
	depends on ARCH_CHIP_BK7258 && !BK7258_AP_CORE
	---help---
		Provide bk7258_dvfs_set_freq(int tier) -- a standalone NuttX
		overlay DVFS lower half that mirrors the Armino SDK runtime
		sys_drv_switch_cpu_bus_freq / sys_hal_switch_cpu_bus_freq path
		(lift VDDD/VDDIG one tier at a time per the SDK operating-point
		table, then switch the core mux, then recompute the SysTick
		reload).  This is NOT the NuttX PM state machine: it follows the
		lc823450 DVFS precedent of a single chip-local set_freq() with no
		governor/HPWORK dependency.  Boot-time bring-up under
		BK7258_CLOCK_320M selects this; runtime switching via /proc/dvfs
		is available under BK7258_DVFS_PROCFS.

config BK7258_DVFS_PROCFS
	bool "BK7258 /proc/dvfs runtime DVFS control"
	default n
	depends on BK7258_DVFS
	select FS_PROCFS
	select FS_PROCFS_REGISTER
	---help---
		Register /proc/dvfs so the current CPU frequency tier can be
		queried (`cat /proc/dvfs`) and stepped at runtime
		(`echo "cur_freq 80" > /proc/dvfs`), exercising the full DVFS
		lower half from userspace.  Requires FS_PROCFS +
		FS_PROCFS_REGISTER (both selected here) for the procfs_register
		run-time registration API.

config BK7258_WDT
	bool "BK7258 APB watchdog (WDT) lower-half driver"
	default y
	depends on ARCH_CHIP_BK7258 && !BK7258_AP_CORE
	select WATCHDOG
	---help---
		Register /dev/watchdog0 backed by the BK7258 APB hardware
		watchdog.  Mirrors the Armino SDK WDT BSP
		(bk_wdt_driver_init / bk_wdt_start / bk_wdt_feed path).
		The bootloader arms the WDT during cold-init; this driver
		takes over after boot and feeds it via the NuttX watchdog
		upper-half automonitor (CONFIG_WATCHDOG_AUTOMONITOR).
		Default timeout 8 s (period=8000), matching the bootloader.

config BK7258_SDK_IRQ_BRIDGE
	bool "Beken SDK CPU0 interrupt bridge"
	default n
	depends on ARCH_CHIP_BK7258 && !BK7258_AP_CORE
	select ARCH_IRQPRIO
	---help---
		Enable the common Beken SDK-to-NuttX IRQ bridge for the CPU0 image.
		SDK sources 0..63 map one-to-one to NuttX logical IRQs 16..79.
		The AP-SMP image selects the same common bridge implementation through
		BK7258_AP_IPI; this activation option remains CP-only.

config BK7258_SDK_IRQ_TIMER_TEST
	bool "Beken SDK IRQ bridge TIMER1 manual test"
	default n
	depends on BK7258_SDK_IRQ_BRIDGE && SYSTEM_NSH
	select BUILTIN
	select NSH_BUILTIN_APPS
	---help---
		Build the manual bkirqtest NSH command. The command temporarily
		replaces the SDK INT_SRC_TIMER callback, triggers TIMER_ID1,
		proves unregister silence and re-registration, then restores the
		original callback. It never runs from board bring-up.

config BK7258_GPIO_FOUNDATION_TEST
	bool "BK7258 T5-AI GPIO foundation manual test"
	default n
	depends on ARCH_CHIP_BK7258 && SYSTEM_NSH
	select BUILTIN
	select NSH_BUILTIN_APPS
	---help---
		Build the manual bkgpioc0 NSH command. The command exercises the
		active-high board LED on GPIO9 and the active-low USERKEY on GPIO29
		using polling only, then restores both pin states. It never runs
		from board bring-up and does not enable GPIO interrupts.

config BK7258_GPIO_IRQ_TEST
	bool "BK7258 T5-AI P29 GPIO edge IRQ manual test"
	default n
	depends on BK7258_SDK_IRQ_BRIDGE && SYSTEM_NSH
	select BUILTIN
	select NSH_BUILTIN_APPS
	---help---
		Build the manual bkgpioirq NSH command. The command uses USERKEY
		on GPIO29 to prove falling and rising edge callbacks. It mirrors
		the SDK GPIO_S source-55 handler onto GPIO_NS source 56 for the
		test, then restores both the IRQ route and original pin state.

config BK7258_GPIO_LOWERHALF
	bool "BK7258 T5-AI NuttX GPIO lower-half"
	default n
	depends on BK7258_SDK_IRQ_BRIDGE
	select DEV_GPIO
	---help---
		Register the active-high P9 board LED as /dev/gpio0 and the
		active-low P29 USERKEY as /dev/gpio1 through the standard NuttX
		GPIO upper half. P29 supports one selected rising or falling edge
		at a time; level, both-edge, wakeup and debounce modes are not
		supported. A validation application is selected separately.
