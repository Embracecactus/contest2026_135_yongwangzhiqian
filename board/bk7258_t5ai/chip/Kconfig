	int "N10 RPMsg health probe timeout (milliseconds)"
	default 750
	range 100 10000
	depends on BK7258_AP_SUPERVISOR && !BK7258_AP_CORE

config BK7258_AP_SUPERVISOR_AUTO_RECOVER
	bool "N10 automatically restart a faulted AP"
	default n
	depends on BK7258_AP_SUPERVISOR && !BK7258_AP_CORE
	---help---
		Automatically invoke the existing generation-safe AP restart path after
		a confirmed supervisor fault.  Keep this disabled until passive fault
		detection and manual recovery have completed board fault-injection soak.

config BK7258_AP_SUPERVISOR_FAULT_INJECTION
	bool "N10 synthetic supervisor fault injection"
	default n
	depends on BK7258_AP_SUPERVISOR && !BK7258_AP_CORE
	---help---
		Add explicit apctl injection commands for primary-heartbeat,
		secondary-heartbeat and RPMsg-timeout classification.  Injection is
		CP-local: it suppresses one observation without modifying the AP,
		NuttX or SDK.  It never runs unless requested and is cleared by an AP
		lifecycle transition or supervisor recovery.  Enable only in validation
		profiles.

config BK7258_AP_SUPERVISOR_MAX_RECOVERIES
	int "N10 automatic recovery budget"
	default 3
	range 1 10
	depends on BK7258_AP_SUPERVISOR_AUTO_RECOVER

config BK7258_AP_SUPERVISOR_STABLE_MS
	int "N10 healthy interval before recovery budget reset (milliseconds)"
	default 60000
	range 5000 600000
	depends on BK7258_AP_SUPERVISOR_AUTO_RECOVER

config BK7258_RPMSGFS
	bool "N11 AP access to CP LittleFS through RPMsgFS"
	default n
	depends on BK7258_RPTUN
	depends on BK7258_AP_CORE || BK7258_FLASH_LITTLEFS
	select FS_RPMSGFS if BK7258_AP_CORE
	select FS_RPMSGFS_SERVER if !BK7258_AP_CORE
	---help---
		Keep flash, MTD and LittleFS ownership on CP.  CP enables the stock
		NuttX RPMsgFS server; AP enables the stock client and mounts CP /data
		at /cpdata.  The board wrapper never modifies the NuttX protocol or
		the Beken SDK.

config BK7258_RPMSGFS_TEST
	bool "N11 bounded RPMsgFS functional and recovery test"
	default n
	depends on BK7258_RPMSGFS && !DISABLE_PTHREAD
	depends on !BK7258_AP_CORE || SMP
	select BUILTIN if !BK7258_AP_CORE
	select NSH_BUILTIN_APPS if !BK7258_AP_CORE
	---help---
		Add a board-owned control endpoint and bkrpmsgfstest command.  The AP
		endpoint callback only queues work; one permanent logical-CPU0 worker
		performs bounded-size operations below /cpdata/rpmsgfs-n11.  CP waits
		with an explicit deadline and validates generation-tagged results.

config BK7258_RPMSGFS_TEST_PRIORITY
	int "N11 AP RPMsgFS test worker priority"
	default 100
	range 1 199
	depends on BK7258_RPMSGFS_TEST && BK7258_AP_CORE
	---help---
		SCHED_FIFO priority of the AP logical-CPU0 file worker.  It remains
		below the AP supervisor and all RPTUN/RPMsg transport workers.

config BK7258_RPMSGFS_TEST_STACKSIZE
	int "N11 AP RPMsgFS test worker stack size"
	default 8192
	range 4096 16384
	depends on BK7258_RPMSGFS_TEST && BK7258_AP_CORE

config BK7258_BT_IPC
	bool "N12 official Beken Bluetooth mailbox IPC wrapper"
	default n
	depends on BK7258_RPTUN_MBOX
	depends on !BK7258_AP_CORE || (DRIVERS_BLUETOOTH && NET_BLUETOOTH && WIRELESS_BLUETOOTH)
	---help---
		Use the official SDK MB_CHNL_BT_CMD protocol without modifying either
		NuttX or the SDK.  The CP image starts the Beken controller-side IPC
		worker.  The AP image registers a board-owned bt_driver_s lower half,
		translates NuttX HCI command/ACL packets to bt_ipc_* calls and copies
		SDK event/ACL callbacks into the stock NuttX Bluetooth Host.

		This is independent of the generic RPTUN/RPMsg services: both share the
		SDK physical mailbox dispatcher but reserve different logical channels.
		The initial profile supports HCI command, event and ACL traffic; SCO and
		ISO are deliberately out of scope.

config BK7258_WIFI_VNET
	bool "N16 official Beken CP Wi-Fi with AP NuttX network"
	default n
	depends on BK7258_RPTUN_MBOX && BK7258_RPTUN
	depends on !BK7258_AP_CORE || (SMP && NET)
	select BUILTIN if !BK7258_AP_CORE
	select NSH_BUILTIN_APPS if !BK7258_AP_CORE
	---help---
		Keep the official Beken v3.1.1.9 Wi-Fi controller, RF/PHY,
		supplicant and mailbox data plane on CP.  On AP, use the official
		vendor vnet proxy only below a board-owned NuttX wlan0 adapter; the
		SDK lwIP and FreeRTOS runtimes remain unlinked.

		The first profile is STA-only.  Wi-Fi initialization and all AP-side
		SDK-facing workers are owned by AP logical CPU0.

config BK7258_WIFI_CONTROL_PRIORITY
	int "N16 AP Wi-Fi control worker priority"
	default 100
	range 1 199
	depends on BK7258_WIFI_VNET && BK7258_AP_CORE
	---help---
		SCHED_FIFO priority for the logical-CPU0 STA control and CP-lease
		synchronization worker.  The official VNET controller performs DHCP
		on CP; AP must not start a second DHCP client.

config BK7258_WIFI_CONTROL_STACKSIZE
	int "N16 AP Wi-Fi control worker stack size"
	default 6144
	range 3072 16384
	depends on BK7258_WIFI_VNET && BK7258_AP_CORE
	---help---
		Stack size for the STA control and native NuttX lease-sync worker.

config BK7258_BT_IPC_TEST
	bool "N12 bounded Bluetooth IPC hardware test"
	default n
	depends on BK7258_BT_IPC && BK7258_RPTUN && !DISABLE_PTHREAD
	depends on !BK7258_AP_CORE || NETDEV_IOCTL
	select BUILTIN if !BK7258_AP_CORE
	select NSH_BUILTIN_APPS if !BK7258_AP_CORE
	---help---
		Add a board-owned diagnostic endpoint and bkbttest command.  The AP
		endpoint callback only queues requests; a permanent logical-CPU0 worker
		uses the stock NuttX Bluetooth socket ioctls to report the Controller
		address/features and perform a bounded LE scan.  CP waits with an
		explicit deadline and validates generation-tagged results.

config BK7258_BT_IPC_TEST_PRIORITY
	int "N12 AP Bluetooth test worker priority"
	default 100
	range 1 199
	depends on BK7258_BT_IPC_TEST && BK7258_AP_CORE
	---help---
		SCHED_FIFO priority of the AP logical-CPU0 Bluetooth diagnostic worker.
		It remains below the AP supervisor and RPTUN transport workers.

config BK7258_BT_IPC_TEST_STACKSIZE
	int "N12 AP Bluetooth test worker stack size"
	default 8192
	range 4096 16384
	depends on BK7258_BT_IPC_TEST && BK7258_AP_CORE

config BK7258_BT_IPC_TRACE
	bool "N13 Bluetooth host stack boundary counters"
	default n
	depends on BK7258_BT_IPC_TEST && BK7258_AP_CORE
	---help---
		Wrap the stock NuttX Bluetooth host boundary functions and expose
		monotonic counters through the existing bkbttest stats operation.
		Except for separately selected compatibility fixes, the wrappers call
		the original implementation unchanged.  They are a board-owned
		diagnostic aid for the HCI, L2CAP/ATT and connection-TX path and do not
		modify NuttX or the Beken SDK.

config BK7258_BT_CONN_RX_REF_COMPAT
	bool "N13 inbound ACL connection-reference compatibility wrapper"
	default n
	depends on BK7258_BT_IPC_TRACE
	---help---
		Release the caller-owned bt_conn reference after the stock
		bt_conn_receive implementation returns.  The current NuttX hci_acl
		path obtains one reference with bt_conn_lookup_handle for every inbound
		ACL packet but does not release it, so a completed GATT session leaves
		the single connection slot permanently occupied.

		This board-owned link wrapper keeps NuttX unmodified.  The N13 verifier
		checks the exact upstream ownership pattern and fails closed if the
		NuttX implementation changes, preventing a future double release.

config BK7258_BT_ATT_MTU_COMPAT
	bool "N13 oversized peer ATT MTU compatibility wrapper"
	default n
	depends on BK7258_BT_IPC_TRACE
	---help---
		Clamp an inbound ATT Exchange MTU request above the stock NuttX host
		limit to that limit before passing it to the unmodified host stack.
		This preserves the normal server-side minimum negotiation while working
		around the stock host rejecting newer peers that advertise a larger
		receive capability.  The wrapper is board-owned and exposes a hit count
		through bkbttest stats.

config BK7258_BLE_GATT
	bool "N13 board BLE GAP/GATT peripheral service"
	default n
	depends on BK7258_BT_IPC && BK7258_AP_CORE
	depends on WIRELESS_BLUETOOTH_HOST
	---help---
		Replace the stock startup-only GAP database with one static combined
		GAP plus N13 service table, advertise the N13 UUID/name, and run all
		lifecycle and notification work in a logical-CPU0 kernel thread.  This
		is a board wrapper over the unmodified NuttX Host; the Beken SDK remains
		Controller-only.

config BK7258_BLE_GATT_PRIORITY
	int "N13 BLE GATT worker priority"
	default 96
	range 1 199
	depends on BK7258_BLE_GATT
	---help---
		SCHED_FIFO priority of bk7258-ble-gatt.  It must remain below the
		Bluetooth LPWORK priority so ATT and disconnection cleanup finish first.

config BK7258_BLE_GATT_STACKSIZE
	int "N13 BLE GATT worker stack size"
	default 8192
	range 4096 16384
	depends on BK7258_BLE_GATT

config BK7258_BLE_GATT_NOTIFY_INTERVAL_MS
	int "N13 notification burst interval (ms)"
	default 20
	range 5 1000
	depends on BK7258_BLE_GATT
	---help---
		Fixed pacing interval for the bounded one-to-100 frame validation burst.

config BK7258_PSRAM
	bool "N14 official-driver PSRAM wrapper and role-local heaps"
	default n
	depends on ARCH_CHIP_BK7258
	---help---
		Initialize PSRAM only from CP through the official Beken bk_psram_init
		API, then expose disjoint board-owned NuttX MM heaps to the SDK
		psram_* ABI.  The heap ranges exactly preserve the v3.1.1.9 default
		8 MiB ram_regions.csv contract: CP 0x60700000+0x20000 and AP
		0x60720000+0xa0000.  Matching the official v3.1.1.9 MPU table,
		region 6 maps the 0x60000000..0x63ffffff PSRAM aperture as
		Non-shareable Normal Non-cacheable on CP plus both AP logical CPUs.
		PSRAM remains powered for the complete N14 boot generation;
		sleep/power-down ownership is out of scope.

config BK7258_PSRAM_BOOT_TEST
	bool "N14 destructive full-capacity PSRAM boot test"
	default n
	depends on BK7258_PSRAM && !BK7258_AP_CORE
	---help---
		After the official CP driver detects the device and before either
		role-local heap or AP starts, run walking-data, address-alias,
		address-derived, inverse and final-zero passes over the complete
		detected 8 MiB or 16 MiB device.  This is safe only at that boot
		boundary and deliberately has no runtime command that could overwrite
		live heaps or future media slabs.  Enable in the N14 validation
		profile, not in a latency-sensitive production profile.

config BK7258_PSRAM_TEST
	bool "N14 bounded PSRAM allocator and AP SMP test"
	default n
	depends on BK7258_PSRAM
	depends on !BK7258_AP_CORE || (SMP && !DISABLE_PTHREAD)
	select BUILTIN if !BK7258_AP_CORE
	select NSH_BUILTIN_APPS if !BK7258_AP_CORE
	---help---
		Add the CP bkpsramtest NSH command and run the AP allocator gate before
		AP READY.  The AP gate creates joinable SRAM-stack workers pinned to
		logical CPU0 and CPU1, performs concurrent alloc/zero/realloc/check/free
		loops and requires the heap free count to return to its baseline.

config BK7258_PSRAM_TEST_ITERATIONS
	int "N14 allocator iterations per worker"
	default 128
	range 16 4096
	depends on BK7258_PSRAM_TEST

config BK7258_PSRAM_TEST_STACKSIZE
	int "N14 AP PSRAM test worker SRAM stack size"
	default 2048
	range 2048 8192
	depends on BK7258_PSRAM_TEST

config BK7258_FLASH_MTD
	bool "BK7258 on-chip flash data-partition MTD"
	default n
	depends on ARCH_CHIP_BK7258 && !BK7258_AP_CORE
	select MTD
	---help---
		Expose the 1 MiB data partition (raw 0x00600000..0x006FFFFF)
		as a NuttX MTD instance.  read/erase/bwrite use the
		option-A SR0 block-protect policy (cleared around each op,
		restored afterwards).  No /dev node or filesystem is mounted
		by this driver; a filesystem mount requires separate
		authorisation (see BK7258_FLASH_LITTLEFS).

config BK7258_FLASH_LITTLEFS
	bool "BK7258 data-partition LittleFS (auto-format + mount)"
	default n
	depends on BK7258_FLASH_MTD
	select FS_LITTLEFS
	---help---
		Register /dev/mtdblock0 (ftl) over the data-partition MTD and mount
		LittleFS at /data with the "autoformat" option (formats on first
		boot only).  Also runs a probe-file persistence check.
		Destructive on the data partition; enable only when authorised.

config BK7258_OTA_STAGING
	bool "N15 CP-only inactive-slot validation and staging wrapper"
	default n
	depends on BK7258_FLASH_MTD && !BK7258_AP_CORE
	select CRYPTO
	select MTD_PARTITION
	select MTD_BYTE_WRITE
	---help---
		Compile the team-owned N15-B descriptor/RBL/CRC/SHA-256 validator and
		bounded inactive-slot staging state machine.  The SDK Flash lower-half
		is split by NuttX mtd_partition() into private A/B CP/AP-pair MTD
		children, so staging does not use raw SDK address writes.  The CP Flash
		guard
		serializes each 4 KiB transaction with LittleFS and dynamically admits
		exactly A or B according to the current remap state.  This option cannot
		write Flash: the separate compile write gate is still off and the
		runtime gate initializes false.

config BK7258_OTA_STAGING_WRITE
	bool "N15 compile gate for inactive-slot mutation (unsafe until authorised)"
	default n
	depends on BK7258_OTA_STAGING
	---help---
		Allow the CP Flash permission wrapper to admit exactly the inactive pair.
		The runtime gate still initializes false and no N15-B command enables
		it.  Keep this option disabled through host/source/ELF closure and
		require fresh owner authority before any board-write build or test.

config BK7258_OTA_TRIAL
	bool "N15 CP-only symmetric trial and dual-bank publication wrapper"
	default n
	depends on BK7258_OTA_STAGING && BK7258_AP_SUPERVISOR && !BK7258_AP_CORE
	---help---
		Compile the format-2 append-only metadata parser/controller, inactive-
		bank publication, CP confirm and explicit rollback APIs for A and B.
		Records alternate between the generated primary/mirror 4 KiB banks and
		use 32-byte program/read-back steps.  The selected durable bank is never
		erased during publication.  This option alone cannot mutate metadata:
		the separate compile write gate is off and the runtime gate initializes
		false.

config BK7258_OTA_HEALTH_STABLE_MS
	int "N15-F continuous AP/RPTUN health before trial confirmation (ms)"
	default 5000
	range 1000 60000
	depends on BK7258_OTA_TRIAL
	---help---
		Require this continuous healthy interval during an explicit confirm
		request.  Supervisor unhealthy state, generation drift or a changed
		fault counter restarts the interval; confirmation is never automatic.

config BK7258_OTA_HEALTH_POLL_MS
	int "N15-F health confirmation poll interval (ms)"
	default 250
	range 50 1000
	depends on BK7258_OTA_TRIAL

config BK7258_OTA_TRIAL_WRITE
	bool "N15 compile gate for dual-bank metadata mutation (unsafe until authorised)"
	default n
	depends on BK7258_OTA_TRIAL && BK7258_OTA_STAGING_WRITE
	---help---
		Allow the CP Flash permission wrapper to admit only the two generated
		4 KiB metadata banks for publication, trial, confirm or rollback.  The
		runtime gate still initializes false and no normal-profile NSH command
		enables it.  Keep disabled through host/source/ELF closure and require
		fresh owner authority before any board-write build or test.

config BK7258_OTA_N17_WRITE
	bool "N17 compile gate for signed Manifest and journal mutation"
	default n
	depends on BK7258_OTA_STAGING && BK7258_OTA_STAGING_WRITE
	---help---
		Allow the private N17 MTD children to mutate only the two lifecycle
		journal sectors and two signed-Manifest sectors.  It never admits the
		one-way authentication-policy sector.  Runtime publication remains
		disabled until a later, explicitly authorised release path exists.
		Keep this disabled for normal builds and all current board tests.

config BK7258_OTA_VALIDATION
	bool "N15-F validation-only OTA command (destructive)"
	default n
	depends on BK7258_OTA_STAGING_WRITE && BK7258_OTA_TRIAL_WRITE
	depends on BK7258_PSRAM
	depends on SYSTEM_NSH && !BK7258_AP_CORE
	---help---
		Build the validation-only bkota command.  Every mutating invocation
		requires an explicit generation-bound authorization token, arms only
		the required runtime gate and disarms all gates before returning.  This
		profile is not a production updater: it accepts unsigned host-generated
		artifacts and must never be enabled in the normal CP configuration.
		The fixed J-Link transfer window requires the board-verified 16 MiB
		PSRAM and is rejected at runtime on an 8 MiB or unready device.

config BK7258_OTA_FAULT_INJECTION
	bool "N15-V deterministic OTA boundary fault injection"
	default n
	depends on BK7258_OTA_VALIDATION
	---help---
		Add validation-only, generation-bound, one-shot failpoints around the
		s_app and metadata erase/program/read callbacks.  The normal profile
		cannot compile this interface.  A failpoint is armed by the explicit
		bkota command, applies only to the matching next mutation command and
		is cleared after that command or by reset.

config BK7258_CLOCK_320M
	bool "BK7258 temporary 320 MHz CPU0 bring-up target"
	default n
	depends on ARCH_CHIP_BK7258 && !BK7258_AP_CORE
	select BK7258_DVFS
	---help---
		Select the board-verified 320 MHz tier as the initial bring-up target
		(DPLL /1.5, the highest board-verified operating point; CPU0
		effective 160 MHz on this single-core port -- see BK7258_DVFS)
		at boot.  The bootloader enables + calibrates the DPLL at the SDK
		default analog state; this option makes the app step the core up
		to the 320 MHz runtime tier via bk7258_dvfs_set_freq().  480 MHz
		direct is SDK-rejected and not attempted.  This is a bring-up default,
		not the final power policy: runtime clients and a future NuttX PM/DVFS
		governor must use the same bk7258_dvfs_set_freq() lower half.

config BK7258_CLOCK_320M_PROBE
	bool "BK7258 320 MHz bring-up verification probe (uart evidence line)"
	default n
	depends on BK7258_CLOCK_320M
	---help---
		Re-add a one-shot freestanding UART evidence line after the 320 MHz
		bring-up showing M1/ANA_REG5/ANA_REG9 readback, for one
		verification build.  Disable after board-verify.

config BK7258_DVFS
	bool "BK7258 runtime CPU-frequency switching (DVFS lower half)"
	default n
	depends on ARCH_CHIP_BK7258 && !BK7258_AP_CORE
	---help---
		Provide bk7258_dvfs_set_freq(int tier) -- a standalone NuttX
		overlay DVFS lower half that mirrors the Armino SDK runtime
		sys_drv_switch_cpu_bus_freq / sys_hal_switch_cpu_bus_freq path
		(lift VDDD/VDDIG one tier at a time per the SDK operating-point
		table, then switch the core mux, then recompute the SysTick
		reload).  This is NOT the NuttX PM state machine: it follows the
		lc823450 DVFS precedent of a single chip-local set_freq() with no
		governor/HPWORK dependency.  Boot-time bring-up under
		BK7258_CLOCK_320M selects this; runtime switching via /proc/dvfs
		is available under BK7258_DVFS_PROCFS.

config BK7258_DVFS_PROCFS
	bool "BK7258 /proc/dvfs runtime DVFS control"
	default n
	depends on BK7258_DVFS
	select FS_PROCFS
	select FS_PROCFS_REGISTER
	---help---
		Register /proc/dvfs so the current CPU frequency tier can be
		queried (`cat /proc/dvfs`) and stepped at runtime
		(`echo "cur_freq 80" > /proc/dvfs`), exercising the full DVFS
		lower half from userspace.  Requires FS_PROCFS +
		FS_PROCFS_REGISTER (both selected here) for the procfs_register
		run-time registration API.

config BK7258_WDT
	bool "BK7258 APB watchdog (WDT) lower-half driver"
	default y
	depends on ARCH_CHIP_BK7258 && !BK7258_AP_CORE
	select WATCHDOG
	---help---
		Register /dev/watchdog0 backed by the BK7258 APB hardware
		watchdog.  Mirrors the Armino SDK WDT BSP
		(bk_wdt_driver_init / bk_wdt_start / bk_wdt_feed path).
		The bootloader arms the WDT during cold-init; this driver
		takes over after boot and feeds it via the NuttX watchdog
		upper-half automonitor (CONFIG_WATCHDOG_AUTOMONITOR).
		Default timeout 8 s (period=8000), matching the bootloader.

config BK7258_SDK_IRQ_BRIDGE
	bool "Beken SDK CPU0 interrupt bridge"
	default n
	depends on ARCH_CHIP_BK7258 && !BK7258_AP_CORE
	select ARCH_IRQPRIO
	---help---
		Enable the common Beken SDK-to-NuttX IRQ bridge for the CPU0 image.
		SDK sources 0..63 map one-to-one to NuttX logical IRQs 16..79.
		The AP-SMP image selects the same common bridge implementation through
		BK7258_AP_IPI; this activation option remains CP-only.

config BK7258_SDK_IRQ_TIMER_TEST
	bool "Beken SDK IRQ bridge TIMER1 manual test"
	default n
	depends on BK7258_SDK_IRQ_BRIDGE && SYSTEM_NSH
	select BUILTIN
	select NSH_BUILTIN_APPS
	---help---
		Build the manual bkirqtest NSH command. The command temporarily
		replaces the SDK INT_SRC_TIMER callback, triggers TIMER_ID1,
		proves unregister silence and re-registration, then restores the
		original callback. It never runs from board bring-up.

config BK7258_SDK_TIMER_SELFTEST
	bool "Beken SDK software-timer lifecycle regression test"
	default n
	depends on ARCH_CHIP_BK7258 && !BK7258_AP_CORE && SYSTEM_NSH
	select BUILTIN
	select NSH_BUILTIN_APPS
	---help---
		Build the bktimertest NSH command.  It repeatedly deletes a periodic
		SDK timer from inside its own callback and proves that callbacks run
		in the board timer-service task rather than the NuttX watchdog ISR.
		This is the regression gate for the SDK wrapper's deferred-free
		lifecycle and never runs automatically during board bring-up.

config BK7258_GPIO_FOUNDATION_TEST
	bool "BK7258 T5-AI GPIO foundation manual test"
	default n
	depends on ARCH_CHIP_BK7258 && SYSTEM_NSH
	select BUILTIN
	select NSH_BUILTIN_APPS
	---help---
		Build the manual bkgpioc0 NSH command. The command exercises the
		active-high board LED on GPIO9 and the active-low USERKEY on GPIO29
		using polling only, then restores both pin states. It never runs
		from board bring-up and does not enable GPIO interrupts.

config BK7258_GPIO_IRQ_TEST
	bool "BK7258 T5-AI P29 GPIO edge IRQ manual test"
	default n
	depends on BK7258_SDK_IRQ_BRIDGE && SYSTEM_NSH
	select BUILTIN
	select NSH_BUILTIN_APPS
	---help---
		Build the manual bkgpioirq NSH command. The command uses USERKEY
		on GPIO29 to prove falling and rising edge callbacks. It mirrors
		the SDK GPIO_S source-55 handler onto GPIO_NS source 56 for the
		test, then restores both the IRQ route and original pin state.

config BK7258_GPIO_LOWERHALF
	bool "BK7258 T5-AI NuttX GPIO lower-half"
	default n
	depends on BK7258_SDK_IRQ_BRIDGE
	select DEV_GPIO
	---help---
		Register the active-high P9 board LED as /dev/gpio0 and the
		active-low P29 USERKEY as /dev/gpio1 through the standard NuttX
		GPIO upper half. P29 supports one selected rising or falling edge
		at a time; level, both-edge, wakeup and debounce modes are not
		supported. A validation application is selected separately.

