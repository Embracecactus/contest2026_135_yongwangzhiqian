config ARCH_CHIP_BK7258
	bool "Beken BK7258 (T5-AI tri-core Cortex-M33)"
	depends on ARCH_CHIP_CUSTOM
	select ARCH_CORTEXM33
	select ARCH_HAVE_FPU
	select ARCH_HAVE_CUSTOM_VECTORS
	select ARCH_RAMVECTORS
	select ARCH_HAVE_MPU
	select MTD if BK7258_FLASH_MTD
	---help---
		Beken BK7258 SoC as shipped on the T5-AI board: tri-core
		Cortex-M33.  This Stage N1 port targets a single app core that
		the on-board Tier-1 bootloader (board/bk7258_t5ai/bootloader)
		jumps to at logical flash address 0x02010000 after validating
		the app magic "BK7236\0\0" at image offset 0x100.

		The chip provides its own Cortex-M vector table (selected via
		ARCH_HAVE_CUSTOM_VECTORS) so that the BK7236 app magic can be
		placed at vector slot 64/65 (image offset 0x100), exactly where
		the bootloader looks for it.

config BK7258_FLASH_MTD
	bool "BK7258 on-chip flash data-partition MTD"
	default n
	depends on ARCH_CHIP_BK7258
	select MTD
	---help---
		Expose the 1 MiB data partition (logical 0x00100000..0x001FFFFF)
		as a NuttX MTD instance.  read/erase/bwrite use the
		option-A SR0 block-protect policy (cleared around each op,
		restored afterwards).  No /dev node or filesystem is mounted
		by this driver; a filesystem mount requires separate
		authorisation (see BK7258_FLASH_LITTLEFS).

config BK7258_FLASH_LITTLEFS
	bool "BK7258 data-partition LittleFS (auto-format + mount)"
	default n
	depends on BK7258_FLASH_MTD
	select FS_LITTLEFS
	---help---
		Register /dev/mtdblock0 (ftl) over the data-partition MTD and mount
		LittleFS at /data with the "autoformat" option (formats on first
		boot only).  Also runs a probe-file persistence check.
		Destructive on the data partition; enable only when authorised.

config BK7258_CLOCK_320M
	bool "BK7258 deterministic 320 MHz CPU0 clock bring-up"
	default n
	depends on ARCH_CHIP_BK7258
	select BK7258_DVFS
	---help---
		Deterministically bring the CPU0 core clock to the 320 MHz tier
		(DPLL /1.5, the highest board-verified operating point; CPU0
		effective 160 MHz on this single-core port -- see BK7258_DVFS)
		at boot.  The bootloader enables + calibrates the DPLL at the SDK
		default analog state; this option makes the app step the core up
		to the 320 MHz runtime tier via bk7258_dvfs_set_freq().  480 MHz
		direct is SDK-rejected and not attempted.

config BK7258_CLOCK_320M_PROBE
	bool "BK7258 320 MHz bring-up verification probe (uart evidence line)"
	default n
	depends on BK7258_CLOCK_320M
	---help---
		Re-add a one-shot freestanding UART evidence line after the 320 MHz
		bring-up showing M1/ANA_REG5/ANA_REG9 readback, for one
		verification build.  Disable after board-verify.

config BK7258_DVFS
	bool "BK7258 runtime CPU-frequency switching (DVFS lower half)"
	default n
	depends on ARCH_CHIP_BK7258
	---help---
		Provide bk7258_dvfs_set_freq(int tier) -- a standalone NuttX
		overlay DVFS lower half that mirrors the Armino SDK runtime
		sys_drv_switch_cpu_bus_freq / sys_hal_switch_cpu_bus_freq path
		(lift VDDD/VDDIG one tier at a time per the SDK operating-point
		table, then switch the core mux, then recompute the SysTick
		reload).  This is NOT the NuttX PM state machine: it follows the
		lc823450 DVFS precedent of a single chip-local set_freq() with no
		governor/HPWORK dependency.  Boot-time bring-up under
		BK7258_CLOCK_320M selects this; runtime switching via /proc/dvfs
		is available under BK7258_DVFS_PROCFS.

config BK7258_DVFS_PROCFS
	bool "BK7258 /proc/dvfs runtime DVFS control"
	default n
	depends on BK7258_DVFS
	select FS_PROCFS
	select FS_PROCFS_REGISTER
	---help---
		Register /proc/dvfs so the current CPU frequency tier can be
		queried (`cat /proc/dvfs`) and stepped at runtime
		(`echo "cur_freq 80" > /proc/dvfs`), exercising the full DVFS
		lower half from userspace.  Requires FS_PROCFS +
		FS_PROCFS_REGISTER (both selected here) for the procfs_register
		run-time registration API.

config BK7258_WDT
	bool "BK7258 APB watchdog (WDT) lower-half driver"
	default y
	depends on ARCH_CHIP_BK7258
	select WATCHDOG
	---help---
		Register /dev/watchdog0 backed by the BK7258 APB hardware
		watchdog.  Mirrors the Armino SDK WDT BSP
		(bk_wdt_driver_init / bk_wdt_start / bk_wdt_feed path).
		The bootloader arms the WDT during cold-init; this driver
		takes over after boot and feeds it via the NuttX watchdog
		upper-half automonitor (CONFIG_WATCHDOG_AUTOMONITOR).
		Default timeout 8 s (period=8000), matching the bootloader.

config BK7258_SDK_IRQ_BRIDGE
	bool "Beken SDK CPU0 interrupt bridge"
	default n
	depends on ARCH_CHIP_BK7258
	select ARCH_IRQPRIO
	---help---
		Route the Beken SDK interrupt registration APIs through the NuttX
		IRQ subsystem on CPU0.  SDK sources 0..63 map one-to-one to
		NuttX logical IRQs 16..79.  This option requires the A1 80-slot
		RAM-vector table and does not provide AP/CPU1/CPU2 SMP support.

config BK7258_SDK_IRQ_TIMER_TEST
	bool "Beken SDK IRQ bridge TIMER1 manual test"
	default n
	depends on BK7258_SDK_IRQ_BRIDGE && SYSTEM_NSH
	select BUILTIN
	select NSH_BUILTIN_APPS
	---help---
		Build the manual bkirqtest NSH command. The command temporarily
		replaces the SDK INT_SRC_TIMER callback, triggers TIMER_ID1,
		proves unregister silence and re-registration, then restores the
		original callback. It never runs from board bring-up.
