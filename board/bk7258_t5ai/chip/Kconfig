	int "N10 peer fault deadline (milliseconds)"
	default 2500
	range 500 60000
	depends on BK7258_AP_SUPERVISOR && !BK7258_AP_CORE

config BK7258_AP_HEALTH_PROBE_INTERVAL_MS
	int "N10 RPMsg health probe interval (milliseconds)"
	default 500
	range 100 10000
	depends on BK7258_AP_SUPERVISOR && !BK7258_AP_CORE

