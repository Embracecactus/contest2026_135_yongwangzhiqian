############################################################################
# contest2026_135_yongwangzhiqian/board/bk7258_t5ai/chip/Make.defs
#
# SPDX-License-Identifier: Apache-2.0
#
# Beken BK7258 (Cortex-M33) custom chip definitions for NuttX.
#
# The chip port has one root build entry and three implementation groups:
#
#   common/  sources used by both CP and the N7 AP-UP baseline
#   cp/      CPU0/CP-only startup, peripherals and SDK integration
#   ap/      physical CPU1 AP-UP startup and main path
#
# AP-SMP will add a separate source group without duplicating the root Kconfig,
# Make.defs or public include directory.
############################################################################

include armv8-m/Make.defs

# The arch Makefile already adds chip/ itself.  Add the role subdirectories for
# source lookup and chip-private quoted includes.

VPATH += chip$(DELIM)common
VPATH += chip$(DELIM)cp
VPATH += chip$(DELIM)ap

INCLUDES += ${INCDIR_PREFIX}$(ARCH_SRCDIR)$(DELIM)chip$(DELIM)common
INCLUDES += ${INCDIR_PREFIX}$(ARCH_SRCDIR)$(DELIM)chip$(DELIM)cp
INCLUDES += ${INCDIR_PREFIX}$(ARCH_SRCDIR)$(DELIM)chip$(DELIM)ap

# Beken SDK headers are kept separate for each firmware role.

ifeq ($(CONFIG_BK7258_AP_CORE),y)
BK7258_SDK_ROLE := ap
else
BK7258_SDK_ROLE := cp
endif

INCLUDES += ${INCDIR_PREFIX}$(BOARD_DIR)$(DELIM)bk_idk$(DELIM)armino_as_lib$(DELIM)$(BK7258_SDK_ROLE)$(DELIM)include
INCLUDES += ${INCDIR_PREFIX}$(BOARD_DIR)$(DELIM)bk_idk$(DELIM)armino_as_lib$(DELIM)$(BK7258_SDK_ROLE)$(DELIM)config

# Shared N7 sources.  lowputc/serial remain shared in this structural-only
# move: the current AP ELF still exports arm_lowputc()/up_putc(), so making
# them CP-only would change the verified AP baseline.

BK7258_COMMON_CSRCS  = bk7258_lowputc.c
BK7258_COMMON_CSRCS += bk7258_serial.c
BK7258_COMMON_CSRCS += bk7258_irq.c
BK7258_COMMON_CSRCS += bk7258_timerisr.c
BK7258_COMMON_CSRCS += bk7258_allocateheap.c
BK7258_COMMON_CSRCS += bk7258_os_adapt.c
BK7258_COMMON_CSRCS += bk7258_sdk_stubs.c

# CPU0/CP sources.  Preserve the pre-refactor source order so archive/link
# ordering and vector handler addresses remain unchanged.

BK7258_CP_CSRCS  = bk7258_vectors.c
BK7258_CP_CSRCS += bk7258_start.c
BK7258_CP_CSRCS += $(BK7258_COMMON_CSRCS)

ifeq ($(CONFIG_BK7258_AP_CONTROL),y)
BK7258_CP_CSRCS += bk7258_ap_control.c
endif

# Stage B: replace the SDK private CM33 callback table with NuttX irq_attach()
# ownership for SDK interrupt sources 0..63.

ifeq ($(CONFIG_BK7258_SDK_IRQ_BRIDGE),y)
BK7258_CP_CSRCS += bk7258_sdk_irq.c
endif

ifeq ($(CONFIG_BK7258_SDK_IRQ_TIMER_TEST),y)
BK7258_CP_CSRCS += bk7258_sdk_irq_timer_test.c
endif

ifeq ($(CONFIG_BK7258_GPIO_FOUNDATION_TEST),y)
BK7258_CP_CSRCS += bk7258_gpio_foundation_test.c
endif

ifeq ($(CONFIG_BK7258_GPIO_IRQ_TEST),y)
BK7258_CP_CSRCS += bk7258_gpio_irq_test.c
endif

ifeq ($(CONFIG_BK7258_GPIO_LOWERHALF),y)
BK7258_CP_CSRCS += bk7258_gpio_cp_irq.c
BK7258_CP_CSRCS += bk7258_gpio_lowerhalf.c
endif

# Stage N5-D6-A: on-chip flash data-partition MTD.  Default off so normal
# firmware is unchanged.

ifeq ($(CONFIG_BK7258_FLASH_MTD),y)
BK7258_CP_CSRCS += bk7258_flash_mtd.c
endif

# Stage N4-D1: deterministic 320 MHz CPU0 clock bring-up.

ifeq ($(CONFIG_BK7258_CLOCK_320M),y)
BK7258_CP_CSRCS += bk7258_clock.c
endif

# Compile the common Cortex-M SysTick lower half (arm_systick.c, which
# provides systick_initialize() used by bk7258_timerisr.c).  The shared
# arm_m/Make.defs gates this on CONFIG_ARM_M_SYSTICK, a symbol no Kconfig
# ever defines (a latent typo -- the real symbol is CONFIG_ARM_SYSTICK,
# which CONFIG_ARMV8M_SYSTICK selects).  VPATH already lists arm_m/, so
# referencing the file by basename resolves to arch/arm/src/arm_m/arm_systick.c
# without touching the upstream tree.

ifeq ($(CONFIG_ARM_SYSTICK),y)
BK7258_CP_CSRCS += arm_systick.c
endif

# Stage N4-D2: BK7258 DVFS lower half and optional procfs control.

ifeq ($(CONFIG_BK7258_DVFS),y)
BK7258_CP_CSRCS += bk7258_dvfs.c
endif

ifeq ($(CONFIG_BK7258_DVFS_PROCFS),y)
BK7258_CP_CSRCS += bk7258_dvfs_procfs.c
endif

# Stage B2: APB watchdog lower-half driver.  Takes over the bootloader's WDT
# after boot and registers /dev/watchdog0.  Default y.

ifeq ($(CONFIG_BK7258_WDT),y)
BK7258_CP_CSRCS += bk7258_wdt.c
endif

# Physical CPU1 runs the independently linked N7 AP-UP image.  ap_main was
# historically placed between allocateheap and os_adapt; keep that order for
# byte-identical AP output.

BK7258_AP_UP_CSRCS  = bk7258_ap_vectors.c
BK7258_AP_UP_CSRCS += bk7258_ap_start.c
BK7258_AP_UP_CSRCS += $(wordlist 1,5,$(BK7258_COMMON_CSRCS))
BK7258_AP_UP_CSRCS += bk7258_ap_main.c
BK7258_AP_UP_CSRCS += $(wordlist 6,7,$(BK7258_COMMON_CSRCS))

ifeq ($(CONFIG_ARM_SYSTICK),y)
BK7258_AP_UP_CSRCS += arm_systick.c
endif

ifeq ($(CONFIG_BK7258_AP_CORE),y)
CHIP_CSRCS = $(BK7258_AP_UP_CSRCS)
else
CHIP_CSRCS = $(BK7258_CP_CSRCS)
endif

# Disable FreeRTOS assumptions in SDK headers (reference: 7236N Make.defs:110-120)
CFLAGS += -DCONFIG_FREERTOS=0 -DCONFIG_FREERTOS_SMP=0
# NuttX automonitor owns watchdog keepalive; the wrapper stops SDK TIMER_ID2.
CFLAGS += -DCONFIG_INT_WDT=0 -DCONFIG_TASK_WDT=0 -DCONFIG_INT_AON_WDT=0
CFLAGS += -DCONFIG_SYSTEM_CTRL=1 -DCONFIG_NMI_WDT_EN=1
CFLAGS += -DCONFIG_DEBUG_VERSION=0 -DCONFIG_GPIO_RETENTION_SUPPORT=0
CFLAGS += -DCONFIG_AON_RTC=0 -DCONFIG_AON_RTC_64BIT=0
CFLAGS += -DCONFIG_SOC_BK7256XX=0 -DCONFIG_SOC_BK7236XX=0 -DCONFIG_SOC_BK7239XX=0

# CPU0 wraps the common dispatcher to enforce non-nested IRQ dispatch and
# retain the selected context across the STAR no-switch return path.  AP
# remains unchanged.

ifneq ($(CONFIG_BK7258_AP_CORE),y)
LDFLAGS += --wrap=arm_doirq --wrap=nxsched_resume_scheduler
endif

# Force the link entry point to our __start.  --build-id=none keeps the image
# deterministic and avoids build-id bytes shifting later sections.

LDFLAGS += --build-id=none --entry=__start
