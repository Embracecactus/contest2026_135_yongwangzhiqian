#
# NuttX Make.defs for Beken BK7258 (T5-AI) Stage N1 board.
#
# Classic Make backend (the same backend RV1126B used).  The CMake backend
# is intentionally not enabled for N1; see board CMakeLists.txt.
#

include $(TOPDIR)/.config
include $(TOPDIR)/tools/Config.mk
include $(BOARD_DIR)$(DELIM)bk_idk$(DELIM)sdk-bundles.mk

# Toolchain: arm-none-eabi-gcc on /usr/bin (probe-verified).

CROSSDEV = arm-none-eabi-

# Reuse the common ARMv8-M toolchain flags (sets -mcpu=cortex-m33,
# -march=armv8-m.main, -mfloat-abi, ...).  This matches what every other
# in-tree Cortex-M33 chip does.

include $(TOPDIR)/arch/arm/src/armv8-m/Toolchain.defs

# Linker script: FLASH @ 0x02010000, RAM @ 0x28000000, vector table KEEP-
# pinned at the flash origin so the BK7236 app magic lands at 0x100.

ifeq ($(CONFIG_BK7258_AP_CORE),y)
ARCHSCRIPT = $(BOARD_DIR)$(DELIM)scripts$(DELIM)ld_ap.script
BK7258_IMAGE_ROLE = ap
else
ARCHSCRIPT = $(BOARD_DIR)$(DELIM)scripts$(DELIM)ld.script
BK7258_IMAGE_ROLE = cp
endif

# Standard NuttX ARM flag assembly.

CFLAGS   := $(ARCHCFLAGS) $(ARCHOPTIMIZATION) $(ARCHCPUFLAGS) $(ARCHINCLUDES) $(ARCHDEFINES) $(EXTRAFLAGS)
CXXFLAGS := $(ARCHCXXFLAGS) $(ARCHOPTIMIZATION) $(ARCHCPUFLAGS) $(ARCHXXINCLUDES) $(ARCHDEFINES) $(EXTRAFLAGS)
CPICFLAGS = $(ARCHPICFLAGS) $(CFLAGS)
CXXPICFLAGS = $(ARCHPICFLAGS) $(CXXFLAGS)
CPPFLAGS := $(ARCHINCLUDES) $(ARCHDEFINES) $(EXTRAFLAGS)
AFLAGS := $(CFLAGS) -D__ASSEMBLY__

# NXFLAT module definitions (unused on this flat-build target but NuttX
# expects them to be defined).

NXFLATLDFLAGS1 = -r -d -warn-common
NXFLATLDFLAGS2 = $(NXFLATLDFLAGS1) -T$(TOPDIR)/binfmt/libnxflat/gnu-nxflat-pcrel.ld -no-check-sections
LDNXFLATFLAGS = -e main -s 2048

# ELF module definitions (same caveat).

LDELFFLAGS = -r -e main
LDELFFLAGS += -T $(call CONVERT_PATH,$(TOPDIR)/libs/libc/elf/gnu-elf.ld)

# Link Beken SDK prebuilt static libraries.
# libdriver.a contains all peripheral drivers (UART, flash, WDT, timer, etc.)

# Link Beken SDK prebuilt static libraries.
# Exclude: cmsis startup, coredump, unity, at_server, lwip, wpa_supplicant,
# iperf, hmac, psa_mbedtls, and duplicate bluetooth controller variants
# (only keep libbluetooth_controller.a, exclude *_ble_*, *_bt_*, *_dual_*).
# Unresolved symbols from other libs are stubbed in bk7258_sdk_stubs.c.

ifeq ($(CONFIG_BK7258_AP_CORE),y)

# The AP image links the AP-built peripheral archive only.  NuttX continues to
# own startup, scheduling and interrupt dispatch; SDK RTOS/startup archives are
# deliberately not linked.

BK_SDK_LIBS_DIR := $(shell readlink -f $(BK7258_SDK_BUNDLE_ROOT)/ap/libs)
ifeq ($(BK_SDK_LIBS_DIR),)
$(error BK7258 AP SDK bundle '$(BK7258_SDK_BUNDLE_VERSION)' has no libs directory)
endif
ifeq ($(CONFIG_BK7258_BT_IPC),y)
EXTRA_LIBS += $(BK_SDK_LIBS_DIR)/libbk_bluetooth.a
endif
EXTRA_LIBS += \
  $(BK_SDK_LIBS_DIR)/libdriver.a \
  $(BK_SDK_LIBS_DIR)/libbk7258_ap.a \
  $(BK_SDK_LIBS_DIR)/libbk_pm.a \
  $(BK_SDK_LIBS_DIR)/libbk_adapter.a \
  $(BK_SDK_LIBS_DIR)/libbk_common.a \
  $(BK_SDK_LIBS_DIR)/libcommon.a \
  $(BK_SDK_LIBS_DIR)/libbk_log.a \
  $(BK_SDK_LIBS_DIR)/libbk_event.a \
  $(BK_SDK_LIBS_DIR)/libcm33.a

else

BK_SDK_LIBS_DIR := $(shell readlink -f $(BK7258_SDK_BUNDLE_ROOT)/cp/libs)
ifeq ($(BK_SDK_LIBS_DIR),)
$(error BK7258 CP SDK bundle '$(BK7258_SDK_BUNDLE_VERSION)' has no libs directory)
endif

# Libraries to exclude (not needed for basic NuttX bring-up):
# - cmsis startup (conflicts with NuttX startup)
# - coredump, unity, at_server (testing/debug tools)
# - lwip, wpa_supplicant, wifi (networking, not needed yet)
# - iperf, hmac, psa_mbedtls (networking/crypto)
# - ALL bluetooth controller/host variants (duplicate symbols).  The BT IPC
#   profile adds only the controller-only BLE archive selected by the official
#   CP SDK build.
# - ble_wifi_exchange (wifi/bt coexistence)

BK_EXCLUDE_LIBS := \
  libcmsis.a libcoredump.a libunity.a libat_server.a \
  liblwip_intf_v2_1.a libwpa_supplicant-2.10.a \
  libiperf.a libhmac_sha_256.a libpsa_mbedtls.a \
  libwifi.a libwifi_csi.a libwifi_csi_nspe.a libwifi_nspe.a libbk_wifi.a \
  libble_wifi_exchange.a \
  libbluetooth_controller.a \
  libbluetooth_controller_ble.a \
  libbluetooth_controller_ble_cp_slave_observer.a \
  libbluetooth_controller_ble_cp_slave_observer_nspe.a \
  libbluetooth_controller_ble_cp_slave_only.a \
  libbluetooth_controller_ble_cp_slave_only_nspe.a \
  libbluetooth_controller_ble_nspe.a \
  libbluetooth_controller_ble_non_calibration.a \
  libbluetooth_controller_ble_non_calibration_nspe.a \
  libbluetooth_controller_ble_reduce.a \
  libbluetooth_controller_ble_reduce_nspe.a \
  libbluetooth_controller_ble_slave_only.a \
  libbluetooth_controller_ble_slave_only_nspe.a \
  libbluetooth_controller_bt.a \
  libbluetooth_controller_bt_nspe.a \
  libbluetooth_controller_controller_only_ble.a \
  libbluetooth_controller_controller_only_ble_nspe.a \
  libbluetooth_controller_controller_only_dual.a \
  libbluetooth_controller_controller_only_dual_nspe.a \
  libbluetooth_controller_dual.a \
  libbluetooth_controller_dual_nspe.a \
  libbluetooth_host_ble.a \
  libbluetooth_host_ble_only.a \
  libbluetooth_host_ble_reduce.a \
  libbluetooth_host_ble_slave_only.a \
  libbluetooth_host_dm.a \
  libbluetooth_host_dm_bt.a \
  libbluetooth_host_dm_dual.a \
  libbk_phy_nspe.a \
  libate_phy_nspe.a \
  libcom_phy_nspe.a \
  libcom_phy.a \
  libate_phy.a \
  libbk_rtos.a \
  libbk_system.a \
  libos_source.a

# Build the exclude list as full paths
BK_EXCLUDE_PATHS := $(foreach lib,$(BK_EXCLUDE_LIBS),$(BK_SDK_LIBS_DIR)/$(lib))

EXTRA_LIBS += $(filter-out $(BK_EXCLUDE_PATHS),$(wildcard $(BK_SDK_LIBS_DIR)/*.a))

# Match the official CP controller-only build instead of pulling the generic
# controller archive.  libcom_phy.a is the exported full PHY/calibration
# archive (the bundle's libbk_phy.a name is occupied by the SDK component
# archive).  The v3.1.1.9 PHY adapter was built with CONFIG_WIFI_ENABLE=y and
# its immutable function table consequently needs the Wi-Fi/lwIP archive
# closure.  These archives are linked as the PHY backend; the NuttX wrapper
# does not call the SDK Wi-Fi or lwIP startup paths.  SDK bk_system remains
# excluded because its FreeRTOS tick/printf runtime conflicts with the NuttX
# board adapters.  Keep the additions scoped to the BT IPC profile so the
# established CP baseline link remains unchanged.

ifeq ($(CONFIG_BK7258_BT_IPC),y)
EXTRA_LIBS += \
  $(BK_SDK_LIBS_DIR)/libbluetooth_controller_controller_only_ble.a \
  $(BK_SDK_LIBS_DIR)/libcom_phy.a \
  $(BK_SDK_LIBS_DIR)/libwifi.a \
  $(BK_SDK_LIBS_DIR)/libbk_wifi.a \
  $(BK_SDK_LIBS_DIR)/liblwip_intf_v2_1.a
endif

endif

# POSTBUILD: once nuttx.bin exists, CRC-expand it and prepend the Tier-1
# bootloader (bl_crc.bin) to produce all-app.bin, ready for flashing at
# physical offset 0x0.  The script is idempotent and safe to re-run.

define POSTBUILD
	$(Q) $(BOARD_DIR)$(DELIM)scripts$(DELIM)postbuild.sh $(TOPDIR) $(BOARD_DIR) $(BK7258_IMAGE_ROLE)
endef
