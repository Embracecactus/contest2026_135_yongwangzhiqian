/****************************************************************************
 * contest2026_135_yongwangzhiqian/board/bk7258_t5ai/scripts/ld_ap.script
 *
 * SPDX-License-Identifier: Apache-2.0
 *
 * Linker script for the physical CPU1 / AP logical-core-0 NuttX image.
 *
 *   FLASH : 0x02200000 .. 0x023fffff  (logical offset 0x00200000)
 *   RAM   : 0x28050000 .. 0x2809efff
 *   SHARED: 0x2809f000 .. 0x2809ffff  (not linked into this image)
 ****************************************************************************/

#include <nuttx/config.h>

OUTPUT_ARCH("arm")
EXTERN(_vectors)
EXTERN(__vector_core0_table)
EXTERN(__vector_core1_table)
EXTERN(bk7258_ap_main)
#ifdef CONFIG_BK7258_AP_IPI
EXTERN(bk_int_isr_register)
#endif
ENTRY(__start)

MEMORY
{
    FLASH (rx)  : ORIGIN = 0x02200000, LENGTH = 0x200000
#ifdef CONFIG_BK7258_RPTUN_LAYOUT
    RAM   (rwx) : ORIGIN = 0x28050000, LENGTH = 0x047000
#else
    RAM   (rwx) : ORIGIN = 0x28050000, LENGTH = 0x04f000
#endif
}

_bk7258_rptun_shmem_start = 0x28097000;
_bk7258_rptun_shmem_end = 0x2809f000;
_bk7258_rptun_control = 0x28097000;
_bk7258_rptun_resource = 0x28097040;
_bk7258_rptun_carveout_start = 0x28097180;
_bk7258_rptun_carveout_end = 0x2809f000;

_estack = ORIGIN(RAM) + LENGTH(RAM) - 4;

SECTIONS
{
    . = ORIGIN(FLASH);
    .vectors : ALIGN(4)
    {
        KEEP(*(.vectors_core0))
        KEEP(*(.vectors))
        . = ALIGN(4);
    } > FLASH

    ASSERT(__vector_core0_table == ORIGIN(FLASH),
           "ERROR: AP __vector_core0_table must be at 0x02200000")
    ASSERT(_vectors == __vector_core0_table,
           "ERROR: AP _vectors must alias __vector_core0_table")
    ASSERT(SIZEOF(.vectors) == 0x140,
           "ERROR: AP vector table must contain 80 entries")

    /* Physical CPU2 executes the AP-local logical-core-1 vector.  N8-A uses
     * it for the freestanding probe; N8-B1 uses it for secondary bootstrap.
     * Keep it in the same XIP image, independently 512-byte aligned.
     */

    . = ALIGN(512);
    .cpu2_vectors : ALIGN(4)
    {
        KEEP(*(.vectors_core1))
        . = ALIGN(4);
    } > FLASH

    ASSERT((__vector_core1_table & 0x1ff) == 0,
           "ERROR: CPU2 vector must be 512-byte aligned")
    ASSERT(SIZEOF(.cpu2_vectors) == 0x140,
           "ERROR: CPU2 vector must contain 80 entries")

    .text : ALIGN(4)
    {
        _stext = ABSOLUTE(.);
        *(.text .text.*)
        *(.fixup)
        *(.gnu.warning)
        *(.rodata .rodata.*)
        *(.gnu.linkonce.t.*)
        *(.glue_7)
        *(.glue_7t)
        *(.gcc_except_table)
        *(.gnu.linkonce.r.*)
        . = ALIGN(4);
        _etext = ABSOLUTE(.);
    } > FLASH

    .init_section : ALIGN(4)
    {
        _sinit = ABSOLUTE(.);
        KEEP(*(SORT_BY_INIT_PRIORITY(.init_array.*)
               SORT_BY_INIT_PRIORITY(.ctors.*)))
        KEEP(*(.init_array
               EXCLUDE_FILE(*crtbegin.o *crtbegin?.o *crtend.o *crtend?.o)
               .ctors))
        _einit = ABSOLUTE(.);
    } > FLASH

    .ARM.extab : ALIGN(4)
    {
        *(.ARM.extab*)
    } > FLASH

    .ARM.exidx : ALIGN(4)
    {
        __exidx_start = ABSOLUTE(.);
        *(.ARM.exidx*)
        __exidx_end = ABSOLUTE(.);
    } > FLASH

    .tdata : ALIGN(4)
    {
        _stdata = ABSOLUTE(.);
        *(.tdata .tdata.* .gnu.linkonce.td.*);
        _etdata = ABSOLUTE(.);
    } > FLASH

    .tbss : ALIGN(4)
    {
        _stbss = ABSOLUTE(.);
        *(.tbss .tbss.* .gnu.linkonce.tb.* .tcommon);
        _etbss = ABSOLUTE(.);
    } > FLASH

    _eronly = LOADADDR(.data);

    .irq_stack : ALIGN(4)
    {
        g_intstackalloc = ABSOLUTE(.);
        . += CONFIG_ARCH_INTERRUPTSTACK;
        g_intstacktop = ABSOLUTE(.);
    } > RAM

    .ram_vectors (NOLOAD) : ALIGN(512)
    {
        _sram_vectors = ABSOLUTE(.);
        KEEP(*(.ram_vectors))
        . = ALIGN(4);
        _eram_vectors = ABSOLUTE(.);
    } > RAM

    ASSERT((_sram_vectors & 0x1ff) == 0,
           "ERROR: AP .ram_vectors must be 512-byte aligned")
    ASSERT(_eram_vectors - _sram_vectors == 0x140,
           "ERROR: AP .ram_vectors must contain 80 entries")

    .data : ALIGN(4)
    {
        _sdata = ABSOLUTE(.);
        *(.data .data.*)
        *(.gnu.linkonce.d.*)
#ifdef CONFIG_BK7258_RPTUN_LAYOUT
        *(.swap_data)
        *(.dtcm_sec_data)
        /* The SDK emits SMP spinlocks with owner=SPIN_LOCK_FREE in this
         * section.  Preserve that FLASH initializer just like the official
         * BK7258 AP linker script; placing it in NOLOAD .bss turns the owner
         * into CPU0 and trips the first recursive-lock assertion.
         */

        *(.sram_spinlock_section)
#endif
        CONSTRUCTORS
        . = ALIGN(4);
        _edata = ABSOLUTE(.);
    } > RAM AT > FLASH

    .bss (NOLOAD) : ALIGN(4)
    {
        _sbss = ABSOLUTE(.);
        *(.bss .bss.*)
        *(.gnu.linkonce.b.*)
        *(COMMON)
        . = ALIGN(4);
        _ebss = ABSOLUTE(.);
    } > RAM

    . = ALIGN(16);
    _sheap = ABSOLUTE(.);

    /* Reserve the AP SRAM top for physical CPU2.  AP-UP preserves the N8-A
     * 1 KiB freestanding probe stack.  AP-SMP reserves one full architecture
     * interrupt stack for the N8-B1 secondary bootstrap; CPU2's future IDLE
     * stack is allocated independently by up_cpu_idlestack().
     */

    _bk7258_cpu2_probe_stack_top = ORIGIN(RAM) + LENGTH(RAM);
#ifdef CONFIG_BK7258_AP_SMP_BOOTSTRAP
    _bk7258_cpu2_probe_stack_base =
      _bk7258_cpu2_probe_stack_top - CONFIG_ARCH_INTERRUPTSTACK;
#else
    _bk7258_cpu2_probe_stack_base =
      _bk7258_cpu2_probe_stack_top - 0x400;
#endif
    _eheap = _bk7258_cpu2_probe_stack_base - 4;

#ifdef CONFIG_BK7258_RPTUN_LAYOUT
    ASSERT(_bk7258_cpu2_probe_stack_top == 0x28097000,
           "ERROR: N9 CPU2 boot stack must end at RPTUN shared memory")
    ASSERT(_bk7258_rptun_shmem_end == 0x2809f000,
           "ERROR: RPTUN shared memory overlaps telemetry")
    ASSERT(_bk7258_rptun_carveout_start == 0x28097180,
           "ERROR: RPTUN carveout ABI drift")
#else
    ASSERT(_bk7258_cpu2_probe_stack_top == 0x2809f000,
           "ERROR: CPU2 boot stack must end at the shared-page boundary")
#endif
    ASSERT(_ebss + CONFIG_IDLETHREAD_STACKSIZE <= _eheap,
           "ERROR: AP data/IDLE stack overlaps the CPU2 boot stack")
    ASSERT(LOADADDR(.data) + SIZEOF(.data) <=
           ORIGIN(FLASH) + LENGTH(FLASH),
           "ERROR: AP image exceeds the app1 flash partition")
    ASSERT(_eheap < _bk7258_cpu2_probe_stack_top,
           "ERROR: AP RAM overlaps the CPU2 boot stack")

    .stab              0 : { *(.stab) }
    .stabstr           0 : { *(.stabstr) }
    .stab.excl         0 : { *(.stab.excl) }
    .stab.exclstr      0 : { *(.stab.exclstr) }
    .stab.index        0 : { *(.stab.index) }
    .stab.indexstr     0 : { *(.stab.indexstr) }
    .comment           0 : { *(.comment) }
    .debug_abbrev      0 : { *(.debug_abbrev) }
    .debug_info        0 : { *(.debug_info) }
    .debug_line        0 : { *(.debug_line) }
    .debug_pubnames    0 : { *(.debug_pubnames) }
    .debug_aranges     0 : { *(.debug_aranges) }
}
