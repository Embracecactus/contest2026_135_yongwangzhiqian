Subject: [PATCH] avfilter/adevsink: drain EOF before requesting another frame

SPDX-License-Identifier: LGPL-2.1-or-later
Base: open-vela/external_ffmpeg 4b4723f2f66ccfdbadbd5d4c52dd5c41d6116418

The device sink must acknowledge an upstream terminal status before asking
for input again. Otherwise unlinking a streaming player requests a frame on
an EOF link and aborts the audio graph. Follow the status contract used by
the ALSA/video sinks and finish the existing encoder/device drain path.

--- a/libavfilter/asink_adevsink.c
+++ b/libavfilter/asink_adevsink.c
@@ -357,6 +357,18 @@
         }
     }
 
+    ff_inlink_acknowledge_status(inlink, &ret, &pts);
+    if (ret == AVERROR_EOF) {
+        if (!priv->started)
+            return 0;
+        ret = adevsink_send_frame(ctx, NULL);
+        return ret == AVERROR_EOF ? 0 : ret;
+    }
+    if (ret < 0) {
+        adevsink_stop(ctx);
+        return ret;
+    }
+
     ff_inlink_request_frame(inlink);
 
     return ret;
