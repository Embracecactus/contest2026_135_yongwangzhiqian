+            if (priv->playback) {
+                /* FINAL means the hardware consumed the tail. STOP joins the
+                 * lower-half worker and releases its stream resources before
+                 * the device reservation can be returned to another input. */
+                if (priv->running) {
+                    ret = ff_nuttx_ioctl(priv->fd, AUDIOIOC_STOP, 0);
+                    if (ret < 0 && !priv->completion_result)
+                        priv->completion_result = ret;
+                    priv->running = false;
+                }
+                priv->draining = false;
+                completed = true;
+            } else {
+                priv->draining = false;
+                if (priv->mq >= 0)
+                    ff_nuttx_ioctl(priv->fd, AUDIOIOC_UNREGISTERMQ, 0);
+                if (!priv->running) {
+                    ret = ff_nuttx_release(priv);
+                    if (ret < 0)
+                        return ret;
+                } else
+                    return AVERROR_EXIT;
+            }
         } else if (msg.msg_id == AUDIO_MSG_UNDERRUN) {
             av_log(priv, AV_LOG_WARNING, "[%s][%s] underflow! pause.\n", __func__, priv->devname);
             ff_nuttx_ioctl(priv->fd, AUDIOIOC_PAUSE, 0);
             priv->paused = true;
         } else if (msg.msg_id == AUDIO_MSG_IOERR) {
-            av_log(priv, AV_LOG_ERROR, "[%s][%s]io error occur\n", __func__, priv->devname);
+            av_log(priv, AV_LOG_ERROR, "[%s][%s]io error status:%d\n",
+                   __func__, priv->devname, msg.u.data);
             priv->ioerr = true;
+            if (!priv->completion_result)
+                priv->completion_result = AVERROR(EIO);
         }
 
         nonblock = true;
+    }
+
+    if (completed) {
+        int ret;
+        while (!dq_empty(&priv->bufferq)) {
+            buf_desc.u.buffer = (struct ap_buffer_s *)dq_remfirst(&priv->bufferq);
+            ff_nuttx_ioctl(priv->fd, AUDIOIOC_FREEBUFFER, &buf_desc);
+        }
+        ff_nuttx_ioctl(priv->fd, AUDIOIOC_UNREGISTERMQ, 0);
+        ret = ff_nuttx_release(priv);
+        if (ret < 0)
+            return ret; /* no release acknowledgement while still reserved */
+        return AVERROR_EXIT;
     }
 
     new = dq_count(&priv->bufferq);
