+}
+
+/* The graph thread owns these flags. Device callbacks only schedule another
+ * activation; never destroy the encoder from inside its control callback. */
+static void adevsink_release_event(AVFilterContext *ctx)
+{
+    ADevSinkPriv *priv = ctx->priv;
+    char result[24];
+
+    adevsink_stop(ctx);
+    priv->eof = priv->draining = priv->drained = false;
+    snprintf(result, sizeof(result), "%d", priv->terminal_result);
+    avfilter_forward_command(ctx, 0, "abufsrc", "output_released", result,
+                             NULL, 0, AVFILTER_CMD_FLAG_REVERSE);
+}
+
+static int adevsink_fail(AVFilterContext *ctx, int error)
+{
+    ADevSinkPriv *priv = ctx->priv;
+    if (!priv->wait_release)
+        return error;
+    if (!priv->terminal_result)
+        priv->terminal_result = error;
+    priv->eof = true;
+    ff_inlink_set_status(ctx->inputs[0], AVERROR_EOF);
+    /* STOP initiates the same device cleanup as normal completion. Its
+     * BUFFER_DRAINED acknowledgement is still required before unlink. */
+    if (priv->started)
+        adevsink_stop(ctx);
+    else
+        avformat_write_trailer(priv->fmt_ctx);
+    return 0;
 }
 
 static int adevsink_init_dict(AVFilterContext *ctx)
