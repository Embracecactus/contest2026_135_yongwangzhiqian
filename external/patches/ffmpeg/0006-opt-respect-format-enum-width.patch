Subject: [PATCH] avutil/opt: read format options using their enum types

SPDX-License-Identifier: LGPL-2.1-or-later
Base: open-vela/external_ffmpeg 4b4723f2f66ccfdbadbd5d4c52dd5c41d6116418

ARM short-enum builds use a one-byte AVSampleFormat. Reading or writing it
through int pointers overreads the source and overwrites adjacent caller
state. Use each public getter's declared enum type for both accesses,
matching the existing read_number/write_number format handling.

--- a/libavutil/opt.c
+++ b/libavutil/opt.c
@@ -1328,7 +1328,7 @@
     return av_opt_get_q(obj, name, search_flags, out_val);
 }
 
-static int get_format(void *obj, const char *name, int search_flags, int *out_fmt,
+static int get_format(void *obj, const char *name, int search_flags, void *out_fmt,
                       enum AVOptionType type, const char *desc)
 {
     void *dst, *target_obj;
@@ -1342,7 +1342,10 @@
     }
 
     dst = ((uint8_t*)target_obj) + o->offset;
-    *out_fmt = *(int *)dst;
+    if (type == AV_OPT_TYPE_PIXEL_FMT)
+        *(enum AVPixelFormat *)out_fmt = *(enum AVPixelFormat *)dst;
+    else
+        *(enum AVSampleFormat *)out_fmt = *(enum AVSampleFormat *)dst;
     return 0;
 }
 
