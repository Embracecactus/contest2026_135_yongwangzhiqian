# Build artifacts (see .gitignore.example)
build/
# Variant host-test output trees (make BUILD=build-<variant>).
/tests/host/bk7258/build-*/
!boards/bk7258/build/
!boards/bk7258/build/vendorsetup.sh
out/
*.o
*.a
*.elf
*.hex
*.map
*.bin
*.su
# Committed verification evidence keeps captured .su/.hex/.bin/.map bytes even
# though those types are build products elsewhere.
!/tests/host/bk7258/acceptance/**
!/docs/verification/**

# Operator-authorized private wake acknowledgement: 16 kHz mono PCM16LE.

# Local-authorization speech corpora and experiment candidates stay out of the
# published source tree.  Only these two experiment directories are ignored:
# the published models/*.tflite and *.metadata.json under models/, and the
# Android-side asset directories, remain trackable.
app/bk7258/models/datasets/
app/bk7258/models/candidates/

# Python cache
__pycache__/
*.pyc

# packer metadata output
bl_crc.json

# NuttX Make dependency files (generated in source dirs by the build)
.depend
*.dep

# NOTE: logs/ exported AI Coding logs MUST be committed (per .gitignore.example)

# Beken SDK local prerequisite bundle (proprietary/restricted prebuilts,
# not authorized for redistribution in this repo).
# Sibling tracked files under bk_idk/ (e.g. README.md) are NOT ignored.
chips/bk7258/bk_idk/armino_as_lib

# Content-addressed Arm GNU release installed by bk7258.py toolchain install.
prebuilt/*
!prebuilt/README.md

# NuttX dirlinks materializes the selected physical board below common.
boards/bk7258/common/board

# Local backup files
*.bak

# Local Tencent Cloud credentials are never repository inputs.
/docs/SecretKey.csv

# Local Alibaba Cloud credentials are never repository inputs.
/docs/aliyun.txt

# Finals defense decks, PDF exports and the organizer's official template are
# uploaded through the contest form, never committed.
/docs/*.pptx
/docs/*.pdf

# Local Claude Code state.
.claude/settings.local.json
