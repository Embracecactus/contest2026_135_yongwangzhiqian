<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- Local HIL gateways may use an operator-installed CA. Android applies
         these anchors only to debuggable builds; release builds continue to
         trust system roots exclusively. OkHttp still enforces the enrollment
         package's explicit SPKI pin. -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
