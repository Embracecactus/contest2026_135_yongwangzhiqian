<resources>
    <!-- Material roles resolve to the Shaniu tokens; values-night/colors.xml supplies dark. -->
    <style name="Theme.Shaniu" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/shaniu_ink</item>
        <item name="colorOnPrimary">@color/shaniu_on_accent</item>
        <item name="colorSecondaryContainer">@color/shaniu_selected</item>
        <item name="colorOnSecondaryContainer">@color/shaniu_ink</item>
        <item name="colorSurface">@color/shaniu_surface</item>
        <item name="colorOnSurface">@color/shaniu_ink</item>
        <item name="colorOnSurfaceVariant">@color/shaniu_muted</item>
        <item name="colorOutline">@color/shaniu_outline</item>
        <item name="colorError">@color/shaniu_danger</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/shaniu_ink</item>
        <item name="android:windowBackground">@color/shaniu_background</item>
        <item name="android:navigationBarColor">@color/shaniu_background</item>
    </style>

    <style name="ShaniuSheetAnimation">
        <item name="android:windowEnterAnimation">@anim/sheet_enter</item>
        <item name="android:windowExitAnimation">@anim/sheet_exit</item>
    </style>
</resources>
