<!-- System response to a dismissal: snap away with ease-out, never ease-in. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_cubic">
    <translate android:duration="180" android:fromYDelta="0" android:toYDelta="100%" />
</set>
