{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema": "bk7258.build-plan/1",
  "kind": "build-plan-schema",
  "version": 1,
  "strict": {
    "duplicate_keys": "reject",
    "unknown_keys": "reject",
    "board_selection": "exactly-one",
    "role_paths": "unique",
    "real_build": "not-invoked",
    "standard_artifact_contract": {
      "cp": "vela_nuttx_cp.bin",
      "ap": "vela_nuttx_ap.bin",
      "manifest": "vela_nuttx_manifest.json",
      "internal_role_inputs": ["app.bin", "app1.bin"]
    }
  },
  "roles": ["bl1", "bl2", "cp", "ap"],
  "documents": {
    "resolved-role-config": {
      "additional_properties": false,
      "required": [
        "schema",
        "kind",
        "version",
        "ir_identity_sha256",
        "inputs",
        "partition_layout",
        "symbols",
        "defconfig",
        "defconfig_sha256",
        "identity_sha256"
      ]
    },
    "isolated-build-plan": {
      "additional_properties": false,
      "required": [
        "schema",
        "kind",
        "version",
        "active_roles",
        "bl2_image_logical_size",
        "identity_inputs",
        "board",
        "partition_layout",
        "sdk",
        "source_views",
        "roles",
        "legacy_adapter",
        "identity_sha256"
      ],
      "active_roles": {
        "mcuboot": ["bl1", "bl2", "cp", "ap"],
        "raw": ["bl1", "cp", "ap"]
      },
      "bl2_image_logical_size": {
        "mcuboot": "0x3000 board-owned compile-time image window",
        "raw": null
      },
      "role_fields": [
        "activation",
        "applicability"
      ],
      "identity_inputs": [
        "bl2_image_logical_size"
      ],
      "legacy_adapter": {
        "seed_profiles": {
          "roles": ["cp", "ap"],
          "fields": [
            "seed_profile",
            "source",
            "profile_sha256",
            "defconfig_sha256",
            "materialized_profile_sha256",
            "materialized_defconfig_sha256",
            "overlay",
            "overlay_sha256",
            "target_profile",
            "compat",
            "sdk_bundle"
          ]
        }
      }
    }
  }
}
