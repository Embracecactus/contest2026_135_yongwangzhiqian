{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema": "bk7258.shadow/1",
  "kind": "legacy-profile-shadow-schema",
  "version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kind",
    "version",
    "status",
    "source_manifest",
    "source_manifest_sha256",
    "source_migration_ledger",
    "source_migration_ledger_sha256",
    "profile_count",
    "statuses",
    "rows",
    "identity_sha256"
  ],
  "properties": {
    "schema": {"const": "bk7258.shadow/1"},
    "kind": {"const": "legacy-profile-shadow-ledger"},
    "version": {"const": 1},
    "status": {"const": "shadow-only"},
    "source_manifest": {"const": "tools/bk7258/legacy_profile_freeze_manifest.json"},
    "source_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_migration_ledger": {"const": "tools/bk7258/legacy_profile_migration_ledger.json"},
    "source_migration_ledger_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "profile_count": {"const": 27},
    "statuses": {
      "const": ["EXACT", "EQUIVALENT_WITH_REASON", "MIGRATION_PENDING", "RETIRE_PROPOSED"]
    },
    "rows": {
      "type": "array",
      "minItems": 27,
      "maxItems": 27,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "legacy_profile",
          "family",
          "resource_mode",
          "validation_suite",
          "target_product",
          "target_role",
          "status",
          "rationale"
        ],
        "properties": {
          "legacy_profile": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
          "family": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
          "resource_mode": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
          "validation_suite": {"type": ["string", "null"]},
          "target_product": {"type": ["string", "null"]},
          "target_role": {"enum": ["cp", "ap", "bl2"]},
          "status": {"enum": ["EXACT", "EQUIVALENT_WITH_REASON", "MIGRATION_PENDING", "RETIRE_PROPOSED"]},
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    },
    "identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "strict": {
    "profile_coverage": "all-27-frozen-profiles",
    "non_exact_requires": "rationale",
    "claim_policy": "no-fake-green",
    "source_policy": "manifest-and-migration-ledger-digests"
  }
}
