if BK7258_APP_AGENT

config BK7258_PREFERENCES
	bool "BKVoice KVDB product preferences"
	default n
	depends on KVDB && KVDB_DIRECT && KVDB_UNQLITE && FS_FAT
	help
		Store non-secret desired volume and persona through the public KVDB
		API, serialized by the AP voice owner. The CP bkvoice prefs command
		uses the existing voice endpoint. Each PTT reply applies the stored
		volume through public media policy before playback; changes take effect
		on the next reply. Direct cloud dialogue reads the stored persona for
		each request; the historical Gateway personality path is separate.
		Playback reuses the last confirmed volume without accessing storage.
		First use and explicit preference queries load/refresh it; uncertain
		write or cleanup results invalidate it and require a new read.
		The board must separately configure and
		validate its KVDB service/backend, missing-key errno and persistent
		partition before enabling this option. No credentials are stored.
		The database path must be one file immediately under /mnt/sdnand.
		Each operation leases the shared media, mounts FAT and unmounts
		before release. Busy media and cleanup failures are reported.

config BK7258_PREFERENCES_BLOCKDEV
	string "Preference database block device"
	depends on BK7258_PREFERENCES
	default "/dev/mmcsd0"
	help
		Must refer to the same SD NAND managed by the media/USB MSC lease.

config BK7258_VOICE_VOLUME_PERSISTENCE
	bool "Persist remote BKVoice volume on CP LittleFS"
	default n
	depends on BK7258_PROVISION_GATT && BK7258_RPMSGFS
	help
		Persist only the device playback volume in the CP-owned on-chip
		LittleFS. AP reaches the store through RPMsgFS. The setting uses the
		existing hash, revision, fsync and rename transaction contract in a
		directory separate from provisioning identity and network data.
		Startup performs no filesystem I/O and never mounts or formats storage.
		A remote set is reported successful only after durable publication and
		media-policy readback. When BK7258_PREFERENCES is enabled, its volume
		accessors delegate to this same store; persona keeps its existing KVDB
		backend. There is no second stored volume value in the product path.

config BK7258_VOICE_OTA_PERSISTENCE
	bool "Persist Shaniu authenticated OTA intent on CP LittleFS"
	default n
	depends on BK7258_VOICE_TLS && BK7258_PROVISION_GATT && BK7258_RPMSGFS
	depends on BK7258_OTA_MANAGER && BK7258_OTA_SOURCE_HTTP
	depends on BK7258_OTA_RPMSG
	help
		Persist one device-bound OTA manifest and its verified source/target
		pair identity before download, reboot and trial side effects. The AP
		voice owner resumes only the same manifest after disconnect or reboot;
		CP remains the pair installer, reset owner and health confirmation
		owner. Startup performs no filesystem I/O and never formats storage.

config BK7258_PROVISION_GATT
	bool "Shaniu product provisioning GATT transport"
	default n
	depends on BK7258_AP_CORE && BK7258_BT_IPC && WIRELESS_BLUETOOTH_HOST
	depends on !BK7258_BLE_GATT && BK7258_WIFI_VNET
	depends on NETUTILS_NTPCLIENT && !NETUTILS_NTPCLIENT_STAY_ON
	depends on SCHED_HAVE_PARENT && SCHED_CHILD_STATUS && SCHED_WAITPID
	depends on NETDB_DNSCLIENT
	depends on CRYPTO_MBEDTLS
	depends on BK7258_VOICE_TLS
	depends on MBEDTLS_SSL_SRV_C && MBEDTLS_KEY_EXCHANGE_ECDHE_ECDSA_ENABLED
	depends on MBEDTLS_GCM_C
	select BK7258_AP_APPLICATION_LIFECYCLE
	help
		Build the complete product GAP/GATT table and bounded ciphertext
		queue and TLS 1.2 server using the Bluetooth Host lifecycle and
		notification result interfaces from the selected official baseline,
		plus mbedTLS ECDHE-ECDSA server support.
		Registers the product table after Host startup. The product owner
		opens a bounded first-claim window only for an authenticated local
		identity with confirmed empty ownership storage. Existing bindings
		and recovery protections remain enforced; no PTT press is required.

config BK7258_VOICE_KWS
	bool "BKVoice official wake-word inference library"
	default n
	depends on TFLITEMICRO && HAVE_CXX && !DISABLE_PTHREAD
	help
		Build the official TFLM microfrontend and INT8 model runner for the
		product nihao_openvela model. Selecting this option alone does not
		enable background listening.
		A trained, authenticated model and AP audio-owner integration with
		pre-roll/VAD and physical acceptance are required before enabling
		wake-word interaction.

config BK7258_VOICE_KWS_MODEL_PATH
	string "Authenticated wake-word model path"
	default ""
	depends on BK7258_VOICE_KWS
	help
		Absolute path fixed into the signed AP firmware. The application does
		not mount storage or download a model; unavailable files disable the
		listener without acquiring the microphone.

config BK7258_VOICE_KWS_MODEL_SHA256
	string "Wake-word model SHA-256"
	default ""
	depends on BK7258_VOICE_KWS
	help
		Exactly 64 hexadecimal characters fixed into the signed AP firmware.

config BK7258_VOICE_KWS_ARENA_BYTES
	int "Wake-word tensor arena bytes"
	default 262144
	range 16384 524288
	depends on BK7258_VOICE_KWS

config BK7258_VOICE_TLS
	bool "BKVoice verified mTLS provider"
	default n
	depends on NET_TCP && CRYPTO_MBEDTLS
	select MBEDTLS_HAVE_TIME_DATE
	select NETUTILS_CJSON
	select NETUTILS_WEBCLIENT
	help
		Build the bounded, interruptible verified-TLS provider used by the
		selected cloud ASR/TTS protocol adapters. The deployment supplies
		server trust and an authoritative trusted-time check.

endif

config BK7258_HEALTH_SERVICE
	bool "BK7258 AP Shaniu device-health service"
	default n
	depends on BK7258_AP_CORE && BK7258_RPTUN
	depends on BATTERY_CHARGER && BK7258_TEMPERATURE
	select BK7258_AP_APPLICATION_LIFECYCLE
	help
		Start the AP-resident endpoint used by bkhealth.  The service reads the
		public battery-charger ABI and the public BK7258 temperature API from a
		dedicated worker, never from an RPMsg callback.  It exposes raw battery
		millivolts and temperature ADC data with per-field validity.  Celsius is
		reported only when the device has a valid per-chip temperature
		calibration.  The worker also refreshes a non-blocking AP product cache;
		state of charge remains unavailable until the product cell curve is
		characterized.

if BK7258_HEALTH_SERVICE

config BK7258_HEALTH_BATTERY_DEVPATH
	string "BKHealth battery device path"
	default "/dev/bat0"

config BK7258_HEALTH_RPC_PRIORITY
	int "BKHealth RPMsg worker priority"
	default 80
	range 1 255

config BK7258_HEALTH_RPC_STACKSIZE
	int "BKHealth RPMsg worker stack size"
	default 4096
	range 2048 32768

endif

