#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

# Each user-visible NSH command has its own application Kconfig.  The
# underlying driver/feature symbols must never register an application;
# CMake and Classic Make register commands only from CONFIG_BK7258_APP_*.

config BK7258_APP_AGENT
	bool "Start the official openvela Agent on the BK7258 AP"
	default y if EXAMPLES_AI_AGENT_VELA
	depends on BK7258_AP_CORE && EXAMPLES_AI_AGENT_VELA
	depends on !AI_AGENT_LVGL_UI || BK7258_BOARD_HAS_LVGL_UI_BINDING
	select BK7258_AP_APPLICATION_LIFECYCLE
	help
		Bind the official Agent package to the generic BK7258 AP application
		lifecycle. Product startup and service backends live in this application
		directory; chip and board code remain
		independent of the Agent product.

config BK7258_PRODUCT_KEYS
	bool "Product keys through /dev/buttons"
	default n
	depends on BK7258_APP_AGENT
	depends on BK7258_RPTUN && !DISABLE_PTHREAD
	help
		Use the standard buttons lower-half instead of the diagnostic GPIO PTT
		device. Bit 0 is volume down, bit 1 is power, and bit 2 is volume up.
		The AP accepts only the product-key RPMsg contract. When
		BK7258_PM_SOFT_OFF is enabled, a three-second K2-only hold followed by
		full release requests the CP-owned whole-chip reset-to-sleep path after
		bounded AP resource cleanup. When USB mode is built, shutdown also holds
		the shared block-device lease so an active MSC export rejects the request.
		Without the PM option the request reports ENOTSUP.

config BK7258_APP_DISPLAY
	bool "BK7258 Shaniu display command (bkdisplay)"
	default n
	depends on !BK7258_AP_CORE && BK7258_RPTUN && SYSTEM_NSH
	select BUILTIN
	select NSH_BUILTIN_APPS
	help
		Build the CP-visible bkdisplay status/mood command.  It uses a
		versioned application RPMsg endpoint to reach the AP-owned display
		service; CP never mounts /dev/mmcsd0 or writes a framebuffer.

