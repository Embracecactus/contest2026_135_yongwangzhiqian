config BK7258_VISION_SERVICE
	bool "BK7258 AP camera snapshot and local recording service"
	default n
	depends on BK7258_AP_CORE && BK7258_RPTUN && BK7258_AIDK_CAMERA
	depends on !SYSTEM_NXCAMERA && !EXAMPLES_CAMERA
	select BK7258_AP_APPLICATION_LIFECYCLE
	help
		Start the AP-resident endpoint used by bkvision.  Each request opens
		the configured V4L2 capture device, obtains one driver-managed MMAP
		buffer, validates the JPEG boundaries, stops capture, and closes the
		device so the sole-owner close releases the device-global buffer heap.
		Snapshot returns metadata only. Explicit record requests keep a FIFO
		of MMAP buffers queued and save silent MJPEG AVI to an existing FAT
		volume on /dev/mmcsd0. Recording never formats the volume and is
		bounded to 60 seconds and 64 MiB per file. USB MSC must be inactive.
		The service must remain the sole application owner of the configured
		V4L2 device because the current NuttX capture buffers are device-global.

if BK7258_VISION_SERVICE

config BK7258_VISION_DEVPATH
	string "BKVision V4L2 capture device"
	default "/dev/video0"

config BK7258_VISION_WIDTH
	int "BKVision snapshot width"
	default 640
	range 1 4096

config BK7258_VISION_HEIGHT
	int "BKVision snapshot height"
	default 480
	range 1 4096

config BK7258_VISION_FPS
	int "BKVision requested capture frame rate"
	default 30
	range 1 30
	help
		Request this rate with VIDIOC_S_PARM and verify VIDIOC_G_PARM before
		queuing capture buffers. The sensor must support the selected rate;
		unsupported requests fail instead of silently using another rate.

config BK7258_VISION_JPEG_BUFFER_BYTES
	int "BKVision maximum JPEG buffer size"
	default 102400
	range 4096 1048576
	help
		Maximum compressed-frame allocation requested through V4L2.  The
		AIDK GC2145/DVP profile uses the SDK's 102400-byte JPEG frame size.
		The value must be reviewed together with any camera profile change.

config BK7258_VISION_RECORD_BUFFERS
	int "BKVision continuous capture buffer count"
	default 8 if VIDEO_REQBUFS_COUNT_MAX >= 8
	default 3
	range 3 VIDEO_REQBUFS_COUNT_MAX
	help
		Number of V4L2 MMAP buffers queued in FIFO mode during recording
		or capture measurement. Additional buffers absorb storage latency
		while the application holds a dequeued frame until its write ends.
		Eight VGA JPEG buffers consume about 800 KiB of the AIDK encode
		heap, in addition to the two transport buffers. Review the memory
		budget when changing the frame size or running another encoder.

config BK7258_VISION_CAPTURE_TIMEOUT_MS
	int "BKVision snapshot timeout in milliseconds"
	default 3000
	range 100 30000

config BK7258_VISION_RPC_PRIORITY
	int "BKVision RPMsg worker priority"
	default 80
	range 1 255

config BK7258_VISION_RPC_STACKSIZE
	int "BKVision RPMsg worker stack size"
	default 6144
	range 2048 32768

endif

config BK7258_DISPLAY_SERVICE
	bool "BK7258 AP Shaniu dual-eye display service"
	default n
	depends on BK7258_AP_CORE && BK7258_AIDK_DUAL_LCD && BK7258_SDIO
	depends on (BK7258_USBMODE || BK7258_OTA_SOURCE_USB) && FS_FAT && FAT_LFN && FB_UPDATE
	depends on !AI_AGENT_LVGL_UI
	select BK7258_AP_APPLICATION_LIFECYCLE
	help
		Load versioned shaniu-eye-pack-v1 resources from the soldered SD NAND
		exposed as /dev/mmcsd0 and render logical expressions to the two AIDK
		GC9D01 framebuffers.  When dynamic USB MSC is selected, the volume is
		mounted only while holding its block-device lease.  When native USB is
		dedicated to signed OTA, no host block-device owner exists and the
		display service serializes its own short-lived mounts.  FAT long-file-name
		support is required by active.json and the
		versioned .bkep names.  A fully verified staging pack is renamed into packs before an
		fsync-and-rename active marker update.  On first boot, a missing marker
		falls back only to shaniu-default-v1.bkep.  Physical left/right mapping
		is deliberately unverified: shared neutral content is initially painted
		identically to /dev/fb0 and /dev/fb1.

if BK7258_DISPLAY_SERVICE

config BK7258_DISPLAY_BLOCKDEV
	string "BKDisplay asset block device"
	default "/dev/mmcsd0"
	help
		Block device containing the versioned eye asset packs.  A board using
		dynamic USB MSC must keep this equal to BK7258_USBMODE_BLOCKDEV.

config BK7258_DISPLAY_SERVICE_PRIORITY
	int "BKDisplay initialization worker priority"
	default 75
	range 1 255

config BK7258_DISPLAY_SERVICE_STACKSIZE
	int "BKDisplay initialization worker stack size"
	default 6144
	range 2048 32768

config BK7258_DISPLAY_RPC_PRIORITY
	int "BKDisplay RPMsg worker priority"
	default 80
	range 1 255

config BK7258_DISPLAY_RPC_STACKSIZE
	int "BKDisplay RPMsg worker stack size"
	default 6144
	range 2048 32768

config BK7258_DISPLAY_DEVICE_TIMEOUT_MS
	int "BKDisplay deferred device wait timeout in milliseconds"
	default 20000
	range 1000 120000

endif

