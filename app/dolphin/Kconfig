config DOLPHIN
	bool "Dolphin command directory"
	default n
	depends on NSH_BUILTIN_APPS && SCHED_WAITPID
	help
		Build the dolphin command directory.  It launches only a fixed set
		of already-built BK7258 command applications; it adds no driver,
		network, or RPC implementation.

if DOLPHIN

config DOLPHIN_STACKSIZE
	int "Dolphin stack size"
	default 4096

endif

config DOLPHIN_FILE_COPY
	bool "Dolphin SD to USB file copy backend"
	default n
	depends on DOLPHIN_UI
	help
		Build the controlled single-file copy backend. It performs no mount,
		format, USB class, or user-interface operation.

config DOLPHIN_STORAGE_ROOT
	string "Dolphin removable storage root"
	default "/mnt/tf"
	depends on DOLPHIN_UI || DOLPHIN_FILE_COPY

if DOLPHIN_FILE_COPY

config DOLPHIN_USB_ROOT
	string "Dolphin USB storage root"
	default "/mnt/usb"

endif

config DOLPHIN_UI
	bool "Dolphin touchscreen desktop"
	default n
	depends on BK7258_AP_CORE && GRAPHICS_LVGL && LV_USE_NUTTX
	depends on LV_USE_NUTTX_TOUCHSCREEN && VIDEO_FB && INPUT_TOUCHSCREEN && NET
	depends on !BK7258_BOARD_HAS_LVGL_UI_BINDING && !BK7258_DISPLAY_SERVICE
	select BK7258_AP_APPLICATION_LIFECYCLE
	help
		Run the local Dolphin desktop on the AP-owned NuttX framebuffer
		and touchscreen. Reuse standard VFS and network status APIs; no
		SDK dependency, cloud provisioning or NFC hardware is assumed.

if DOLPHIN_UI

config DOLPHIN_UI_STACKSIZE
	int "Dolphin UI stack size"
	default 16384
	range 8192 65536

config DOLPHIN_RECORDER
	bool "Dolphin WAV recorder"
	default n
	depends on DOLPHIN_UI && BK7258_MIC && !MEDIA
	help
		Record a user-started 16 kHz, 16-bit mono WAV file to removable
		storage through the existing NuttX audio upper-half adapter.
		This standalone recorder does not start Agent or the Media service.

config DOLPHIN_ADC_KEY
	bool "Dolphin ADC single key"
	default n
	depends on DOLPHIN_UI && ADC

if DOLPHIN_ADC_KEY
config DOLPHIN_ADC_KEY_DEVPATH
	string "ADC device path"
	default "/dev/adc0"
config DOLPHIN_ADC_KEY_CHANNEL
	int "ADC channel"
	default 14
config DOLPHIN_ADC_KEY_RELEASE_MIN
	int "Calibrated released raw minimum"
	default 0
	# Zero deliberately disables input until the board owner supplies a raw gate.
config DOLPHIN_ADC_KEY_ACTIVE_LOW
	bool "Pressed level is lower than released level"
	default y
endif

endif
