config BK7258_APP_GPIO_TEST
	bool "BK7258 selected-board GPIO foundation test command"
	default n
	depends on ARCH_CHIP_BK7258 && SYSTEM_NSH && !BK7258_AP_CORE
	depends on BK7258_BOARD_HAS_USER_GPIO_BINDING
	select BK7258_GPIO_FOUNDATION_TEST
	select BUILTIN
	select NSH_BUILTIN_APPS
	---help---
		Enable the manual bkgpioc0 NSH command.  The board GPIO binding is
		owned by the selected board and is enabled independently of this
		command.

if BK7258_APP_GPIO_TEST

config BK7258_APP_GPIO_TEST_PROGNAME
	string "bkgpioc0 program name"
	default "bkgpioc0"

config BK7258_APP_GPIO_TEST_PRIORITY
	int "bkgpioc0 priority"
	default 100

config BK7258_APP_GPIO_TEST_STACKSIZE
	int "bkgpioc0 stack size"
	default 2048

endif

config BK7258_APP_GPIO_IRQ_TEST
	bool "BK7258 selected-board key GPIO edge IRQ test command"
	default n
	depends on BK7258_SDK_IRQ_BRIDGE && SYSTEM_NSH
	depends on BK7258_BOARD_HAS_USER_GPIO_BINDING
	select BK7258_GPIO_IRQ_TEST
	select BUILTIN
	select NSH_BUILTIN_APPS
	---help---
		Enable the manual bkgpioirq NSH command.  The SDK IRQ bridge and
		board GPIO binding are driver features enabled independently of
		this command.

