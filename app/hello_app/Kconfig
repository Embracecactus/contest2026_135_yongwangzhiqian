config LVX_USE_DEMO_CONTEST2026_135_HELLO_APP
	bool "Contest 2026 team 135 hello app"
	default n
	---help---
		Enable the contest 2026 team 135 hello app demo.

config BK7258_BKVALIDATE
	bool "BK7258 public-API validation dispatcher"
	default n
	---help---
		Build the metadata-driven bkvalidate list/run/all-compatible dispatcher.
		The dispatcher uses public device APIs or versioned diagnostic records and
		never calls vendor SDK entry points.  Generic JPEG and temperature
		validation start only through their explicit run commands.
