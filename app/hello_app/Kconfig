#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

# Each user-visible NSH command has its own application Kconfig.  The
# underlying driver/feature symbols must never register an application;
# CMake and Classic Make register commands only from CONFIG_BK7258_APP_*.

config BK7258_APP_HELLO
	bool "Contest 2026 team 135 hello app"
	default n
	depends on SYSTEM_NSH
	select BUILTIN
	select NSH_BUILTIN_APPS
	---help---
		Enable the contest 2026 team 135 hello app demo.

if BK7258_APP_HELLO

config BK7258_APP_HELLO_PROGNAME
	string "hello app program name"
	default "hello_app"

config BK7258_APP_HELLO_PRIORITY
	int "hello app priority"
	default 100

config BK7258_APP_HELLO_STACKSIZE
	int "hello app stack size"
	default 2048

endif

config BK7258_APP_BKVALIDATE
	bool "BK7258 public-API validation dispatcher"
	default n
	depends on SYSTEM_NSH
	select BUILTIN
	select NSH_BUILTIN_APPS
	---help---
		Build the metadata-driven bkvalidate list/run/all-compatible dispatcher.
		The dispatcher uses public device APIs or versioned diagnostic records and
		never calls vendor SDK entry points.  Generic JPEG and temperature
		validation start only through their explicit run commands.

if BK7258_APP_BKVALIDATE

config BK7258_APP_BKVALIDATE_PROGNAME
	string "bkvalidate program name"
	default "bkvalidate"

config BK7258_APP_BKVALIDATE_PRIORITY
	int "bkvalidate priority"
	default 100

config BK7258_APP_BKVALIDATE_STACKSIZE
	int "bkvalidate stack size"
	default 3072

endif

config BK7258_APP_APCTL
	bool "BK7258 AP start/stop/restart command (apctl)"
	default n
	depends on BK7258_AP_CONTROL
	select BUILTIN
	select NSH_BUILTIN_APPS
	---help---
		Enable the manual apctl NSH command for the CPU0 AP control
		wrapper.  The wrapper itself is a driver feature owned by
		BK7258_AP_CONTROL and may run with the command disabled.

if BK7258_APP_APCTL

config BK7258_APP_APCTL_PROGNAME
	string "apctl program name"
	default "apctl"

config BK7258_APP_APCTL_PRIORITY
	int "apctl priority"
	default 100

config BK7258_APP_APCTL_STACKSIZE
	int "apctl stack size"
	default 2048

endif

