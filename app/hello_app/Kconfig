	default n
	depends on BK7258_RPMSG_TEST && !BK7258_AP_CORE && SYSTEM_NSH
	select BUILTIN
	select NSH_BUILTIN_APPS
	---help---
		Enable the CP-side bkrpmsgtest NSH command.  The RPMsg test
		endpoint is owned by BK7258_RPMSG_TEST and is enabled
		independently of this command.

