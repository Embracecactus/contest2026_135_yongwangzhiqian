# SPDX-License-Identifier: Apache-2.0
#
# Local build selector for the unchanged upstream GT9xx driver.

config INPUT_GT9XX_STANDARD_IOCTL
	bool "Goodix GT9xx driver (legacy BK7258 selector)"
	default n
	select INPUT_TOUCHSCREEN
	help
		Compile the official Goodix GT9xx input driver through the BK7258
		build integration. This legacy selector does not add ioctls: the
		driver returns single-point touch samples without TSIOC_GETMAXPOINTS.
		Do not enable it with INPUT_GT9XX, which builds the same driver.

if INPUT_GT9XX_STANDARD_IOCTL

config INPUT_GT9XX_STANDARD_IOCTL_NPOLLWAITERS
	int "Number of waiters to poll"
	default 1
	help
		Maximum number of threads that can be waiting on poll().

config INPUT_GT9XX_STANDARD_IOCTL_I2C_FREQUENCY
	int "I2C frequency (Hz)"
	default 400000
	help
		I2C frequency in Hz.

endif # INPUT_GT9XX_STANDARD_IOCTL
