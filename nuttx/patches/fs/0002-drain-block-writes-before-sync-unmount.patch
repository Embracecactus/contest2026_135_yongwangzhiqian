Subject: [PATCH] fat: drain deferred block writes before sync and unmount

SPDX-License-Identifier: Apache-2.0
Base: OpenVela NuttX 76354c637858ecb0aa4601629327acb6f44a26bb + fs/0001

--- a/fs/fat/fs_fat32.c
+++ b/fs/fat/fs_fat32.c
@@ -41,6 +41,7 @@
 
 #include <nuttx/kmalloc.h>
 #include <nuttx/fs/fs.h>
+#include <nuttx/fs/ioctl.h>
 #include <nuttx/fs/fat.h>
 
 #include "inode/inode.h"
@@ -1500,6 +1501,21 @@
        */
 
       ret          = fat_updatefsinfo(fs);
+    }
+
+  /* Metadata writes may finish at the controller before the card finishes
+   * programming. Complete that pending write before acknowledging fsync.
+   * Drivers without a flush operation retain their synchronous-write contract.
+   */
+
+  if (ret == OK && fs->fs_blkdriver->u.i_bops->ioctl != NULL)
+    {
+      ret = fs->fs_blkdriver->u.i_bops->ioctl(fs->fs_blkdriver,
+                                            BIOC_FLUSH, 0);
+      if (ret == -ENOTTY || ret == -ENOSYS)
+        {
+          ret = OK;
+        }
     }
 
 errout_with_lock:
@@ -2336,6 +2352,22 @@
         }
     }
 
+  /* Drain before close consumes the block reference. On failure retain the
+   * mounted filesystem, so a caller can retry without closing it twice.
+   */
+
+  if ((flags & MNT_FORCE) == 0 && fs->fs_blkdriver != NULL &&
+      fs->fs_blkdriver->u.i_bops->ioctl != NULL)
+    {
+      ret = fs->fs_blkdriver->u.i_bops->ioctl(fs->fs_blkdriver,
+                                            BIOC_FLUSH, 0);
+      if (ret < 0 && ret != -ENOTTY && ret != -ENOSYS)
+        {
+          nxmutex_unlock(&fs->fs_lock);
+          return ret;
+        }
+    }
+
   /* Unmount ... close the block driver */
 
   if (fs->fs_blkdriver)
