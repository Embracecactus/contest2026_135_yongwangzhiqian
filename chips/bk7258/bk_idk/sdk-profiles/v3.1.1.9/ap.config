# BK7258_BUNDLE_TREE_SHA256=7e681b15c3c37ac619230adadef2c49e77e1dd1e676ba182cf859603616eea37
# BK7258 AP SDK bundle profile.
# BK7258_BUNDLE_OMIT=libbk_rtos.a,libbk_system.a,libos_source.a,libos.a,libcmsis.a,libcoredump.a,libunity.a,libpsa_mbedtls.a,libbk_cli.a,libbk_netif.a,liblwip_intf_v2_1.a,libbk_startup.a,libota.a
#
# This is the maintained AP bundle profile for the manifest-pinned SDK.
# NuttX owns the AP scheduler, startup, CLI, TCP/IP stack and OTA platform.
# The vendor Wi-Fi archives remain as the radio/mailbox data plane and bind to
# the native NuttX netdev adapter; do not import the FreeRTOS application's
# startup, lwIP/netif, CLI or historical OTA ownership into the AP image.

CONFIG_PWM=y

# Variant overlays may override these defaults.
# CONFIG_SDCARD_BUSWIDTH_4LINE is not set
# CONFIG_SDIO_4LINES_EN is not set

CONFIG_DVP_CAMERA=y
CONFIG_DVP_CAMERA_I2C_ID=2
CONFIG_DVP_CTRL_POWER_GPIO_ID=28
CONFIG_DVP_THREAD_STACK_SIZE=2048

CONFIG_SIM_I2C=y
CONFIG_SIM_I2C_HW_BOARD_V3=y
CONFIG_SIM_I2C1_SCL_GPIO=13
CONFIG_SIM_I2C1_SDA_GPIO=15

CONFIG_DVP_GC0308=y
CONFIG_DVP_GC0328C=y
CONFIG_DVP_GC2145=y
CONFIG_DVP_HM1055=y
CONFIG_DVP_OV2640=y
CONFIG_DVP_SC101=y

CONFIG_YUV_BUF=y
CONFIG_JPEGENC_HW=y
CONFIG_H264=y
CONFIG_H264_QUALITY_LEVEL=2
CONFIG_H264_GOP_START_IDR_FRAME=y
CONFIG_H264_ADD_SELF_DEFINE_SEI=y
CONFIG_H264_P_FRAME_CNT=29

CONFIG_CAN=y
# CONFIG_CAN_PM_CB_SUPPORT is not set
# CONFIG_CAN_TEST is not set
# CONFIG_CAN_DEMO is not set

CONFIG_ETH=y
CONFIG_ETH_PIN_GROUP0=y
# CONFIG_ETH_PIN_GROUP1 is not set
# CONFIG_ETH_PTP is not set
# CONFIG_ETH_VLAN is not set
# CONFIG_ETH_LPI is not set
# CONFIG_ETH_EEE is not set
# CONFIG_ETH_REGISTER_CALLBACKS is not set
# CONFIG_ETH_TSO is not set
CONFIG_ETH_CSUM_OFFLOAD=y
# CONFIG_ETH_PM_CB_SUPPORT is not set

CONFIG_LIN=y
CONFIG_SLCD=y
CONFIG_SBC=y
CONFIG_AUDIO_DMIC=y

CONFIG_USB_DEVICE=y
CONFIG_USB_CDC=y
# CONFIG_USBD_MSC is not set
# CONFIG_USBD_HID is not set
# CONFIG_USBD_UVC is not set
# CONFIG_USBD_UAC is not set
