# BK7258_BUNDLE_TREE_SHA256=86ca1ff783e9ea357eee646903e9f34d2b02ff1012de238e3e23c570e4b20fb1
# BK7258 CP AIDK AI Toy board overlay.
#
# X2/C16/C17 are not fitted.  The shared vendor CP configuration otherwise
# forces MP_A silicon to use an external 32.768 kHz source even when
# CONFIG_EXTERN_32K is clear.  Disable that override so bk_clk_32k_* selects
# the calibrated internal ROSC instead; P8/P9 remain available as GPIOs.

# CONFIG_EXTERN_32K is not set
# CONFIG_EXTERN_32K_PIN_MULT is not set
# CONFIG_LPO_SRC_26M32K is not set
# CONFIG_LPO_MP_A_FORCE_USE_EXT32K is not set
