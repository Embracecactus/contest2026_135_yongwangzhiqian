# BK7258_BUNDLE_TREE_SHA256=f7de532a4433d5cef39e202fb63d08496a75805e4a77ba245da9d9a73fc6f633
# BK7258 AIDK AI Toy AP SDK bundle overlay.
# BK7258_BUNDLE_OMIT=libaec.a
#
# AIDK uses the maintained SDK AEC v3 backend.  The official AP link closure
# contains both legacy libaec.a and libaec_v3.a with the same public raw ABI;
# exclude the legacy owner so the bundle has one deterministic implementation.
# The board also needs the SDK's four-line SD-card host data-path option.
# Its GC2145 SCCB route is hardware I2C1 on P42/P43; the base AP profile's
# simulated I2C2 route is for the T5 boards and must not leak into AIDK.

CONFIG_SDCARD_BUSWIDTH_4LINE=y
# CONFIG_SDIO_4LINES_EN is not set
CONFIG_DVP_CAMERA_I2C_ID=1

# SDIO TX DMA is consumed by the blocking chip lower half; RX stays CPU FIFO.
CONFIG_SDIO_GDMA_EN=y
