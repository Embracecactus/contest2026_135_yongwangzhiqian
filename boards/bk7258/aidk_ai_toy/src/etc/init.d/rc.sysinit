 ****************************************************************************/

#include <nuttx/config.h>

#ifdef CONFIG_FS_PROCFS
mount -t procfs CONFIG_NSH_PROC_MOUNTPOINT
#endif

#if defined(CONFIG_BK7258_ONCHIP_DATAFS) && \
    defined(CONFIG_FS_LITTLEFS)
mkdir /data
#ifdef CONFIG_BK7258_APP_FACTORY
/* The product owner decides how /data is mounted.  Only a pending factory
 * transaction may initialize it; every other boot mounts an existing valid
 * LittleFS and never formats anything.  A failed mount still continues to
 * rcS: the FINALINIT marker, not this script, is the storage gate.
 */
bkfactory mount
#else
mount -t littlefs /dev/mtdblock0 /data
#endif
#endif

#ifndef CONFIG_NSH_DISABLE_ECHO
echo "BK7258 SYSINIT PASS"
#endif
