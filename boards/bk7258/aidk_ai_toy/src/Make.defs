# AIDK AI Toy physical-device bindings.

CSRCS += bk7258_board_bringup.c

ifeq ($(CONFIG_ETC_ROMFS),y)
RCSRCS = etc/init.d/rc.sysinit etc/init.d/rcS
endif

ifeq ($(CONFIG_BK7258_AUD),y)
CSRCS += bk7258_aidk_board_audio.c
endif

ifeq ($(CONFIG_BK7258_AIDK_SD_NAND),y)
CSRCS += bk7258_aidk_board_sdio.c
endif

ifeq ($(CONFIG_BK7258_AIDK_CAMERA_PHASE0),y)
CSRCS += bk7258_aidk_camera_phase0.c
endif

ifeq ($(CONFIG_BK7258_AIDK_CAMERA),y)
CSRCS += bk7258_aidk_camera.c bk7258_aidk_camera_glue.c
endif

ifeq ($(CONFIG_BK7258_AIDK_SC7A20_PHASE0),y)
CSRCS += bk7258_aidk_sc7a20_phase0.c
endif

ifeq ($(CONFIG_BK7258_AIDK_SC7A20),y)
CSRCS += bk7258_aidk_sc7a20.c
endif

ifeq ($(CONFIG_BK7258_AIDK_MFRC522),y)
CSRCS += bk7258_aidk_mfrc522.c
endif

ifeq ($(CONFIG_BK7258_AIDK_BATTERY),y)
CSRCS += bk7258_aidk_battery.c
endif

ifeq ($(CONFIG_BK7258_AIDK_DUAL_LCD),y)
CSRCS += bk7258_aidk_dual_lcd.c
endif
