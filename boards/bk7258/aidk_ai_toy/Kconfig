# Shared BK7258 options; this board's defconfigs select AIDK AI Toy.
source "../vendor/beken/boards/bk7258/common/Kconfig"

config BK7258_AIDK_SC7A20_PHASE0
	bool "Probe AIDK SC7A20H identity at boot"
	default n
	depends on BK7258_BOARD_AIDK_AI_TOY
	depends on BK7258_AP_CORE
	depends on BK7258_I2C && BK7258_I2C_BUS = 0
	help
		Perform a bounded, read-only SC7A20H identity check during AP board
		bring-up.  The board opens the maintained I2C0 character device, reads
		only WHO_AM_I at register 0x0f and requires value 0x11.  It does not
		configure output data rate, axes, FIFO or interrupts and therefore is
		not a production accelerometer driver.

config BK7258_AIDK_CAMERA
	bool "AIDK GC2145 DVP camera as /dev/video0"
	default n
	depends on BK7258_BOARD_AIDK_AI_TOY
	depends on BK7258_AP_CORE && BK7258_DVP && BK7258_PSRAM
	depends on !BK7258_AIDK_CAMERA_PHASE0
	select BK7258_DVP_BOARD_GLUE
	help
		Bind the fitted AIDK GC2145 and its board-specific power/reset/pinmux
		sequence to the reusable BK7258 DVP imgdata lower half and the standard
		NuttX V4L2 capture upper half.  The initial production profile exposes
		640x480, 30 fps MJPEG through /dev/video0.  This replaces the bounded
		identity-only Phase 0 probe and must not be enabled with it.
