/****************************************************************************
 * contest2026_135_yongwangzhiqian/board/bk7258/scripts/ld_ap.script
 *
 * SPDX-License-Identifier: Apache-2.0
 *
 * Linker script for the physical CPU1 / AP logical-core-0 NuttX image.
 *
 *   SPINLOCK: 0x28000000 .. 0x2800ffff (official BK7258 SMP region)
 *   FLASH : 0x02150000 .. 0x0225ffff  (logical offset 0x00150000)
 *   RAM   : 0x28050000 .. 0x2809efff
 *   SHARED: 0x2809f000 .. 0x2809ffff  (not linked into this image)
 ****************************************************************************/

#include <nuttx/config.h>
#include <bk7258_partitions.h>

OUTPUT_ARCH("arm")
EXTERN(_vectors)
EXTERN(__vector_core0_table)
EXTERN(__vector_core1_table)
EXTERN(bk7258_ap_main)
#ifdef CONFIG_ARCH_HAVE_TCBINFO
/* The official J-Link RTOS plugin reads g_tcbinfo/g_reginfo from the ELF. */
EXTERN(g_tcbinfo)
#endif
#ifdef CONFIG_BK7258_AP_IPI
EXTERN(bk_int_isr_register)
#endif
ENTRY(_vectors)

MEMORY
{
#ifdef CONFIG_BK7258_MCUBOOT_IMAGE
    /* MCUboot owns the first 0x200 bytes; keep the AP vector table VTOR
     * aligned exactly as the CP linker script does. */
    FLASH (rx)  : ORIGIN = BK7258_ARTIFACT_AP_XIP_START + 0x200,
                  LENGTH = BK7258_ARTIFACT_AP_LOGICAL_SIZE - 0x200
#else
    FLASH (rx)  : ORIGIN = BK7258_ARTIFACT_AP_XIP_START,
                  LENGTH = BK7258_ARTIFACT_AP_LOGICAL_SIZE
#endif
    SPINLOCK (rwx) : ORIGIN = 0x28000000, LENGTH = 0x010000
#ifdef CONFIG_BK7258_RPTUN_LAYOUT
    RAM   (rwx) : ORIGIN = 0x28050000, LENGTH = 0x047000
#else
    RAM   (rwx) : ORIGIN = 0x28050000, LENGTH = 0x04f000
#endif
}

_bk7258_rptun_shmem_start = 0x28097000;
_bk7258_rptun_shmem_end = 0x2809f000;
_bk7258_rptun_control = 0x28097000;
_bk7258_rptun_resource = 0x28097040;
_bk7258_rptun_carveout_start = 0x28097180;
_bk7258_rptun_carveout_end = 0x2809f000;

_estack = ORIGIN(RAM) + LENGTH(RAM) - 4;

SECTIONS
{
    . = ORIGIN(FLASH);
    .vectors : ALIGN(4)
    {
        KEEP(*(.vectors_core0))
        KEEP(*(.vectors))
        . = ALIGN(4);
    } > FLASH

    ASSERT(__vector_core0_table == ORIGIN(FLASH),
           "ERROR: AP __vector_core0_table must be at generated FLASH origin")
    ASSERT(_vectors == __vector_core0_table,
           "ERROR: AP _vectors must alias __vector_core0_table")
    ASSERT(SIZEOF(.vectors) == 0x140,
           "ERROR: AP vector table must contain 80 entries")

    /* Physical CPU2 executes the AP-local logical-core-1 vector.  N8-A uses
     * it for the freestanding probe; N8-B1 uses it for secondary bootstrap.
     * Keep it in the same XIP image, independently 512-byte aligned.
     */

    . = ALIGN(512);
    .cpu2_vectors : ALIGN(4)
    {
        KEEP(*(.vectors_core1))
        . = ALIGN(4);
    } > FLASH

    ASSERT((__vector_core1_table & 0x1ff) == 0,
           "ERROR: CPU2 vector must be 512-byte aligned")
    ASSERT(SIZEOF(.cpu2_vectors) == 0x140,
           "ERROR: CPU2 vector must contain 80 entries")

    .text : ALIGN(4)
    {
        _stext = ABSOLUTE(.);
        *(.text .text.*)
        *(.fixup)
        *(.gnu.warning)
        *(.rodata .rodata.*)
        *(.gnu.linkonce.t.*)
        *(.glue_7)
        *(.glue_7t)
        *(.gcc_except_table)
        *(.gnu.linkonce.r.*)
        KEEP(*(.psram_boot_text))
        . = ALIGN(4);
        _etext = ABSOLUTE(.);
    } > FLASH

    .init_section : ALIGN(4)
    {
        _sinit = ABSOLUTE(.);
        KEEP(*(SORT_BY_INIT_PRIORITY(.init_array.*)
               SORT_BY_INIT_PRIORITY(.ctors.*)))
        KEEP(*(.init_array
               EXCLUDE_FILE(*crtbegin.o *crtbegin?.o *crtend.o *crtend?.o)
               .ctors))
        _einit = ABSOLUTE(.);
    } > FLASH

    .ARM.extab : ALIGN(4)
    {
        *(.ARM.extab*)
    } > FLASH

    .ARM.exidx : ALIGN(4)
    {
        __exidx_start = ABSOLUTE(.);
        *(.ARM.exidx*)
        __exidx_end = ABSOLUTE(.);
    } > FLASH

    /* SDK IPC channel registration table (BK_IPC_CHANNEL_REGISTER entries).
     * bk_ipc_init() walks __start/__stop_ipc_chan_reg to bind channel
     * handles; without this kept section the table is gc'ed and the first
     * bk_ipc_send() dereferences an unbound handle. */
    .ipc_chan_reg : ALIGN(4)
    {
        PROVIDE_HIDDEN(__start_ipc_chan_reg = .);
        KEEP(*(.ipc_chan_reg))
        PROVIDE_HIDDEN(__stop_ipc_chan_reg = .);
    } > FLASH

    /* The immutable v3.1.1.9 DVP implementation enumerates sensor-detect
     * records through these exact boundary symbols.  The SDK linker script
     * keeps the same input section; reproduce that ABI in the board-owned
     * AP image instead of modifying either SDK or NuttX sources. */

    .sensor_detect : ALIGN(4)
    {
        __camera_sensor_detect_array_start = .;
        KEEP(*(.camera_sensor_detect_function_list.*))
        __camera_sensor_detect_array_end = .;
    } > FLASH

    .tdata : ALIGN(4)
    {
        _stdata = ABSOLUTE(.);
        *(.tdata .tdata.* .gnu.linkonce.td.*);
        _etdata = ABSOLUTE(.);
    } > FLASH

    .tbss : ALIGN(4)
    {
        _stbss = ABSOLUTE(.);
        *(.tbss .tbss.* .gnu.linkonce.tb.* .tcommon);
        _etbss = ABSOLUTE(.);
    } > FLASH

    /* BK7258 has only two SRAM-port exclusive monitors.  The official SDK
     * isolates AP SMP locks in the first 64 KiB instead of ordinary AP RAM.
     * Preserve initialized vendor/board locks in FLASH and collect every
     * static global lock emitted with -fdata-sections.  The AP scheduler IPI
     * pending words also use LDREX/STREX through atomic_xchg(), so keep them
     * on the same exclusive-safe SRAM port.
     */

    .spinlock_data : ALIGN(4)
    {
        _sspinlock_data = ABSOLUTE(.);
        *(.sram_spinlock_section)
        *(.data.g_bk7258_sdk_critical_lock)
        . = ALIGN(4);
        _espinlock_data = ABSOLUTE(.);
    } > SPINLOCK AT > FLASH
    _lspinlock_data = LOADADDR(.spinlock_data);

    .spinlock_bss (NOLOAD) : ALIGN(4)
    {
        _sspinlock_bss = ABSOLUTE(.);
        *(.bss.g_*lock*)
        *(.bss.g_bk7258_ap_smp_pending)
        . = ALIGN(4);
        _espinlock_bss = ABSOLUTE(.);
    } > SPINLOCK

    _eronly = LOADADDR(.data);

    .irq_stack : ALIGN(4)
    {
        g_intstackalloc = ABSOLUTE(.);
        . += CONFIG_ARCH_INTERRUPTSTACK;
        g_intstacktop = ABSOLUTE(.);
    } > RAM

    .ram_vectors (NOLOAD) : ALIGN(512)
    {
        _sram_vectors = ABSOLUTE(.);
        KEEP(*(.ram_vectors))
        . = ALIGN(4);
        _eram_vectors = ABSOLUTE(.);
    } > RAM

    ASSERT((_sram_vectors & 0x1ff) == 0,
           "ERROR: AP .ram_vectors must be 512-byte aligned")
    ASSERT(_eram_vectors - _sram_vectors == 0x140,
           "ERROR: AP .ram_vectors must contain 80 entries")

    .data : ALIGN(4)
    {
        _sdata = ABSOLUTE(.);
        *(.data .data.*)
        *(.gnu.linkonce.d.*)
#ifdef CONFIG_BK7258_RPTUN_LAYOUT
        *(.swap_data)
        *(.dtcm_sec_data)
#endif
        CONSTRUCTORS
        . = ALIGN(4);
        _edata = ABSOLUTE(.);
    } > RAM AT > FLASH

    .bss (NOLOAD) : ALIGN(4)
    {
        _sbss = ABSOLUTE(.);
        *(.bss .bss.*)
        *(.gnu.linkonce.b.*)
        *(COMMON)
        . = ALIGN(4);
        _ebss = ABSOLUTE(.);
    } > RAM

    . = ALIGN(16);
    _sheap = ABSOLUTE(.);

    /* Reserve the AP SRAM top for physical CPU2.  AP-UP preserves the N8-A
     * 1 KiB freestanding probe stack.  AP-SMP reserves one full architecture
     * interrupt stack for the N8-B1 secondary bootstrap; CPU2's future IDLE
     * stack is allocated independently by up_cpu_idlestack().
     */

    _bk7258_cpu2_probe_stack_top = ORIGIN(RAM) + LENGTH(RAM);
#ifdef CONFIG_BK7258_AP_SMP_BOOTSTRAP
    _bk7258_cpu2_probe_stack_base =
      _bk7258_cpu2_probe_stack_top - CONFIG_ARCH_INTERRUPTSTACK;
#else
    _bk7258_cpu2_probe_stack_base =
      _bk7258_cpu2_probe_stack_top - 0x400;
#endif
    _eheap = _bk7258_cpu2_probe_stack_base - 4;

#ifdef CONFIG_BK7258_RPTUN_LAYOUT
    ASSERT(_bk7258_cpu2_probe_stack_top == 0x28097000,
           "ERROR: N9 CPU2 boot stack must end at RPTUN shared memory")
    ASSERT(_bk7258_rptun_shmem_end == 0x2809f000,
           "ERROR: RPTUN shared memory overlaps telemetry")
    ASSERT(_bk7258_rptun_carveout_start == 0x28097180,
           "ERROR: RPTUN carveout ABI drift")
#else
    ASSERT(_bk7258_cpu2_probe_stack_top == 0x2809f000,
           "ERROR: CPU2 boot stack must end at the shared-page boundary")
#endif
    ASSERT(_ebss + CONFIG_IDLETHREAD_STACKSIZE <= _eheap,
           "ERROR: AP data/IDLE stack overlaps the CPU2 boot stack")
    ASSERT(ORIGIN(SPINLOCK) == 0x28000000 &&
           ORIGIN(SPINLOCK) + LENGTH(SPINLOCK) == 0x28010000,
           "ERROR: AP spinlock region must match the official BK7258 ABI")
    ASSERT(_espinlock_bss <= ORIGIN(SPINLOCK) + LENGTH(SPINLOCK),
           "ERROR: AP SMP spinlocks exceed the dedicated region")
    ASSERT(g_schedlock >= ORIGIN(SPINLOCK) &&
           g_schedlock + 4 <= ORIGIN(SPINLOCK) + LENGTH(SPINLOCK),
           "ERROR: NuttX g_schedlock is outside the AP spinlock region")
    ASSERT(LOADADDR(.data) + SIZEOF(.data) <=
           ORIGIN(FLASH) + LENGTH(FLASH),
           "ERROR: AP image exceeds the app1 flash partition")
    ASSERT(_eheap < _bk7258_cpu2_probe_stack_top,
           "ERROR: AP RAM overlaps the CPU2 boot stack")

    .stab              0 : { *(.stab) }
    .stabstr           0 : { *(.stabstr) }
    .stab.excl         0 : { *(.stab.excl) }
    .stab.exclstr      0 : { *(.stab.exclstr) }
    .stab.index        0 : { *(.stab.index) }
    .stab.indexstr     0 : { *(.stab.indexstr) }
    .comment           0 : { *(.comment) }
    .debug_abbrev      0 : { *(.debug_abbrev) }
    .debug_info        0 : { *(.debug_info) }
    .debug_line        0 : { *(.debug_line) }
    .debug_pubnames    0 : { *(.debug_pubnames) }
    .debug_aranges     0 : { *(.debug_aranges) }
}
