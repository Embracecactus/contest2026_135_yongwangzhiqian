############################################################################
# Beken BK7258 shared board sources
#
# SPDX-License-Identifier: Apache-2.0
############################################################################

BK7258_CHIP_DIR := $(TOPDIR)$(DELIM)arch$(DELIM)$(CONFIG_ARCH)$(DELIM)src$(DELIM)chip

CFLAGS += ${INCDIR_PREFIX}$(BK7258_CHIP_DIR)$(DELIM)common
CFLAGS += ${INCDIR_PREFIX}$(BK7258_CHIP_DIR)$(DELIM)cp
CFLAGS += -isystem $(BK7258_SDK_DIR)$(DELIM)include
CFLAGS += -isystem $(BK7258_SDK_DIR)$(DELIM)config

CSRCS += bk7258_appinit.c bk7258_boot.c bk7258_bringup.c
CSRCS += bk7258_platform.c

ifeq ($(CONFIG_BOARDCTL_FINALINIT),y)
CSRCS += bk7258_finalinit.c
endif

ifneq ($(CONFIG_BK7258_AP_CORE),y)
CSRCS += bk7258_boot_slot.c bk7258_sdk_partition.c
ifneq ($(filter y,$(CONFIG_BK7258_BT_IPC) $(CONFIG_BK7258_WIFI_VNET)),)
CSRCS += bk7258_mac_storage.c
endif
ifeq ($(CONFIG_BK7258_FLASH_MTD),y)
CSRCS += bk7258_flash_mtd.c bk7258_flash_guard.c
endif
ifneq ($(filter y,$(CONFIG_BK7258_OTA) $(CONFIG_BK7258_WDT_PRETIMEOUT_PANIC)),)
CSRCS += bk7258_ota_flash.c
endif
ifeq ($(CONFIG_BK7258_OTA),y)
CSRCS += bk7258_ota_image.c bk7258_ota_pair.c \
         bk7258_ota_boot_control.c
ifeq ($(CONFIG_BK7258_OTA_AUTO_CONFIRM),y)
CSRCS += bk7258_ota_trial.c
endif
ifneq ($(CONFIG_BK7258_FLASH_MTD),y)
CSRCS += bk7258_flash_guard.c
endif
endif
endif

ifeq ($(CONFIG_BK7258_LCD),y)
VPATH += :panels
DEPPATH += --dep-path panels
CFLAGS += ${INCDIR_PREFIX}$(BOARD_COMMON_DIR)$(DELIM)panels
CSRCS += ili9488_rgb.c
endif

ifeq ($(CONFIG_BK7258_WIFI_VNET),y)
CSRCS += bk7258_wifi_control.c
ifeq ($(CONFIG_BK7258_AP_CORE),y)
CFLAGS += ${INCDIR_PREFIX}$(APPDIR)$(DELIM)include
endif
endif
