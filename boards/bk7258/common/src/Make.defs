############################################################################
# Beken BK7258 shared board sources
#
# SPDX-License-Identifier: Apache-2.0
############################################################################

CFLAGS += -isystem $(BK7258_SDK_DIR)$(DELIM)include
CFLAGS += -isystem $(BK7258_SDK_DIR)$(DELIM)config

CSRCS += bk7258_appinit.c bk7258_boot.c bk7258_bringup.c

ifeq ($(CONFIG_BK7258_AP_CORE),y)
CSRCS += bk7258_ap_bringup.c bk7258_ap_entry.c
endif

ifeq ($(CONFIG_EXAMPLES_AI_AGENT_VELA),y)
CSRCS += bk7258_product.c
ifeq ($(CONFIG_MEDIA),)
ifneq ($(filter y,$(CONFIG_BK7258_MIC) $(CONFIG_BK7258_AUD)),)
CFLAGS += ${INCDIR_PREFIX}$(APPDIR)$(DELIM)..$(DELIM)frameworks$(DELIM)multimedia$(DELIM)media$(DELIM)include
endif
ifeq ($(CONFIG_BK7258_MIC),y)
CSRCS += bk7258_product_media_recorder.c
CFLAGS += -DCONFIG_BK7258_AGENT_MEDIA_RECORDER=1
endif
ifeq ($(CONFIG_BK7258_AUD),y)
CSRCS += bk7258_product_media_player.c
CFLAGS += -DCONFIG_BK7258_AGENT_MEDIA_PLAYER=1
endif
endif
endif

ifeq ($(CONFIG_BOARDCTL_FINALINIT),y)
CSRCS += bk7258_finalinit.c
endif

ifneq ($(CONFIG_BK7258_AP_CORE),y)
CSRCS += bk7258_cp_bringup.c bk7258_sdk_partition.c
ifeq ($(CONFIG_BOARDCTL_RESET_CAUSE),y)
CSRCS += bk7258_reset_cause.c
endif
ifneq ($(filter y,$(CONFIG_BK7258_OTA) $(CONFIG_BK7258_WDT_PRETIMEOUT_PANIC) $(CONFIG_BK7258_FLASH_MTD) $(CONFIG_BK7258_BT_IPC) $(CONFIG_BK7258_WIFI_VNET)),)
CSRCS += bk7258_storage_config.c
endif
ifeq ($(CONFIG_BK7258_FLASH_MTD),y)
CSRCS += bk7258_flash_mtd.c
endif
ifeq ($(CONFIG_BK7258_OTA),y)
ifeq ($(CONFIG_BK7258_OTA_AUTO_CONFIRM),y)
CSRCS += bk7258_ota_trial.c
endif
endif
endif
