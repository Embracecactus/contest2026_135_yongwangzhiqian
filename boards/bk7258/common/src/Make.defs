############################################################################
# Beken BK7258 shared board sources
#
# SPDX-License-Identifier: Apache-2.0
############################################################################

CSRCS += bk7258_appinit.c bk7258_boot.c bk7258_bringup.c

ifeq ($(CONFIG_BK7258_AP_CORE),y)
CSRCS += bk7258_ap_bringup.c bk7258_ap_entry.c
endif

ifeq ($(CONFIG_BOARDCTL_FINALINIT),y)
CSRCS += bk7258_finalinit.c
endif

ifneq ($(CONFIG_BK7258_AP_CORE),y)
CSRCS += bk7258_cp_bringup.c
ifeq ($(CONFIG_BOARDCTL_RESET_CAUSE),y)
CSRCS += bk7258_reset_cause.c
endif
ifneq ($(filter y,$(CONFIG_BK7258_OTA) $(CONFIG_BK7258_WDT_PRETIMEOUT_PANIC) $(CONFIG_BK7258_FLASH_MTD) $(CONFIG_BK7258_BT_IPC) $(CONFIG_BK7258_WIFI_VNET)),)
CSRCS += bk7258_storage_config.c
endif
ifeq ($(CONFIG_BK7258_OTA),y)
ifeq ($(CONFIG_BK7258_OTA_AUTO_CONFIRM),y)
CSRCS += bk7258_ota_trial.c
endif
endif
endif
