Subject: [PATCH] tools: use camera device format and selected LLM transport

Local, not upstream. The official ai_agent source is pinned at
41723c61725c4e845bfee724f3ad2fafc416b6e1. Fixed-size V4L2 JPEG devices
need their advertised discrete size; camera buffer results must be bounded.
Vision requests must accept the same externally authenticated LLM transport
as ordinary chat, without requiring a second API key in the generic client.
The existing camera tool, request transport, Agent and Media remain owners.
Original source licenses are unchanged. Apply after patches 0002 through 0008.
SPDX-License-Identifier: Apache-2.0

--- a/src/tools/tool_camera.c
+++ b/src/tools/tool_camera.c
@@ -73,6 +73,48 @@
     "If there is text, read it. If there are objects, identify them."
 
 /* ── V4L2 capture helper ─────────────────────────────────── */
+
+static void camera_format_init(struct v4l2_format *fmt, int width, int height,
+                               uint32_t pixelformat)
+{
+    memset(fmt, 0, sizeof(*fmt));
+    fmt->type                = V4L2_BUF_TYPE_VIDEO_CAPTURE;
+    fmt->fmt.pix.width       = width;
+    fmt->fmt.pix.height      = height;
+    fmt->fmt.pix.pixelformat = pixelformat;
+    fmt->fmt.pix.sizeimage   = CAM_BUF_SIZE;
+    fmt->fmt.pix.field       = V4L2_FIELD_NONE;
+}
+
+static int camera_set_format(int fd, struct v4l2_format *fmt,
+                             int width, int height)
+{
+    struct v4l2_frmsizeenum framesize;
+
+    camera_format_init(fmt, width, height, V4L2_PIX_FMT_JPEG);
+    if (ioctl(fd, VIDIOC_S_FMT, (uintptr_t)fmt) == 0) return OK;
+    if (errno != EINVAL && errno != ENOTSUP) return -errno;
+
+    memset(&framesize, 0, sizeof(framesize));
+    framesize.index = 0;
+    framesize.pixel_format = V4L2_PIX_FMT_JPEG;
+    framesize.buf_type = V4L2_BUF_TYPE_VIDEO_CAPTURE;
+    if (ioctl(fd, VIDIOC_ENUM_FRAMESIZES, (uintptr_t)&framesize) == 0) {
+        if (framesize.type == V4L2_FRMSIZE_TYPE_DISCRETE &&
+            framesize.discrete.width != 0 && framesize.discrete.height != 0) {
+            camera_format_init(fmt, framesize.discrete.width,
+                               framesize.discrete.height, V4L2_PIX_FMT_JPEG);
+            if (ioctl(fd, VIDIOC_S_FMT, (uintptr_t)fmt) == 0) return OK;
+            if (errno != EINVAL && errno != ENOTSUP) return -errno;
+        }
+    } else if (errno != EINVAL && errno != ENOTTY && errno != ENOTSUP) {
+        return -errno;
+    }
+
+    camera_format_init(fmt, width, height, V4L2_PIX_FMT_ENTROPY);
+    if (ioctl(fd, VIDIOC_S_FMT, (uintptr_t)fmt) < 0) return -errno;
+    return OK;
+}
 
