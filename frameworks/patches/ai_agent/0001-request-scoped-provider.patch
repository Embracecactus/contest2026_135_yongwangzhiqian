+int llm_chat_tools(const char* system_prompt, cJSON* messages,
+    const char* tools_json, llm_response_t* resp)
+{
+    char model[64];
+    char api_key[128];
+    char llm_host[128];
+    char *post_data = NULL;
+    resp_buf_t rb = { 0 };
+    int status = 0;
+    int err = ERROR;
