-    return OK;
+    if (!resp) {
+        return ERROR;
+    }
+    memset(resp, 0, sizeof(*resp));
+
+    pthread_mutex_lock(&s_llm_lock);
+    memcpy(model, s_model, sizeof(model));
+    memcpy(api_key, s_api_key, sizeof(api_key));
+    memcpy(llm_host, s_llm_host, sizeof(llm_host));
+    pthread_mutex_unlock(&s_llm_lock);
+    if (api_key[0] == '\0') {
+        return ERROR;
+    }
+    if (llm_chat_tools_build_request(system_prompt, messages, tools_json, model,
+            llm_host, NULL, false, &post_data) != OK) {
+        return ERROR;
+    }
+
+    syslog(LOG_INFO, "[%s] OpenAI API with tools (model: %s, %d bytes)\n",
+        TAG, model, (int)strlen(post_data));
+    for (retry = 0; retry <= AGENT_LLM_MAX_RETRIES; retry++) {
+        if (retry > 0) {
+            unsigned int delay = AGENT_LLM_RETRY_BASE_SEC << (retry - 1);
+            syslog(LOG_WARNING, "[%s] Rate limited, retry %d/%d after %us\n",
+                TAG, retry, AGENT_LLM_MAX_RETRIES, delay);
+            sleep(delay);
+        }
+        rb.len = 0;
+        status = 0;
+        err = llm_http_call(post_data, &rb, &status);
+        if (err != OK || status != 429) {
+            break;
+        }
+        resp_buf_free(&rb);
+        memset(&rb, 0, sizeof(rb));
+    }
+    free(post_data);
+    if (err != OK || status != 200) {
+        resp_buf_free(&rb);
+        return err != OK ? err : ERROR;
+    }
+    err = llm_chat_tools_parse_response(rb.data, rb.len, resp, false);
+    resp_buf_free(&rb);
+    return err;
+}
+
+int llm_chat_tools_request(const char *system_prompt, cJSON *messages,
+    const char *tools_json, const llm_request_t *request,
+    llm_response_t *resp)
+{
+    char *post_data = NULL;
+    char *response = NULL;
+    size_t response_size = 0;
+    int ret;
+
+    if (!resp || !request || !request->post || !request->model ||
+        !request->model[0] || !request->host || !request->host[0]) {
+        return -EINVAL;
+    }
+    memset(resp, 0, sizeof(*resp));
+    ret = llm_chat_tools_build_request(system_prompt, messages, tools_json,
+        request->model, request->host, request->parameters, true, &post_data);
+    if (ret < 0) {
+        return ret;
+    }
+    ret = request->post(request->context, post_data, strlen(post_data),
+        &response, &response_size);
+    free(post_data);
+    if (ret != OK) {
+        free(response);
+        return ret;
+    }
+    if (!response || response_size == 0 || response_size == SIZE_MAX) {
+        free(response);
+        return -EBADMSG;
+    }
+    ret = llm_chat_tools_parse_response(response, response_size, resp, true);
+    free(response);
+    if (ret < 0) {
+        llm_response_free(resp);
+    }
+    return ret;
 }
