index 0000000..23d1195
--- /dev/null
+++ b/src/core/agent_turn.c
@@ -0,0 +1,233 @@
+#include "core/agent_turn.h"
+
+#include <errno.h>
+#include <stdlib.h>
+#include <string.h>
+
+int agent_turn_append_assistant_message(cJSON *messages,
+                                        const llm_response_t *response)
+{
+  cJSON *message;
+  cJSON *calls = NULL;
+  int index;
+
+  if (messages == NULL || response == NULL ||
+      response->call_count < 0 || response->call_count > AGENT_MAX_TOOL_CALLS)
+    {
+      return -EINVAL;
+    }
+
+  message = cJSON_CreateObject();
+  if (message == NULL ||
+      !cJSON_AddStringToObject(message, "role", "assistant") ||
+      (response->text != NULL &&
+       !cJSON_AddStringToObject(message, "content", response->text)) ||
+      (response->text == NULL &&
+       !cJSON_AddNullToObject(message, "content")) ||
+      (response->reasoning_content != NULL &&
+       !cJSON_AddStringToObject(message, "reasoning_content",
+                                response->reasoning_content)))
+    {
+      cJSON_Delete(message);
+      return -ENOMEM;
+    }
+
+  if (response->call_count > 0)
+    {
+      calls = cJSON_CreateArray();
+      if (calls == NULL)
+        {
+          cJSON_Delete(message);
+          return -ENOMEM;
+        }
+
+      for (index = 0; index < response->call_count; index++)
+        {
+          const llm_tool_call_t *call = &response->calls[index];
+          cJSON *tool_call = cJSON_CreateObject();
+          cJSON *function = cJSON_CreateObject();
+
+          if (tool_call == NULL || function == NULL ||
+              !cJSON_AddStringToObject(tool_call, "id", call->id) ||
+              !cJSON_AddStringToObject(tool_call, "type", "function") ||
+              !cJSON_AddStringToObject(function, "name", call->name) ||
+              !cJSON_AddStringToObject(function, "arguments",
+                                       call->input ? call->input : "{}"))
+            {
+              cJSON_Delete(function);
+              cJSON_Delete(tool_call);
+              cJSON_Delete(calls);
+              cJSON_Delete(message);
+              return -ENOMEM;
+            }
+
+          if (!cJSON_AddItemToObject(tool_call, "function", function))
+            {
+              cJSON_Delete(function);
+              cJSON_Delete(tool_call);
+              cJSON_Delete(calls);
+              cJSON_Delete(message);
+              return -ENOMEM;
+            }
+
+          if (!cJSON_AddItemToArray(calls, tool_call))
+            {
+              cJSON_Delete(tool_call);
+              cJSON_Delete(calls);
+              cJSON_Delete(message);
+              return -ENOMEM;
+            }
+        }
+
+      if (!cJSON_AddItemToObject(message, "tool_calls", calls))
+        {
+          cJSON_Delete(calls);
+          cJSON_Delete(message);
+          return -ENOMEM;
+        }
+    }
+
+  if (!cJSON_AddItemToArray(messages, message))
+    {
+      cJSON_Delete(message);
+      return -ENOMEM;
+    }
+
+  return 0;
+}
+
+static int append_result(cJSON *messages, const llm_tool_call_t *call,
+                         const char *text)
+{
+  cJSON *message = cJSON_CreateObject();
+
+  if (message == NULL ||
+      !cJSON_AddStringToObject(message, "role", "tool") ||
+      !cJSON_AddStringToObject(message, "tool_call_id", call->id) ||
+      !cJSON_AddStringToObject(message, "content", text ? text : "{}") ||
+      !cJSON_AddItemToArray(messages, message))
+    {
+      cJSON_Delete(message);
+      return -ENOMEM;
+    }
+
+  return 0;
+}
+
+static int append_extra(cJSON *messages, cJSON *extra)
+{
+  if (extra == NULL)
+    {
+      return 0;
+    }
+
+  if (!cJSON_IsArray(extra))
+    {
+      return -EINVAL;
+    }
+
+  while (extra->child != NULL)
+    {
+      cJSON *message = cJSON_DetachItemFromArray(extra, 0);
+      if (message == NULL || !cJSON_IsObject(message) ||
+          !cJSON_AddItemToArray(messages, message))
+        {
+          cJSON_Delete(message);
+          return -ENOMEM;
+        }
+    }
+
+  return 0;
+}
+
+int agent_turn_run(const char *prompt, cJSON *messages, const char *tools,
+                   const llm_request_t *request, unsigned int max,
+                   agent_turn_dispatch_t dispatch, void *context,
+                   llm_response_t *final)
+{
+  unsigned int iteration;
+
+  if (prompt == NULL || messages == NULL || !cJSON_IsArray(messages) ||
+      request == NULL || max == 0 || dispatch == NULL || final == NULL)
+    {
+      return -EINVAL;
+    }
+
+  memset(final, 0, sizeof(*final));
+  for (iteration = 0; iteration < max; iteration++)
+    {
+      llm_response_t response = {0};
+      int ret = llm_chat_tools_request(prompt, messages, tools, request,
+                                       &response);
+
+      if (ret != 0)
+        {
+          llm_response_free(&response);
+          return ret;
+        }
+
+      if (!response.tool_use)
+        {
+          *final = response;
+          return 0;
+        }
+
+      if (response.call_count <= 0 ||
+          response.call_count > AGENT_MAX_TOOL_CALLS)
+        {
+          llm_response_free(&response);
+          return -EBADMSG;
+        }
+
+      if (iteration + 1u == max)
+        {
+          llm_response_free(&response);
+          return -ELOOP;
+        }
+
+      ret = agent_turn_append_assistant_message(messages, &response);
+      if (ret != 0)
+        {
+          llm_response_free(&response);
+          return ret;
+        }
+
+      agent_turn_tool_result_t results[AGENT_MAX_TOOL_CALLS] = {{0}};
+      int index;
+      for (index = 0; index < response.call_count; index++)
+        {
+          ret = dispatch(context, &response.calls[index], &results[index]);
+          if (ret != 0)
+            {
+              int cleanup;
+              for (cleanup = 0; cleanup < response.call_count; cleanup++)
+                {
+                  cJSON_Delete(results[cleanup].extra_messages);
+                }
+              llm_response_free(&response);
+              return ret;
+            }
+        }
+
+      for (index = 0; ret == 0 && index < response.call_count; index++)
+        {
+          ret = append_result(messages, &response.calls[index],
+                              results[index].text);
+        }
+      for (index = 0; ret == 0 && index < response.call_count; index++)
+        {
+          ret = append_extra(messages, results[index].extra_messages);
+        }
+      for (index = 0; index < response.call_count; index++)
+        {
+          cJSON_Delete(results[index].extra_messages);
+        }
+      llm_response_free(&response);
+      if (ret != 0)
+        {
+          return ret;
+        }
+    }
+
+  return -ELOOP;
+}
