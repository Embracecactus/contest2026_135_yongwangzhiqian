Subject: [PATCH] voice: wait for Media release before freeing playback

Local, not upstream. Applies after the existing pinned-source patch series.
SPDX-License-Identifier: Apache-2.0

--- a/src/voice/audio_playback.c
+++ b/src/voice/audio_playback.c
@@ -49,6 +49,8 @@
     atomic_int stopped;
     atomic_int result;
     atomic_int completed;
+    atomic_int released;
+    int event_registered;
     sem_t completion;
 };
 
@@ -60,10 +62,25 @@
         int expected = 0;
         atomic_compare_exchange_strong(&pb->result, &expected, result);
         sem_post(&pb->completion);
-    } else if (event == MEDIA_EVENT_COMPLETED) {
-        atomic_store(&pb->completed, 1);
+    }
+    if (event == MEDIA_EVENT_COMPLETED || event == MEDIA_EVENT_STOPPED) {
+        atomic_store(&pb->released, 1);
+        if (event == MEDIA_EVENT_COMPLETED)
+            atomic_store(&pb->completed, 1);
         sem_post(&pb->completion);
     }
+}
+
+static int playback_wait_released(audio_playback_t* pb)
+{
+    struct timespec deadline;
+    clock_gettime(CLOCK_MONOTONIC, &deadline);
+    deadline.tv_sec += 5;
+    while (!atomic_load(&pb->released)) {
+        if (sem_clockwait(&pb->completion, CLOCK_MONOTONIC, &deadline) < 0 && errno != EINTR)
+            return -errno;
+    }
+    return 0;
 }
 
 audio_playback_t* audio_playback_open(const char* dev_path,
@@ -79,6 +96,11 @@
 
     pthread_mutex_lock(&s_player_lock);
     if (s_pending_close) {
+        if (!atomic_load(&s_pending_close->released)) {
+            pthread_mutex_unlock(&s_player_lock);
+            errno = EBUSY;
+            return NULL; /* preserve the in-flight callback and device owner */
+        }
         int ret = media_player_close(s_pending_close->player, 0);
         if (ret < 0) {
             pthread_mutex_unlock(&s_player_lock);
@@ -116,6 +138,7 @@
         goto fail;
     }
 
+    pb->event_registered = 1;
     char opts[PB_OPTIONS_LEN];
     snprintf(opts, sizeof(opts),
         "format=s%ule:sample_rate=%u:ch_layout=%s",
@@ -146,19 +169,12 @@
     return pb;
 
 fail:
-    if (pb->player) {
-        media_player_stop(pb->player);
-        int ret = media_player_close(pb->player, 0);
-        if (ret < 0) {
-            pthread_mutex_lock(&s_player_lock);
-            s_pending_close = pb;
-            pthread_mutex_unlock(&s_player_lock);
-            errno = -ret;
-            return NULL;
-        }
-    }
-    sem_destroy(&pb->completion);
-    free(pb);
+    {
+        int saved_errno = errno ? errno : EIO;
+        int ret = audio_playback_close(pb);
+        errno = ret < 0 ? -ret : saved_errno;
+        return NULL;
+    }
 fail_reservation:
     pthread_mutex_lock(&s_player_lock);
     s_player_reserved = 0;
@@ -277,8 +293,11 @@
     if (pb->player) {
         syslog(LOG_INFO, "[%s] closing (%zu bytes written)\n",
             TAG, pb->total_written);
-        media_player_stop(pb->player);
-        int ret = media_player_close(pb->player, 0);
+        int ret = media_player_stop(pb->player);
+        if (ret >= 0 && pb->event_registered)
+            ret = playback_wait_released(pb);
+        if (ret >= 0)
+            ret = media_player_close(pb->player, 0);
         if (ret < 0) {
             /* Media has not disconnected its event thread. Keep its cookie
              * alive and retry cleanup on the next open; never free under it. */
