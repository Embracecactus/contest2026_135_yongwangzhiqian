--- a/server/audio_graph.c
+++ b/server/audio_graph.c
@@ -632,6 +632,29 @@
             break;
         }
 
+        /* A device state notification can request a source before its first
+         * dynamic route has negotiated the links.  Such links intentionally
+         * have no audio format yet; activating them passes sample_rate=0 to
+         * the device.  Route negotiation will make the source ready again.
+         * Keep configured sources running so STOP/EOF can drain normally.
+         */
+        if (ctxi->p.nb_inputs == 0) {
+            bool pending_format = false;
+            for (i = 0; i < ctxi->p.nb_outputs; i++) {
+                AVFilterLink* link = ctxi->p.outputs[i];
+                if (link->type == AVMEDIA_TYPE_AUDIO
+                    && (link->sample_rate <= 0 || link->format < 0
+                        || link->ch_layout.nb_channels <= 0)) {
+                    pending_format = true;
+                    break;
+                }
+            }
+            if (pending_format) {
+                ctxi->ready = 0;
+                continue;
+            }
+        }
+
         ret = ff_filter_activate(&ctxi->p);
         if (ret < 0 && ret != AVERROR_EOF && ret != AVERROR(EAGAIN)) {
             av_log(graph, AV_LOG_ERROR, "%s %s activate failed, ret %d.\n", __func__, ctxi->p.name, ret);
