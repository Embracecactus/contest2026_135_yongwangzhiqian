Subject: [PATCH] media: retain and drain trigger resources on failure

SPDX-License-Identifier: Apache-2.0
Base: open-vela/frameworks_multimedia_media fb7db0e9f826fb6d71937c948e7da1eb10ffc896

--- a/server/media_trigger.c
+++ b/server/media_trigger.c
@@ -74,6 +74,7 @@
     void* handle;
     int state;
     bool exit;
+    bool recorder_started;
     int tran_fd;
     int notify_fd;
     int recorder_fd;
@@ -221,13 +222,17 @@
 {
     int ret;
 
-    ret = media_recorder_stop(ctx->handle);
-    if (ret < 0) {
-        MEDIA_ERR("stop recorder failed: %d\n", ret);
-        return ret;
-    }
-
+    if (!ctx->handle)
+        return 0;
+    if (ctx->recorder_started) {
+        ret = media_recorder_stop(ctx->handle);
+        if (ret < 0)
+            return ret;
+        ctx->recorder_started = false;
+    }
     ret = media_recorder_close(ctx->handle);
+    if (ret < 0)
+        return ret; /* close retains the handle on failure; retry owns it. */
     ctx->handle = NULL;
     free(ctx->buffer);
     ctx->buffer = NULL;
@@ -240,6 +245,11 @@
 {
     int ret;
 
+    if (ctx->handle) {
+        ret = media_trigger_stop_recorder(ctx);
+        if (ret < 0)
+            return ret;
+    }
     ctx->handle = media_recorder_open(MEDIA_SOURCE_HOTWORD);
     if (!ctx->handle) {
         MEDIA_ERR("recorder open failed\n");
@@ -258,6 +268,7 @@
         goto out;
     }
 
+    ctx->recorder_started = true;
     media_trigger_model_get_buffer_size(ctx->context, &ctx->buffer_size);
     if (ctx->buffer_size <= 0) {
         ret = -EINVAL;
@@ -275,15 +286,19 @@
     if (ctx->recorder_fd >= 0) {
         if (fcntl(ctx->recorder_fd, F_SETFL, fcntl(ctx->recorder_fd, F_GETFL, 0) | O_NONBLOCK) < 0) {
             MEDIA_ERR("Failed to set recorder fd non-blocking\n");
-            ctx->recorder_fd = -1;
-        }
-    }
-
-    return ret;
+            ret = -errno;
+            goto out;
+        }
+    } else {
+        ret = ctx->recorder_fd;
+        goto out;
+    }
+
+    return 0;
 
 out:
-    media_recorder_close(ctx->handle);
-    ctx->handle = NULL;
+    /* Keep a failed cleanup handle reachable; stop/close can retry it. */
+    (void)media_trigger_stop_recorder(ctx);
     return ret;
 }
 
@@ -299,7 +314,7 @@
 {
     MediaTriggerContext* ctx = NULL;
 
-    ctx = malloc(sizeof(MediaTriggerContext));
+    ctx = calloc(1, sizeof(MediaTriggerContext));
     if (!ctx)
         return NULL;
 
@@ -401,6 +416,7 @@
         ctx->context = media_trigger_model_load(data, size, hotword_detection_result_callback, ctx);
         if (!ctx->context) {
             MEDIA_ERR("load model failed\n");
+            ret = -EINVAL;
             goto outside;
         }
 
@@ -427,7 +443,8 @@
 
         ctx->state = SOUND_TRIGGER_STATE_STARTED;
     } else if (!strcmp(cmd, "stop")) {
-        if (ctx->state != SOUND_TRIGGER_STATE_STARTED) {
+        if (ctx->state < SOUND_TRIGGER_STATE_LOADED ||
+            ctx->state >= SOUND_TRIGGER_STATE_UNLOADED) {
             ret = -EINVAL;
             goto outside;
         }
@@ -444,7 +461,7 @@
         }
 
         /* Stop recorder first if still running */
-        if (ctx->state == SOUND_TRIGGER_STATE_STARTED) {
+        if (ctx->handle) {
             ret = media_trigger_stop_recorder(ctx);
             if (ret < 0) {
                 MEDIA_ERR("unload: auto stop recorder failed: %d\n", ret);
@@ -458,10 +475,11 @@
         ctx->state = SOUND_TRIGGER_STATE_UNLOADED;
     } else if (!strcmp(cmd, "close")) {
         /* Stop recorder first if still running */
-        if (ctx->state == SOUND_TRIGGER_STATE_STARTED) {
+        if (ctx->handle) {
             ret = media_trigger_stop_recorder(ctx);
             if (ret < 0) {
                 MEDIA_ERR("close: stop recorder failed: %d\n", ret);
+                goto outside;
             }
         }
 
@@ -577,8 +595,11 @@
         MEDIA_INFO("recorder socket closed\n");
         media_recorder_close_socket(ctx->handle);
         ctx->recorder_fd = -1;
-    } else if (ret < 0 && errno != EAGAIN && errno != EWOULDBLOCK) {
-        MEDIA_ERR("recv from recorder failed: %d\n", errno);
+        media_trigger_notify_event(ctx, 1, -EPIPE, NULL);
+    } else if (ret < 0 && errno != EAGAIN && errno != EWOULDBLOCK && errno != EINTR) {
+        int error = -errno;
+        ctx->recorder_fd = -1;
+        media_trigger_notify_event(ctx, 1, error, NULL);
     }
 
     return 0;
@@ -661,12 +682,15 @@
     }
 
     // Handle recorder fd data (medium priority - audio data)
-    if (recorder_idx >= 0 && (fds[recorder_idx].revents & POLLIN)) {
+    if (recorder_idx >= 0 && ctx->state == SOUND_TRIGGER_STATE_STARTED &&
+        ctx->recorder_fd == fds[recorder_idx].fd &&
+        (fds[recorder_idx].revents & (POLLIN | POLLERR | POLLHUP))) {
         media_trigger_handle_recorder_fd(ctx);
     }
 
     // Handle model poll fd events (low priority - optional)
-    if (model_idx >= 0 && (fds[model_idx].revents & POLLIN)) {
+    if (model_idx >= 0 && ctx->context &&
+        (fds[model_idx].revents & POLLIN)) {
         MEDIA_DEBUG("model poll fd has data available\n");
         ret = media_trigger_model_poll_available(ctx->context);
         if (ret < 0) {
@@ -688,6 +712,21 @@
         if (media_trigger_is_exit(ctx))
             break;
 
+        if (ctx->tran_fd < 0) {
+            ret = media_trigger_stop_recorder(ctx);
+            if (ret < 0) {
+                usleep(20000);
+                continue;
+            }
+            if (ctx->context) {
+                media_trigger_model_unload(ctx->context);
+                ctx->context = NULL;
+            }
+            media_trigger_notify_finalize(ctx);
+            if (ctx->priv)
+                ctx->priv->instance = NULL;
+            break;
+        }
         ret = media_trigger_poll(ctx);
         if (ret < 0 && ret != -EAGAIN) {
             MEDIA_ERR("poll available error: %d\n", ret);
