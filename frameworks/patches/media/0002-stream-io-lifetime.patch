Subject: [PATCH] media: retain stream I/O progress and close prepared listeners

SPDX-License-Identifier: Apache-2.0
Base: open-vela/frameworks_multimedia_media fb7db0e9f826fb6d71937c948e7da1eb10ffc896

--- a/client/media_graph.c
+++ b/client/media_graph.c
@@ -112,12 +112,15 @@
     MediaIOPriv* priv = handle;
     int socket;
 
-    if (atomic_load(&priv->refs) == 1 && priv->socket) {
+    if (atomic_load(&priv->refs) == 1) {
         socket = priv->socket;
         priv->socket = 0;
-        close(socket);
-        if (priv->socket_fd > 0)
-            close(priv->socket_fd);
+        if (socket > 0)
+            close(socket);
+        socket = priv->socket_fd;
+        priv->socket_fd = 0;
+        if (socket > 0)
+            close(socket);
     }
 }
 
@@ -204,6 +207,7 @@
         fd = media_bind_socket(handle);
         if (fd < 0)
             return fd;
+        priv->socket_fd = fd;
 
         cpu = CONFIG_RPMSG_LOCAL_CPUNAME;
         snprintf(addr, sizeof(addr), MEDIA_GRAPH_SOCKADDR_NAME, priv);
@@ -220,7 +224,6 @@
         goto out;
 
     if (fd > 0) {
-        priv->socket_fd = fd;
         priv->socket = accept4(fd, NULL, NULL, SOCK_CLOEXEC);
         if (priv->socket < 0) {
             priv->socket = 0;
@@ -229,6 +232,8 @@
     }
 
 out:
+    if (ret < 0)
+        media_close_socket(priv);
     return ret;
 }
 
@@ -246,33 +251,27 @@
     if (priv->socket <= 0)
         goto out;
 
-    if (player) {
+    if (player)
         ret = send(priv->socket, data, len, 0);
-        if (ret == len)
-            goto out;
-        else if (ret == 0)
-            errno = ECONNRESET;
-        else if (ret < 0 && errno == EINTR) {
-            ret = -errno;
-            goto out;
-        }
-    } else {
+    else
         ret = recv(priv->socket, data, len, 0);
-        if (ret > 0)
-            goto out;
-        else if (ret == 0)
-            errno = ECONNRESET;
-        else if (ret < 0 && errno == EINTR) {
-            ret = -errno;
-            goto out;
-        }
-    }
-
+
+    /* Short stream I/O is progress. Interrupted/nonblocking I/O keeps the
+     * stream available for its caller's existing retry or timeout policy. */
+    if (ret > 0)
+        goto out;
+    if (ret < 0 && (errno == EINTR || errno == EAGAIN || errno == EWOULDBLOCK)) {
+        ret = -errno;
+        goto out;
+    }
+
+    ret = ret == 0 ? -ECONNRESET : -errno;
     close(priv->socket);
     priv->socket = 0;
-    if (priv->socket_fd > 0)
+    if (priv->socket_fd > 0) {
         close(priv->socket_fd);
-    ret = -errno;
+        priv->socket_fd = 0;
+    }
 
 out:
     media_release_cb(priv);
